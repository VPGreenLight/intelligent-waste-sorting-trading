  "item": [
    {
      "name": "1. Authentication & Users",
      "item": [
        {
          "name": "01. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 400\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "    pm.environment.set(\"bearerToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"hoangthang\",\n  \"email\": \"hoangthang@example.com\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Nguyen Hoang Thang\",\n  \"phoneNumber\": \"0987654321\",\n  \"role\": 1\n}"
            },
            "url": {
              "raw": "{{backendUrl}}/api/v1/auth/register",
              "host": ["{{backendUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Đăng ký tài khoản người dùng hoặc cơ sở thu gom mới."
          },
          "response": []
        },
        {
          "name": "02. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Login successful\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.token).to.not.be.empty;",
                  "});",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"bearerToken\", jsonData.token);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.environment.set(\"demoUserId\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"citizen\",\n  \"password\": \"citizen123\"\n}"
            },
            "url": {
              "raw": "{{backendUrl}}/api/v1/auth/login",
              "host": ["{{backendUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Đăng nhập với tài khoản mẫu (citizen/citizen123 hoặc collector/collector123) và tự động lưu Bearer token."
          },
          "response": []
