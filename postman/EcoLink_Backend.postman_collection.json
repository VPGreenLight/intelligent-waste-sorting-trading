              "mode": "raw",
              "raw": "{\n  \"packageCode\": \"VERIFIED_BADGE\",\n  \"amount\": 50000,\n  \"description\": \"Thanh toan goi Tich Xanh EcoLink\",\n  \"userId\": \"{{demoUserId}}\"\n}"
