    {
      "name": "3. Service Payments (VietQR)",
      "item": [
        {
          "name": "01. Create Service Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Payment order created\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property(\"orderCode\");",
                  "    pm.expect(jsonData.data).to.have.property(\"qrCodeUrl\");",
                  "});",
                  "if (jsonData.data && jsonData.data.orderCode) {",
                  "    pm.environment.set(\"orderCode\", jsonData.data.orderCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
