  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service is healthy\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"healthy\");",
                  "    pm.expect(jsonData.service).to.eql(\"EcoLink.AiService\");",
                  "    pm.expect(jsonData.models_available).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Kiểm tra trạng thái hoạt động của dịch vụ AI, thiết bị phần cứng (CPU/CUDA) và danh sách model sẵn sàng."
          },
          "response": []
        }
      ]
    },
