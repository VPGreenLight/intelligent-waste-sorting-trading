    {
      "name": "3. Waste Classification (Inference)",
      "item": [
        {
          "name": "Classify Waste Image (YOLOv8n - Single)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Classification response structure is valid\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.model_used).to.eql(\"yolov8n\");",
                  "    pm.expect(jsonData).to.have.property(\"top_prediction\");",
                  "    pm.expect(jsonData).to.have.property(\"predictions\");",
                  "    pm.expect(jsonData).to.have.property(\"inference_time_ms\");",
