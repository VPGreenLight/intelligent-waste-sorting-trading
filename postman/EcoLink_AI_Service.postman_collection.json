                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Chọn file ảnh rác (jpg, png, webp)"
                },
                {
                  "key": "model",
                  "value": "yolov8n",
                  "type": "text"
                },
