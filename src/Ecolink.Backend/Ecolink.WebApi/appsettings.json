{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http1": {
        "Url": "http://*:5000",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://*:5002",
        "Protocols": "Http2"
      }
    },
    "EndpointDefaults": {
      "Protocols": "Http1"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "{CORE_POSTGRES_CONNECTION_STRING}",
    "DefaultConnection": "{CORE_POSTGRES_CONNECTION_STRING}",
    "Redis": "{REDIS_CONNECTION_STRING}"
  },
  "AiService": {
    "BaseUrl": "{AI_SERVICE_URL}"
  },
  "JwtSettings": {
    "SecretKey": "{JWT_SECRET_KEY}",
    "Issuer": "{JWT_ISSUER}",
    "Audience": "{JWT_AUDIENCE}",
    "ExpiryDays": "{JWT_EXPIRY_DAYS}"
  },
  "VietQr": {
    "BankCode": "{VIETQR_BANK_CODE}",
    "BankName": "{VIETQR_BANK_NAME}",
    "AccountNo": "{VIETQR_ACCOUNT_NO}",
    "AccountName": "{VIETQR_ACCOUNT_NAME}"
  },
  "CloudflareR2": {
    "AccountId": "{R2_ACCOUNT_ID}",
    "AccessKeyId": "{R2_ACCESS_KEY_ID}",
    "SecretAccessKey": "{R2_SECRET_ACCESS_KEY}",
    "BucketName": "{R2_BUCKET_NAME}",
    "PublicUrl": "{R2_PUBLIC_URL}"
  },
  "GoogleAuth": {
    "ClientId": "{GOOGLE_CLIENT_ID}",
    "ClientSecret": "{GOOGLE_CLIENT_SECRET}"
  },
  "Firebase": {
    "ProjectId": "{FIREBASE_PROJECT_ID}",
    "ServerKey": "{FIREBASE_SERVER_KEY}"
  },
  "EmailSettings": {
    "SmtpServer": "{SMTP_SERVER}",
    "Port": "{SMTP_PORT}",
    "SenderEmail": "{SENDER_EMAIL}",
    "SenderPassword": "{SENDER_PASSWORD}"
  },
  "Hangfire": {
    "Username": "{HANGFIRE_USERNAME}",
    "Password": "{HANGFIRE_PASSWORD}"
  }
}