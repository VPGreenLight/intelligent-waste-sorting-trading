   <Column ss:Width="75"/>
   <Column ss:Width="190"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Workflow</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Module 06: Handover Request Scheduling, Privacy Masking &amp; Lifecycle (U-06, U-07, R-03, R-04)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Kiểm thử End-to-End quy trình Tạo yêu cầu bàn giao (/user/handover), kiểm tra 1–5 ảnh rác, khối lượng tối thiểu, giới hạn 3 đơn active (BR-HND-LIMIT), che SĐT &amp; địa chỉ khi chưa Accept (BR-HND-08), sửa/hủy đơn (U-07, BR-HND-06), Recycler tiếp nhận/từ chối/hủy lịch trên /recycler/requests (R-03, R-04) và JOB-03 tự động hết hạn.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 6.1: Tạo Yêu cầu Bàn giao Phế liệu Mới (/user/handover - U-06)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tạo yêu cầu bàn giao mới thành công gửi tới Vựa EcoGreen Hòa Lạc (/user/handover)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập citizen (2 đơn active sẵn có) -&gt; mở /user/handover.&#10;2. Chọn &apos;Vựa phế liệu EcoGreen Hòa Lạc&apos;, chọn Nhựa (5kg) + Kim loại (3kg), tải 2 ảnh phế liệu, chọn khung giờ hẹn (trong 30 ngày) &amp; nhập địa chỉ thu gom.&#10;3. Nhấn &apos;Gửi yêu cầu bàn giao&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Tạo thành công yêu cầu thứ 3 (Status=&apos;Pending&apos;), sinh mã HND-yyyyMMdd-NNNN và lưu ảnh chụp giá (PriceSnapshotPerKg).&#10;- Hiển thị ngay trong danh sách yêu cầu của tôi.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen đang có &lt; 3 đơn active; Vựa EcoGreen đang Online.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">U-06 Happy Path</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn tạo thêm yêu cầu khi Citizen đã đạt ngưỡng tối đa 3 đơn active (BR-HND-LIMIT)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sau STC-HND-001 (citizen đã đủ 3 đơn active), tiếp tục mở form tạo đơn mới và bấm Gửi.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống chặn với thông báo vượt giới hạn tối đa 3 yêu cầu đang xử lý cùng lúc (BR-HND-LIMIT).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen đang có 3 đơn active (Pending/Negotiating/Accepted/AwaitingConfirmation).</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-HND-LIMIT (Boundary = 3)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn đặt khung giờ hẹn ngoài giờ mở cửa, ngày nghỉ tuần của vựa hoặc quá 30 ngày (BR-NEG-04)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Chọn khung giờ hẹn cách hiện tại &lt; 2 giờ, hoặc trễ &gt; 30 ngày, hoặc vào ngày vựa khai báo đóng cửa.&#10;2. Bấm gửi.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Từ chối kèm thông báo khung giờ hẹn không hợp lệ theo lịch tuần của cơ sở (BR-NEG-04).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Vựa đã cấu hình WeeklyScheduleJson.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-NEG-04</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 6.2: Che giấu Thông tin Liên hệ trước khi Duyệt (BR-HND-08) &amp; Sửa/Hủy bởi Người dân (U-07)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Che giấu SĐT và địa chỉ cụ thể của Citizen khi Recycler xem đơn Pending (BR-HND-08)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập tài khoản recycler -&gt; mở /recycler/requests.&#10;2. Mở chi tiết một đơn đang ở trạng thái Pending.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Chỉ hiển thị tên cơ bản, danh mục rác, khung giờ hẹn.&#10;- Ô Số điện thoại và Địa chỉ cụ thể bị ẩn / hiển thị thông báo &apos;Mở khóa sau khi Chấp nhận đơn&apos; (IsContactRevealed=false).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn đang ở trạng thái Pending.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-HND-08 Privacy</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen chỉnh sửa thông tin đơn khi đang ở trạng thái Pending (U-07)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập citizen -&gt; mở chi tiết đơn Pending.&#10;2. Bấm &apos;Chỉnh sửa&apos;, đổi khối lượng dự kiến và địa chỉ thu gom rồi Lưu.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Cập nhật thành công thông tin đơn (Status giữ nguyên Pending).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn thuộc citizen và đang Pending.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">U-07 Update Pending</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn Citizen chỉnh sửa đơn sau khi Recycler đã Chấp nhận (Accepted)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Thử bấm sửa một đơn đang ở trạng thái Accepted (VD: HND-DEMO-0003 của citizen_vip).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Nút sửa bị ẩn/khóa trên UI; nếu gọi trực tiếp API PUT trả về lỗi BR-HND-02.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn đã chuyển sang Accepted.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-HND-02 Lock Edit</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 6.3: Recycler Tiếp nhận, Từ chối &amp; Hủy Lịch hẹn (/recycler/requests - R-03, R-04)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Recycler bấm Chấp nhận đơn (Accepted) -&gt; Chốt lịch hẹn và mở khóa SĐT + Địa chỉ người dân</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập recycler -&gt; mở /recycler/requests.&#10;2. Chọn đơn Pending (HND-DEMO-0001), nhập ghi chú tiếp nhận và nhấn &apos;Chấp nhận đơn&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Trạng thái đơn chuyển Accepted, chốt ConfirmedTimeSlot.&#10;- SĐT và địa chỉ thu gom đầy đủ của Citizen hiển thị ngay cho Recycler (IsContactRevealed=true).&#10;- Gửi thông báo SignalR cho Citizen.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn đang Pending và khung giờ hẹn chưa trôi qua.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">R-03 Accept + Reveal Contact</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn chấp nhận đơn khi khung giờ đề xuất của đơn đã trôi qua trong quá khứ (BR-NEG-04)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Chọn đơn có ProposedTimeSlot &lt; thời điểm hiện tại.&#10;2. Nhấn &apos;Chấp nhận đơn&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống chặn và yêu cầu hai bên thương lượng lại khung giờ mới qua Chatbox hoặc từ chối đơn.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn Pending có ProposedTimeSlot đã quá hạn.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Expired Slot Guard</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 6.4: Cô lập Dữ liệu Đối tác (BR-HND-03) &amp; Tự động Hết hạn Đơn quá 24h (JOB-03)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn Recycler B xem, chấp nhận hoặc từ chối đơn bàn giao gửi cho Recycler A (BR-HND-03)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập tài khoản recycler_pro (B).&#10;2. Thử truy cập chi tiết hoặc gọi Accept lên ID đơn thuộc về EcoGreen (A).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Màn hình /recycler/requests chỉ liệt kê đơn của chính cơ sở đó; gọi trực tiếp trả về 404 NotFound (BR-HND-03).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn thuộc sở hữu của cơ sở khác.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-HND-03 IDOR Protection</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-HND-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">JOB-03 tự động chuyển các đơn Pending quá 24h không phản hồi sang Expired, giữ nguyên đơn Accepted</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Có đơn Pending tạo quá 24h và đơn Accepted tạo quá 24h.&#10;2. Kích hoạt chu kỳ chạy Background Job JOB-03.&#10;3. Kiểm tra danh sách trên /user/handover.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Đơn Pending quá hạn chuyển sang Expired; đơn Accepted vẫn giữ nguyên trạng thái.&#10;- Công dân được giải phóng slot đơn active.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Có đơn Pending &gt; 24h.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">JOB-03 Expiration</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 10: M07_Receipt ==================== -->
 <Worksheet ss:Name="M07_Receipt">
  <Table>
   <Column ss:Width="105"/>
   <Column ss:Width="225"/>
   <Column ss:Width="275"/>
   <Column ss:Width="290"/>
   <Column ss:Width="185"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="75"/>
   <Column ss:Width="190"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Workflow</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Module 07: Digital Handover Receipt, Scale Proof &amp; Transaction History (R-06, U-09, U-12)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Kiểm thử End-to-End lập biên nhận số trên /recycler/receipt (R-06): tải ảnh đồng hồ cân, xem trước độ lệch &gt; 20%, bắt buộc ảnh cân khi &gt;= 10kg (BR-TRN-01), phát hành mã RCP-yyyy-NNNN; Người dân xác nhận trên /user/receipt (U-09) khóa giao dịch bất biến (BR-HND-07), nhận túi phân bón cho Cây ảo hoặc bấm Khiếu nại (Disputed); và tra cứu lịch sử /user/transactions &amp; /recycler/transactions.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 7.1: Cân Đo, Xem Trước Độ lệch &amp; Lập Biên nhận Số (/recycler/receipt - R-06)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xem trước biên nhận (Preview) và hiển thị cảnh báo khi khối lượng thực tế lệch &gt; 20% (BR-TRN-02)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở /recycler/receipt cho đơn đã Accepted (ước tính 5kg).&#10;2. Nhập khối lượng cân thực tế 7.5kg (lệch +50%) và quan sát hộp tổng hợp.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- UI tự động tính tổng tiền thanh toán theo đơn giá chốt và bật cảnh báo lệch khối lượng &gt; 20% (DeviationPercent = 50%, HasDeviationWarning = true).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Có đơn Accepted.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Preview &amp; Deviation Warning</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bắt buộc tải ảnh đồng hồ cân (Scale Proof) khi tổng khối lượng &gt;= 10kg (BR-TRN-01)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Nhập tổng khối lượng thực tế &gt;= 10kg (VD: 12.5kg).&#10;2. Không tải ảnh đồng hồ cân và bấm &apos;Phát hành biên nhận&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống chặn lại kèm thông báo (MSG-RCP-04): Giao dịch từ 10kg trở lên bắt buộc phải đính kèm ảnh chụp đồng hồ cân.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Tổng cân &gt;= 10kg.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-TRN-01 Boundary &gt;= 10kg</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tải ảnh đồng hồ cân lên R2 và phát hành thành công biên nhận số (RCP-yyyy-NNNN)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Tải ảnh đồng hồ cân qua khung upload (POST .../receipt/upload-proof).&#10;2. Nhấn &apos;Phát hành biên nhận&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Tạo bản ghi HandoverReceipt + TransactionReceipt và tin nhắn hệ thống trong Chat.&#10;- Đơn chuyển sang trạng thái AwaitingConfirmation.&#10;- Thời gian đếm ngược tự động xác nhận sau 24h (JOB-01) được kích hoạt.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn đang Accepted và có ảnh cân hợp lệ.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">INC-2026-RCP-08</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">R-06 Issue Digital Receipt | Round 1 Failed (INC-2026-RCP-08): lệch DTO CreateReceiptRequest &amp; 404 endpoint lập biên nhận -&gt; đã đồng bộ Round 2 Passed</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 7.2: Người dân Xác nhận Biên nhận / Khởi tạo Khiếu nại (/user/receipt - U-09)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen mở /user/receipt kiểm tra ảnh đồng hồ cân và bấm &apos;Xác nhận biên nhận&apos; (U-09)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập citizen -&gt; mở /user/receipt cho biên nhận RCP-DEMO-0002 (6.5kg).&#10;2. Đối chiếu khối lượng, tổng tiền mặt và ảnh đồng hồ cân.&#10;3. Nhấn &apos;Xác nhận biên nhận&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Trạng thái đơn chuyển Completed, khóa biên nhận vĩnh viễn không thể sửa/xóa (BR-HND-07).&#10;- Cộng túi phân hữu cơ cho Cây ảo và mở form Đánh giá sao (U-10); PointsAwarded từ cân rác bằng 0 theo thiết kế chống gian lận.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Biên nhận đang ở trạng thái AwaitingConfirmation.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">INC-2026-RCP-08</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">U-09 Confirm &amp; BR-HND-07 | Round 1 Failed (INC-2026-RCP-08): xác nhận biên nhận fallback dữ liệu giả -&gt; đã nối API thật Round 2 Passed</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen bấm Khiếu nại từ màn hình biên nhận khi phát hiện sai lệch cân đo</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở biên nhận ở trạng thái AwaitingConfirmation.&#10;2. Nhấn &apos;Khiếu nại sai lệch&apos;, chọn lý do và đính kèm ảnh đối chứng rồi gửi.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Đơn chuyển ngay sang trạng thái Disputed và tạo phiếu Complaint chuyển tới hàng đợi Staff (/staff/complaints).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Biên nhận đang AwaitingConfirmation.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Receipt Dispute Flow</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn Recycler hoặc Citizen khác xác nhận hộ biên nhận (Chống IDOR)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Dùng token của recycler hoặc citizen_vip thử gọi xác nhận cho biên nhận của citizen.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- API từ chối (403/404), trạng thái biên nhận giữ nguyên.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Biên nhận thuộc về citizen.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Authorization Check</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 7.3: Tự động Hoàn tất Quá hạn 24h (JOB-01) &amp; Tính bất biến Giao dịch (BR-HND-07)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">JOB-01 tự động hoàn tất biên nhận AwaitingConfirmation sau 24h nếu Citizen không khiếu nại</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Có biên nhận ở trạng thái AwaitingConfirmation tạo quá 24h.&#10;2. Kích hoạt JOB-01.&#10;3. Kiểm tra lại trạng thái ở /user/transactions.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Biên nhận chuyển sang Completed; TradeOrder đồng bộ Completed; cấp túi phân cho Cây ảo.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Biên nhận quá 24h không có Disputed.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">JOB-01 Auto-Complete</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xác nhận lại lần 2 hoặc chỉnh sửa biên nhận sau khi Completed đều bị chặn (BR-HND-07)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Thử gọi lại nút xác nhận hoặc gửi request sửa biên nhận cho đơn đã Completed.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Bị chặn hoàn toàn (BR-HND-07), bảo toàn tuyệt đối dữ liệu kế toán/đối soát.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đơn đã Completed.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-HND-07 Immutability</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 7.4: Tra cứu Lịch sử Giao dịch Hai phía (/user/transactions &amp; /recycler/transactions - U-12)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen tra cứu lịch sử giao dịch trên /user/transactions kèm bảng tổng hợp thống kê</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập citizen -&gt; mở /user/transactions.&#10;2. Quan sát thẻ thống kê tổng khối lượng tái chế (kg), số đơn hoàn tất và danh sách biên nhận phân trang.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hiển thị chính xác danh sách các đơn đã Completed và thẻ tổng kết.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen có giao dịch Completed.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">INC-2026-TRD-06</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">U-12 Citizen History | Round 1 Failed (INC-2026-TRD-06): nhầm RecyclerProfile.UserId với Id trong HandoverTradeSyncHelper -&gt; đã vá Round 2 Passed</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCP-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lọc lịch sử giao dịch theo từ khóa tên vựa/mã biên nhận và khoảng thời gian</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Trên /user/transactions, nhập mã &apos;RCP-&apos; hoặc chọn khoảng Từ ngày - Đến ngày rồi lọc.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Kết quả trả về khớp đúng điều kiện lọc và phân trang lại chính xác.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đang ở /user/transactions.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">History Filtering</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

