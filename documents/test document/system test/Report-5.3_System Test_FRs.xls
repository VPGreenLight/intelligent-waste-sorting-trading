   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Workflow</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Module 14: Blog Authoring, Editorial Approval Workflow &amp; Public Portal (G-01, S-08, A-09)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Kiểm thử End-to-End phân hệ Truyền thông Blog trên /blog, /blog/:slug, /staff/blogs và /admin/blog: Staff (MANAGE_BLOG) tải ảnh bìa R2, tạo bài nháp sinh slug tiếng Việt chống trùng, gửi duyệt &amp; thu hồi bài chờ duyệt, Admin duyệt xuất bản (Approved) hoặc từ chối kèm góp ý bắt buộc + AuditLog, và người dân/khách vãng lai đọc bài công khai &amp; lọc đúng nguyên thẻ.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
