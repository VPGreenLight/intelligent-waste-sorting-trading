   <Column ss:Width="190"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Workflow</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Module 02: AI Waste Classification (YOLO26 Two-Stage), Sorting Rule Engine &amp; Waste Catalog (M-02/M-03)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Kiểm thử End-to-End từ giao diện Quét rác AI (/scanner) qua Backend Proxy tới AI Vision Service FastAPI (YOLO26 Two-Stage 10 danh mục), xử lý OOD &lt; 60%, phân tách 5 nhóm thu mua thương mại vs 5 nhóm hướng dẫn an toàn (BR-SRT-04), tra cứu /guidance, và Admin quản trị Danh mục rác + Rule Engine.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 2.1: Quét &amp; Nhận diện Rác bằng AI trên /scanner (U-01, U-02)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quét ảnh chai nhựa PET / lon nhôm trên /scanner với mô hình mặc định YOLO26 Two-Stage</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở trang /scanner.&#10;2. Tải lên ảnh chai nhựa rõ nét.&#10;3. Nhấn nút &apos;Phân loại ngay&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- AI Service trả về nhãn &apos;plastic&apos;, Confidence &gt;= 0.60, IsOutOfDistribution = false.&#10;- UI hiển thị hộp Quy tắc sơ chế 4 bước (StandardBinColor = &apos;Cam&apos;), đồng thời mở nút &apos;Tìm cơ sở thu mua quanh bạn&apos; dẫn sang /map?category=plastic.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">AI Service và WebApi hoạt động bình thường.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">U-01 Happy Path (YOLO26)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quét ảnh nhóm rác không thu mua thương mại (Pin cũ &apos;battery&apos; / Rác hữu cơ &apos;biological&apos;)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở /scanner.&#10;2. Tải lên ảnh pin đã qua sử dụng hoặc vỏ trái cây.&#10;3. Nhấn &apos;Phân loại ngay&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- AI nhận diện đúng nhãn &apos;battery&apos; / &apos;biological&apos; (IsRecyclable = false).&#10;- Hiển thị hộp Cảnh báo an toàn / hướng dẫn thùng rác công cộng, KHÔNG hiển thị nút gửi đơn thu mua tới vựa phế liệu.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Hệ thống đủ 10 danh mục YOLO26.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-SRT-04 Zero Match for Non-Recyclable</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Phát hiện ảnh ngoài phân phối (OOD) hoặc độ tin cậy thấp &lt; 0.60 (BR-AI-01)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở /scanner.&#10;2. Tải lên ảnh bàn phím máy tính hoặc ảnh bị mờ tối.&#10;3. Nhấn &apos;Phân loại ngay&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống gắn cờ IsOutOfDistribution = true.&#10;- UI hiển thị cảnh báo yêu cầu chụp rõ/gần hơn (MSG-CLS-02) và gợi ý công cụ Báo sai AI.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Ngưỡng OOD threshold mặc định = 0.60.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OOD Gate Test</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 2.2: Lịch sử Quét Cá nhân &amp; Điều chỉnh Nhãn Trước Khi Tìm Điểm Thu Gom</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lưu tự động kết quả quét vào Lịch sử quét cá nhân (/scanner)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập tài khoản citizen.&#10;2. Thực hiện 1 lượt quét ảnh thành công trên /scanner.&#10;3. Mở tab/khối Lịch sử quét gần đây và F5 trang.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Bản ghi AiScanHistory (kèm ModelUsed=&apos;yolo26_detect&apos;, ImageUrl, SHA-256, SortingGuide) xuất hiện và lưu bền vững sau F5.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đã đăng nhập citizen.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-CLS-08</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Người dùng tự đổi sang loại rác khác trước khi bấm tìm điểm thu gom</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sau khi AI quét ra &apos;paper&apos;, người dùng chọn lại thẻ &apos;cardboard&apos; trên UI.&#10;2. Nhấn nút tìm điểm thu gom.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Quy tắc sơ chế cập nhật tương ứng sang Bìa Carton.&#10;- Chuyển hướng sang /map mang đúng bộ lọc category=cardboard.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đang ở màn hình kết quả /scanner.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Manual Override</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 2.3: Tra cứu Hướng dẫn Phân loại &amp; Thư viện Loại Rác (/guidance, /waste-lookup)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xem danh sách hướng dẫn 10 nhóm rác trên /guidance và chi tiết từng quy tắc</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở trang /guidance từ thanh điều hướng.&#10;2. Nhấn chọn xem từng nhóm: Nhựa, Giấy, Kim loại, Pin/Rác nguy hại.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hiển thị đủ 4 bước chuẩn bị, hướng dẫn bỏ đúng màu thùng (Cam, Xanh Dương, Xám, Đỏ) và cảnh báo an toàn.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Có ít nhất 10 SortingRules trạng thái ACTIVE.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-SRT-01</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tìm kiếm nhanh từ khóa trên trang Tra cứu loại rác (/waste-lookup)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở /waste-lookup.&#10;2. Gõ từ khóa &apos;pin&apos; hoặc &apos;carton&apos; vào ô tìm kiếm.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Lọc tức thời đúng danh mục khớp từ khóa; hiển thị rõ nhãn &apos;Có thể bán phế liệu&apos; vs &apos;Chỉ xử lý theo hướng dẫn&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Trang /waste-lookup đang hoạt động.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Rule Engine Search</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 2.4: Admin Quản trị Danh mục Rác, Rule Engine Publish &amp; Xóa mềm (A-05, BR-SRT-04)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin tạo danh mục rác mới và kiểm tra chặn trùng mã danh mục (BR-SRT-02)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập Admin -&gt; mở /admin/categories.&#10;2. Tạo danh mục mới &apos;vo_hop_sua&apos; (Hộp giấy Tetrapak).&#10;3. Thử tạo lại một danh mục khác trùng code &apos;vo_hop_sua&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Lần 1: Tạo thành công ở trạng thái Active và tự sinh Rule nháp (DRAFT), ghi AuditLog.&#10;- Lần 2: Trả lỗi ConflictException (MSG-SRT-02).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đã đăng nhập Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-SRT-02</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin cập nhật &amp; Phát hành SortingRule (DRAFT -&gt; ACTIVE) và đồng bộ cache</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở /admin/rules.&#10;2. Chỉnh sửa đầy đủ bước sơ chế cho rule nháp &apos;vo_hop_sua&apos;.&#10;3. Nhấn nút &apos;Phát hành (Publish)&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Rule chuyển sang ACTIVE; bộ nhớ đệm WasteRuleEngineService làm mới ngay lập tức; người dân mở /guidance thấy ngay quy tắc mới.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Có Rule trạng thái DRAFT đủ trường bắt buộc.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-SRT-03</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-SCN-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn phát hành Rule khi thiếu bước sơ chế hoặc danh mục đang Inactive (BR-SRT-03, BR-SRT-04)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Thử bấm Publish khi bỏ trống nội dung chuẩn bị.&#10;2. Thử bấm Publish khi danh mục cha đã tắt Inactive.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống chặn cả 2 trường hợp kèm mã lỗi BR-SRT-03 / BR-SRT-04 rõ ràng.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Có Rule DRAFT vi phạm điều kiện.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Guard Validation</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 6: M03_Onboarding ==================== -->
 <Worksheet ss:Name="M03_Onboarding">
