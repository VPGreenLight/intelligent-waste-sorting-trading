 <!-- ==================== SHEET 2: Test Cases ==================== -->
 <Worksheet ss:Name="Test Cases">
  <Table>
   <Column ss:Width="55"/>
   <Column ss:Width="250"/>
   <Column ss:Width="145"/>
   <Column ss:Width="360"/>
   <Column ss:Width="260"/>
   <Row ss:Index="2" ss:Height="32">
    <Cell ss:MergeAcross="4" ss:StyleID="SectionPlain"><Data ss:Type="String">TEST CASE LIST</Data></Cell>
   </Row>
   <Row ss:Index="4" ss:Height="22">
    <Cell ss:MergeAcross="1" ss:StyleID="BrownLabel"><Data ss:Type="String">Project Name</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Intelligent Waste Sorting and Trading Platform (EcoLink)</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="1" ss:StyleID="BrownLabel"><Data ss:Type="String">Project Code</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">SEP490_G141</Data></Cell>
   </Row>
   <Row ss:Height="190">
    <Cell ss:MergeAcross="1" ss:StyleID="BrownLabel"><Data ss:Type="String">Test Environment Setup Description</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">1. Server &amp; AI Vision Service:&#10;   - Core Backend: ASP.NET Core 10.0 WebApi (Ecolink.WebApi, Clean Architecture, Dual Auth HttpOnly Cookie + Bearer JWT, 2 SignalR Hubs)&#10;   - AI Vision Service: Python 3.11 FastAPI (YOLO26 Two-Stage yolo26_detect mặc định + yolo26s_cls + yolo26n_cls, 10 nhóm rác chuẩn)&#10;2. Database &amp; Object Storage:&#10;   - PostgreSQL 16 + PostGIS 3.4 (ecolink_db, 16 EF Core Migrations, DemoDataSeeder)&#10;   - Cloudflare R2 Object Storage (S3 AWS SigV4) / Local Storage Fallback &amp; IMemoryCache&#10;3. Frontend Web Application:&#10;   - React 19 + TypeScript + Vite 8 + Tailwind CSS v4 + Leaflet 1.9.4 (CARTO Voyager / OSM) + SignalR Client&#10;4. Web Browser:&#10;   - Google Chrome / Microsoft Edge v130+ (Desktop &amp; Responsive Mobile Viewport)</Data></Cell>
   </Row>
   <Row ss:Index="8" ss:Height="26">
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Workflow Name</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Sheet Name</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Description</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Pre-Condition</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 1.1: Đăng ký Tài khoản Công dân (/register - U-01)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M01_Auth&apos;!A1"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử giao diện và luồng lưu tài khoản Citizen mới kèm khởi tạo UserEcoProfile &amp; chặn trùng username/email.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Người dùng chưa đăng nhập; Backend &amp; PostgreSQL đang chạy.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 1.2: Đăng nhập Dual Auth, Quick-Login &amp; Brute-Force Lockout (/login - U-02)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M01_Auth&apos;!A1"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử đăng nhập bằng Username/Email, nút Quick-Login 7 vai trò demo, giữ phiên sau F5 (HttpOnly Cookie) và cơ chế khóa 15 phút.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">CSDL đã seed dữ liệu DemoDataSeeder với 7 tài khoản Quick-Login.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 1.3: Google OAuth 2.0 &amp; Phục hồi Mật khẩu OTP (/forgot-password - U-03)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M01_Auth&apos;!A1"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử nút cấu hình Google OAuth, gửi yêu cầu OTP quên mật khẩu kèm Rate Limit 60s và đặt lại mật khẩu mới.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cấu hình SMTP / GoogleAuth hợp lệ hoặc chế độ dev test.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 1.4: Quản lý Hồ sơ, Đổi mật khẩu &amp; Đăng xuất an toàn (/user/profile)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M01_Auth&apos;!A1"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử cập nhật họ tên/SĐT, đổi mật khẩu, tự động đá phiên khác và xóa sạch cookie khi đăng xuất.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Người dùng đã đăng nhập vào hệ thống.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 2.1: Quét &amp; Nhận diện Rác bằng AI trên /scanner (U-01, U-02)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M02_WasteScan&apos;!A1"><Data ss:Type="String">M02_WasteScan</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tải ảnh vật phẩm tái chế, ảnh OOD, ảnh vật phẩm không thu mua và điều hướng sang bản đồ /map.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">FastAPI AI Service (cổng 8000) đang bật với trọng số YOLO26 và WebApi (cổng 5000) đã kết nối.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 2.2: Lịch sử Quét Cá nhân &amp; Điều chỉnh Nhãn Trước Khi Tìm Điểm Thu Gom</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M02_WasteScan&apos;!A1"><Data ss:Type="String">M02_WasteScan</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử lưu AiScanHistory khi đã đăng nhập, xem lịch sử quét và lọc lịch sử theo loại rác.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản citizen.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 2.3: Tra cứu Hướng dẫn Phân loại &amp; Thư viện Loại Rác (/guidance, /waste-lookup)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M02_WasteScan&apos;!A1"><Data ss:Type="String">M02_WasteScan</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử hiển thị đồng bộ dữ liệu động từ WasteCategory và SortingGuidanceRule.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DB đã seed 10 WasteCategories và 10 SortingRules.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 2.4: Admin Quản trị Danh mục Rác, Rule Engine Publish &amp; Xóa mềm (A-05, BR-SRT-04)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M02_WasteScan&apos;!A1"><Data ss:Type="String">M02_WasteScan</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Admin tạo danh mục mới, soạn thảo &amp; phát hành Rule Engine, và ngừng sử dụng danh mục bảo toàn dữ liệu cũ.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản Admin.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 3.1: Đăng ký Nhóm Cơ sở Thu mua Cố định / Vựa lớn (&apos;Facility&apos; - Bắt buộc GPKD + Đủ 5/5 Ảnh Kho bãi)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M03_Onboarding&apos;!A1"><Data ss:Type="String">M03_Onboarding</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử upload GPKD, cơ chế khóa nút gửi khi thiếu 5/5 ảnh kho bãi, ghim GPS và nộp hồ sơ thành công.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản Citizen chưa nâng cấp Recycler; R2/Local upload hoạt động.</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 3.2: Đăng ký Nhóm Thu mua Nhỏ lẻ / Lưu động (&apos;Individual&apos; - CCCD 2 mặt, Miễn GPKD theo NĐ 39/2007/NĐ-CP)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M03_Onboarding&apos;!A1"><Data ss:Type="String">M03_Onboarding</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử chuyển đổi sang phân nhóm Individual, ẩn trường GPKD, bắt buộc tải CCCD mặt trước + mặt sau và ghim khu vực hoạt động.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập một tài khoản Citizen mới chưa có hồ sơ RecyclerProfile.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">11</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 3.3: Staff Hậu kiểm, Từ chối kèm Lý do &amp; Nộp lại (/staff/applications - S-04, BR-MTH-02)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M03_Onboarding&apos;!A1"><Data ss:Type="String">M03_Onboarding</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Staff xem chi tiết chứng từ tương ứng từng phân nhóm, từ chối và cho phép Citizen cập nhật nộp lại.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản Staff có quyền VERIFY_RECYCLER; có hồ sơ Pending trong DB.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">12</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 3.4: Staff Phê duyệt -&gt; Nâng cấp Role, Đồng bộ Phiên &amp; Seed Bảng giá Mặc định</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M03_Onboarding&apos;!A1"><Data ss:Type="String">M03_Onboarding</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tích hợp sau khi Staff phê duyệt: Role đổi thành Recycler, có thể vào cổng /recycler, /recycler/catalog và /map.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có hồ sơ Pending hợp lệ (ví dụ applicant_hoalacxanh).</Data></Cell>
   </Row>
   <Row ss:Height="36">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">13</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 4.1: Quản lý Hồ sơ Cơ sở &amp; Ghim Vị trí GPS (/recycler/profile)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M04_Recycler&apos;!A1"><Data ss:Type="String">M04_Recycler</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử xem và cập nhật hồ sơ cơ sở thu mua, chặn tọa độ (0,0) không hợp lệ.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản Recycler đã Verified (recycler).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">14</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 4.2: Quản trị Bảng giá Phế liệu &amp; Lưu Hàng loạt (/recycler/catalog - R-01)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M04_Recycler&apos;!A1"><Data ss:Type="String">M04_Recycler</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử thêm/sửa/tạm ngưng loại phế liệu, chặn nhóm rác không tái chế và lưu đồng loạt bảng giá.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản recycler đã Verified.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">15</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 4.3: Điều khiển Trạng thái Online/Offline &amp; Lịch Hoạt động Tuần (/recycler - R-02)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M04_Recycler&apos;!A1"><Data ss:Type="String">M04_Recycler</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử công tắc Online/Offline tức thời, lý do tạm nghỉ (BusyReason) và cấu hình lịch 7 ngày.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản recycler đã Verified.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">16</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 5.1: Định vị GPS, Click-to-Pin Chính xác &amp; Tìm Địa danh trên /map</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M05_Discovery&apos;!A1"><Data ss:Type="String">M05_Discovery</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử định vị không tự động bật GPS khi tải trang, chọn tâm bản đồ chính xác và gọi Proxy Geocoding qua Enter.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bản đồ CARTO Voyager / OSM và Backend Proxy /api/v1/geocoding/search đang hoạt động.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">17</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 5.2: Bộ lọc Rác, Sắp xếp Khoảng cách/Giá, Huy hiệu PRO &amp; Nhãn Lưu động</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M05_Discovery&apos;!A1"><Data ss:Type="String">M05_Discovery</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử lọc kết quả /map &amp; /partners theo vật liệu, hiển thị đúng sao đánh giá và ưu tiên PRO.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã seed đầy đủ đánh giá Hòa Lạc &amp; Hà Nội và 1 đối tác Individual.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">18</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 5.3: Phương án Dự phòng 3 Tầng (0 Kết quả - MSG-MTH-01) &amp; Bảo mật Vị trí (BR-MTH-05)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M05_Discovery&apos;!A1"><Data ss:Type="String">M05_Discovery</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử giao diện Fallback khi bán kính quá hẹp không có điểm thu mua và xác nhận không lộ tọa độ công dân.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Người dân thao tác trên /map.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">19</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 6.1: Tạo Yêu cầu Bàn giao Phế liệu Mới (/user/handover - U-06)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M06_Handover&apos;!A1"><Data ss:Type="String">M06_Handover</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tạo đơn bàn giao, đính kèm ảnh R2, đối chiếu bảng giá và giới hạn 3 đơn đang xử lý.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản citizen (đang có 2 đơn active HND-DEMO-0001 &amp; HND-DEMO-0002).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">20</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 6.2: Che giấu Thông tin Liên hệ trước khi Duyệt (BR-HND-08) &amp; Sửa/Hủy bởi Người dân (U-07)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M06_Handover&apos;!A1"><Data ss:Type="String">M06_Handover</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử ẩn SĐT/địa chỉ trước khi Accept và chức năng sửa/hủy đơn phía Citizen.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có đơn ở trạng thái Pending và Accepted.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">21</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 6.3: Recycler Tiếp nhận, Từ chối &amp; Hủy Lịch hẹn (/recycler/requests - R-03, R-04)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M06_Handover&apos;!A1"><Data ss:Type="String">M06_Handover</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Recycler duyệt đơn (mở khóa SĐT), từ chối kèm lý do và hủy lịch hẹn.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản recycler đang có đơn Pending gửi đến.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">22</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 6.4: Cô lập Dữ liệu Đối tác (BR-HND-03) &amp; Tự động Hết hạn Đơn quá 24h (JOB-03)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M06_Handover&apos;!A1"><Data ss:Type="String">M06_Handover</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử chống IDOR giữa các Recycler và tác vụ ngầm chuyển đơn Pending quá hạn sang Expired.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có nhiều tài khoản Recycler và đơn Pending tồn đọng.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">23</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 7.1: Cân Đo, Xem Trước Độ lệch &amp; Lập Biên nhận Số (/recycler/receipt - R-06)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M07_Receipt&apos;!A1"><Data ss:Type="String">M07_Receipt</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Recycler cân thực tế, tải ảnh bằng chứng đồng hồ cân và phát hành biên nhận.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập recycler đang có đơn ở trạng thái Accepted.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">24</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 7.2: Người dân Xác nhận Biên nhận / Khởi tạo Khiếu nại (/user/receipt - U-09)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M07_Receipt&apos;!A1"><Data ss:Type="String">M07_Receipt</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử xác nhận biên nhận (khóa giao dịch, tặng túi phân Cây ảo, không cộng GreenPoints từ khối lượng rác) hoặc mở tranh chấp.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập citizen đang có đơn AwaitingConfirmation (VD: RCP-DEMO-0002).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">25</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 7.3: Tự động Hoàn tất Quá hạn 24h (JOB-01) &amp; Tính bất biến Giao dịch (BR-HND-07)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M07_Receipt&apos;!A1"><Data ss:Type="String">M07_Receipt</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Job JOB-01 tự động xác nhận biên nhận quá hạn 24h và đảm bảo biên nhận Completed bất biến.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có biên nhận quá hạn 24h và biên nhận đã Completed.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">26</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 7.4: Tra cứu Lịch sử Giao dịch Hai phía (/user/transactions &amp; /recycler/transactions - U-12)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M07_Receipt&apos;!A1"><Data ss:Type="String">M07_Receipt</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử bộ lọc theo ngày, từ khóa, thống kê tổng khối lượng và chi tiết biên nhận lưu trữ.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DB đã seed 159 HandoverReceipts lịch sử hoàn tất.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">27</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 8.1: Kết nối Real-Time SignalR, Khởi tạo Hội thoại Hỏi thăm &amp; Tin nhắn Chữ/Ảnh (/chat)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M08_Negotiation&apos;!A1"><Data ss:Type="String">M08_Negotiation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử nhắn tin hai chiều tức thời giữa trình duyệt Citizen và trình duyệt Recycler.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mở 2 trình duyệt: Tab A đăng nhập citizen, Tab B đăng nhập recycler.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">28</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 8.2: Gửi Đề xuất Giá/Khung giờ, Phản đề xuất &amp; Khóa Điều khoản (BR-NEG-02, BR-NEG-03)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M08_Negotiation&apos;!A1"><Data ss:Type="String">M08_Negotiation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tính năng Proposal trong chat, tự động Supersede đề xuất cũ và khóa điều khoản khi Accepted.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đơn đang ở trạng thái Pending hoặc Negotiating.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">29</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 8.3: Kiểm soát Quyền Truy cập Phòng Chat (BR-NEG-01) &amp; Hồ sơ Bất biến Khiếu nại</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M08_Negotiation&apos;!A1"><Data ss:Type="String">M08_Negotiation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử chặn người ngoài truy cập phòng chat, không cho xóa tin nhắn và Staff xem log khi có tranh chấp.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có đơn bàn giao đang chat giữa citizen &amp; recycler, và tài khoản citizen_vip (ngoài đơn).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">30</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 9.1: Dashboard KPI Điều hành, Xuất Báo cáo Ẩn danh PII &amp; Audit Trail (/admin, /admin/reports)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M09_Governance&apos;!A1"><Data ss:Type="String">M09_Governance</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử hiển thị biểu đồ tăng trưởng Admin, xuất tệp CSV/XLSX che thông tin cá nhân và kiểm tra nhật ký kiểm toán.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản Admin (admin / admin123).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">31</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 9.2: Quản lý Tài khoản, Khóa Chặn Tức thời &amp; Vô hiệu hóa Mềm (/admin/accounts - S-06, S-07)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M09_Governance&apos;!A1"><Data ss:Type="String">M09_Governance</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử khóa tạm thời tài khoản đá văng phiên làm việc tức thời và vô hiệu hóa mềm bảo toàn biên nhận.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản Admin (hoặc Staff có quyền MANAGE_ACCOUNTS).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">32</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 9.3: Cấp phát Staff Mặc định 0 Quyền &amp; Phân 7 Quyền RBAC Tức thời (/admin/permissions - A-03, A-04)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M09_Governance&apos;!A1"><Data ss:Type="String">M09_Governance</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tạo tài khoản Staff mới có 0 quyền, cấp/thu hồi quyền RBAC và kiểm chứng hiệu lực tức thời không cần đăng nhập lại.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mở 2 trình duyệt: Admin (Tab B) và staff_support NV-002 (Tab A).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">33</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 9.4: Chấm công Ca trực (/staff/checkin), Thông báo Realtime &amp; Chính sách Nền tảng (/admin/policies)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M09_Governance&apos;!A1"><Data ss:Type="String">M09_Governance</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử chấm công 1 lần/ngày của Staff, bell thông báo realtime SignalR và quản trị điều khoản nền tảng.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tài khoản staff (NV-001 có 5 ngày công lịch sử, chưa chấm công hôm nay) và admin.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">34</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 10.1: Gói Dịch vụ Citizen (PREMIUM Tắt Quảng cáo - U-16) &amp; Điều kiện Mở khóa PRO (BR-PAY-04)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M10_ServicePackages&apos;!A1"><Data ss:Type="String">M10_ServicePackages</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử kiểm tra 4 tiêu chí PRO cho đối tác Recycler và mua gói PREMIUM cho Citizen.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có tài khoản citizen, recycler (5★/5 đánh giá) và recycler_pro (4.81★/52 đánh giá chưa mua PRO).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">35</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 10.2: Vòng đời Đơn hàng VietQR, Cộng dồn Thời hạn &amp; Bảo mật Webhook</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M10_ServicePackages&apos;!A1"><Data ss:Type="String">M10_ServicePackages</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử hủy đơn chờ thanh toán, gia hạn cộng dồn ngày, chống giả mạo Webhook và Idempotency.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Người dùng có quyền tạo đơn VietQR.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">36</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 10.3: Admin Cấu hình Bảng giá Gói &amp; Bảo toàn Snapshot Đơn cũ (Grandfathering - A-10)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M10_ServicePackages&apos;!A1"><Data ss:Type="String">M10_ServicePackages</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Admin cập nhật giá/quyền lợi gói thương mại, bảo vệ gói BASIC miễn phí và giữ giá cũ cho đơn đã tạo.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập tài khoản Admin.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">37</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 10.4: Admin Đối soát Sai lệch Thanh toán VietQR &amp; Xuất Sổ cái (/admin/reconciliation - A-11)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M10_ServicePackages&apos;!A1"><Data ss:Type="String">M10_ServicePackages</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử xử lý đơn thiếu tiền ORD-SEED-PRO-ANOM, khớp thủ công webhook mồ côi và xuất báo cáo đối soát.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã đăng nhập Admin; có sẵn dữ liệu bất thường từ DemoDataSeeder (ORD-SEED-PRO-ANOM &amp; ECOLINK_UNKNOWN_999).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">38</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 11.1: Báo sai Kết quả AI &amp; Tự động Thu thập Ca Độ tin cậy Thấp (/scanner - U-04)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M11_AiCuration&apos;!A1"><Data ss:Type="String">M11_AiCuration</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử người dân báo cáo nhận diện sai nhãn và tự động tạo mẫu LowConfidenceAuto khi AI nhận diện &lt; 60%.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản citizen; đã thực hiện quét ảnh trên /scanner.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">39</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 11.2: Staff Duyệt Phản hồi AI &amp; Gán nhãn Bounding Box YOLO (/staff/ai-review - S-01, S-02)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M11_AiCuration&apos;!A1"><Data ss:Type="String">M11_AiCuration</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử kiểm soát RBAC [REVIEW_AI], duyệt/bác bỏ phản hồi, vẽ tọa độ BBox YOLO [0,1] và gán nhãn hàng loạt.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản staff (đủ quyền REVIEW_AI &amp; CURATE_DATASET); có 2 feedback Pending &amp; 3 ảnh Unlabeled.</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">40</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 11.3: Đóng gói Dataset Sticky Stratified Split 70/20/10, Xuất ZIP &amp; Đồng bộ AI (/staff/dataset - S-03)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M11_AiCuration&apos;!A1"><Data ss:Type="String">M11_AiCuration</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử đóng gói phiên bản Dataset v2.0.0 chống rò rỉ dữ liệu Train/Test (BR-CLS-07), tải file .zip chuẩn YOLO và Sync FastAPI.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có đủ mẫu VerifiedLabeled trên kho dữ liệu S-03.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">41</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 12.1: Đánh giá Sao Cơ sở Thu mua &amp; Tính Điểm Trung bình (/user/receipt, /map - U-10)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M12_ReviewsComplaints&apos;!A1"><Data ss:Type="String">M12_ReviewsComplaints</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Citizen chấm 1–5 sao đơn Completed trong 14 ngày, cập nhật điểm sao bản đồ và chặn sửa/đánh giá lặp.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen vừa hoàn tất biên nhận (STC-RCP-005) chưa đánh giá.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">42</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 12.2: Gửi Khiếu nại Hai chiều Kèm Chứng cứ R2 (/user/complaints - U-11)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M12_ReviewsComplaints&apos;!A1"><Data ss:Type="String">M12_ReviewsComplaints</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử cả Citizen và Recycler tạo khiếu nại trên giao dịch, tải ảnh bằng chứng và chặn tạo trùng phiếu.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đã có giao dịch giữa citizen &amp; recycler và ảnh chụp chứng cứ.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">43</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 12.3: Staff Trọng tài 360°, Thu hồi Điểm &amp; Cảnh cáo Đối tác (/staff/complaints - S-05)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M12_ReviewsComplaints&apos;!A1"><Data ss:Type="String">M12_ReviewsComplaints</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Staff mở Hồ sơ Trọng tài 360° (CMP-DEMO-0001), đối chiếu chat/ảnh cân, ra phán quyết thu hồi điểm và cảnh cáo.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản staff (có quyền HANDLE_COMPLAINT); có khiếu nại CMP-DEMO-0001 đang Open.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">44</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 13.1: Trang &apos;Eco Fact&apos; (/user/gamification) Đồng bộ với /ecofacts &amp; Cây ảo</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M13_Gamification&apos;!A1"><Data ss:Type="String">M13_Gamification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử thiết kế mới đã tinh gọn trên Sidebar &apos;Eco Fact&apos; (/user/gamification) và đồng bộ hiển thị với /ecofacts.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản citizen (Cây ảo Lv 2 Sprout, 250 điểm tiêu dùng).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">45</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 13.2: Chăm sóc Cây ảo (Vùng ẩm vàng 60–90%), Nâng cấp &amp; Thu hoạch Nhiều vụ (/ecofacts - U-15)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M13_Gamification&apos;!A1"><Data ss:Type="String">M13_Gamification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử vòng đời chăm sóc cây (tưới nước, bón phân, nâng cấp mở khóa Eco Fact) và thu hoạch quả nhận Điểm Xanh.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tài khoản citizen có Cây ảo Lv 2 (60% ẩm, 3 túi phân dự trữ) và citizen_vip (Lv 4 HarvestReady).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">46</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 13.3: Điểm danh Chuỗi Streak &amp; Đổi Quà Trừ Kho Nguyên tử (/rewards - U-13, U-14)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M13_Gamification&apos;!A1"><Data ss:Type="String">M13_Gamification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử điểm danh hàng ngày trên /rewards, đổi E-Voucher/quà vật lý và bảo vệ ví/tồn kho không âm.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản citizen (Streak 3 ngày, chưa điểm danh hôm nay; 250 Điểm tiêu dùng).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">47</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 13.4: Bảng xếp hạng (/leaderboard), Quản trị Kho Quà Staff &amp; Cấu hình Admin (S-10, A-07, A-08)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M13_Gamification&apos;!A1"><Data ss:Type="String">M13_Gamification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử công khai BXH tháng, Staff nhập kho/trao quà vật lý và Admin cấu hình + chốt thưởng Top 3.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có citizen_vip đứng Top #1 BXH, tài khoản staff (MANAGE_INVENTORY) và admin.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">48</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 14.1: Staff Soạn thảo, Tải Ảnh Bìa R2, Gửi Duyệt &amp; Thu hồi (/staff/blogs - S-08)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M14_BlogContent&apos;!A1"><Data ss:Type="String">M14_BlogContent</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tạo bài viết tiếng Việt tự động sinh slug, upload ảnh R2, nộp duyệt và thu hồi bài chờ.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản staff có quyền MANAGE_BLOG.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">49</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 14.2: Admin Hàng đợi Kiểm duyệt Xuất bản / Từ chối (/admin/blog - A-09)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M14_BlogContent&apos;!A1"><Data ss:Type="String">M14_BlogContent</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Admin duyệt bài xuất bản công khai hoặc trả về bản nháp kèm góp ý chỉnh sửa bắt buộc.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Đăng nhập tài khoản admin; có bài Pending_Approval.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">50</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 14.3: Cổng Đọc Blog Công khai (/blog, /blog/:slug - G-01)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M14_BlogContent&apos;!A1"><Data ss:Type="String">M14_BlogContent</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử hiển thị 4 bài viết seed công khai, đọc chi tiết qua Slug, chặn bài nháp và lọc nguyên thẻ tag.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DemoDataSeeder đã seed 6 BlogPosts (4 Approved, 1 Pending_Approval, 1 Draft).</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">51</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 15.1: Chuỗi Giá trị Thu gom Tuần hoàn Khép kín (Quét AI -&gt; Bản đồ -&gt; Chat -&gt; Biên nhận -&gt; Cây ảo)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M15_E2E_Security&apos;!A1"><Data ss:Type="String">M15_E2E_Security</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chạy thông suốt 1 vòng đời giao dịch thực tế từ ảnh rác tới thu hoạch Cây ảo &amp; đánh giá 5 sao.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tất cả dịch vụ (Vite 5173, WebApi 5000, FastAPI 8000, PostgreSQL 5432) đang hoạt động.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">52</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 15.2: Chuỗi Hành trình Đối tác Thu mua (KYB 2 Phân nhóm -&gt; Mở khóa Gói PRO -&gt; Ghi nhận KPI)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M15_E2E_Security&apos;!A1"><Data ss:Type="String">M15_E2E_Security</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm chứng luồng đăng ký từ Công dân thành Đối tác (cả Individual lẫn Facility), nâng cấp PRO và lên Dashboard Admin.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Có tài khoản ứng viên mới, staff (VERIFY_RECYCLER) và admin.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">53</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scenario 15.3: Kiểm chứng Toàn diện Bảo mật, Phân quyền RBAC, Phiên &amp; Dữ liệu Nhạy cảm</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;M15_E2E_Security&apos;!A1"><Data ss:Type="String">M15_E2E_Security</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tổng kiểm tra an toàn bảo mật cấp hệ thống across tất cả 4 vai trò và các điểm cuối nhạy cảm.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Hệ thống chạy với dữ liệu thực tế.</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

