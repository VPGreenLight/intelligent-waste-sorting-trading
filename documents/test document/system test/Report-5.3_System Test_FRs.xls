   <Column ss:Width="190"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Workflow</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Module 04: Recycler Profile, Pricing Sheet &amp; Availability Schedule Management (R-01, R-02)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Kiểm thử End-to-End cổng quản lý đối tác Recycler (/recycler/profile, /recycler/catalog): cập nhật thông tin &amp; tọa độ GPS thực tế, quản trị đơn giá / lưu hàng loạt bảng giá, chặn tắt dòng giá cuối cùng khi đang Online (BR-MTH-03), bật/tắt trạng thái Online/Offline và thiết lập lịch mở cửa 7 ngày.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="OliveHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 4.1: Quản lý Hồ sơ Cơ sở &amp; Ghim Vị trí GPS (/recycler/profile)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Xem đầy đủ thông tin hồ sơ, loại hình và số loại phế liệu đang mua tại /recycler/profile</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Đăng nhập recycler.&#10;2. Mở menu &apos;Hồ sơ cơ sở&apos; (/recycler/profile).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hiển thị đúng tên cơ sở (&apos;Vựa phế liệu EcoGreen Hòa Lạc&apos;), loại hình Facility, địa chỉ, tọa độ GPS trên bản đồ, khung giờ và ảnh kho bãi.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Tài khoản recycler đang Active và Verified.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GET /api/v1/recycler/profile</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cập nhật địa chỉ, mô tả, giờ mở cửa và ghim vị trí mới trên bản đồ /recycler/profile</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Nhấn vào bản đồ chọn tọa độ mới quanh Hòa Lạc, sửa mô tả năng lực thu mua.&#10;2. Nhấn &apos;Lưu thay đổi&apos; và kiểm tra lại trên /map.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Cập nhật thành công (200 OK), PostGIS Point (SRID 4326) cập nhật theo vị trí mới.&#10;- Ghim trên /map di chuyển đúng tọa độ mới.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đang ở /recycler/profile.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Update Profile + PostGIS Sync</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn cập nhật hồ sơ với tọa độ gốc (0, 0) hoặc SĐT rỗng</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Xóa số điện thoại hoặc nhập tọa độ (0, 0) rồi bấm Lưu.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống chặn với thông báo lỗi (MSG-MTH-06 / FluentValidation), không ghi đè dữ liệu hỏng vào DB.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đang ở /recycler/profile.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-MTH-03</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Hồ sơ đang bị Rejected khi tự cập nhật lại chuyển về Pending chờ Staff duyệt (BR-MTH-02)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Dùng tài khoản có hồ sơ Rejected gọi cập nhật hồ sơ.&#10;2. Kiểm tra trạng thái hồ sơ.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- VerificationStatus tự động đặt về Pending, xóa RejectionReason cũ để quay lại hàng đợi Staff.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Hồ sơ ở trạng thái Rejected.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-MTH-02</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 4.2: Quản trị Bảng giá Phế liệu &amp; Lưu Hàng loạt (/recycler/catalog - R-01)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Thêm mới một loại phế liệu thương mại vào bảng giá thu mua (/recycler/catalog)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở /recycler/catalog.&#10;2. Chọn loại rác chưa có (VD: &apos;Thủy tinh&apos;), nhập đơn giá &apos;2500&apos; đ/kg, tối thiểu &apos;3&apos; kg và điều kiện thu gom.&#10;3. Nhấn &apos;Thêm vào bảng giá&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Tạo dòng giá thành công (IsActive=true, IsOutdated=false).&#10;- Bảng giá trên /map cập nhật hiển thị thêm mục Thủy tinh.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Cơ sở chưa có dòng giá Thủy tinh.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/v1/recycler/prices</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn thêm đơn giá số âm, số thập phân hoặc trùng lặp loại phế liệu</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Thử nhập đơn giá 0đ hoặc 2500.5đ.&#10;2. Thử thêm trùng danh mục &apos;Nhựa&apos; đã có.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống từ chối với lỗi đơn giá phải là số nguyên dương VND/kg và cảnh báo danh mục đã tồn tại trong bảng giá.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đang ở /recycler/catalog.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Pricing Validation</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn tắt dòng giá Active cuối cùng khi cơ sở đang Online trên bản đồ (BR-MTH-03)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Tắt lần lượt các dòng giá cho tới khi chỉ còn 1 dòng Active duy nhất.&#10;2. Thử tắt nốt dòng giá cuối cùng khi trạng thái cơ sở vẫn đang &apos;Online&apos;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Hệ thống chặn và thông báo lỗi (MSG-MTH-06): cơ sở đang mở cửa phải có tối thiểu 1 loại phế liệu nhận mua.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Cơ sở đang Online và còn 1 dòng giá Active.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">EF-03 / BR-MTH-03</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="ScenarioRow"><Data ss:Type="String">Scenario 4.3: Điều khiển Trạng thái Online/Offline &amp; Lịch Hoạt động Tuần (/recycler - R-02)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bật/tắt công tắc &apos;Sẵn sàng nhận đơn (Offline/Online)&apos; kèm lý do tạm nghỉ (BusyReason)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Bấm chuyển trạng thái sang &apos;Tạm ngưng / Offline&apos;, nhập lý do &apos;Xe đi gom hàng ngoại thành&apos; (&lt; 100 ký tự) và Lưu.&#10;2. Kiểm tra lại cơ sở trên bản đồ /map.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Cơ sở ẩn ngay lập tức khỏi kết quả tìm kiếm mới trên /map (BR-MTH-06).&#10;- Toàn bộ đơn bàn giao đang xử lý (Pending/Accepted) vẫn giữ nguyên.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Cơ sở đang Online.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-MTH-06</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Chặn cơ sở bật Online khi bảng giá chưa có mặt hàng nào Active (BR-MTH-03)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Chuẩn bị tài khoản cơ sở vừa duyệt nhưng tắt hết bảng giá (ActivePriceCount = 0).&#10;2. Thử bật công tắc sang Online.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Chặn bật Online và hiển thị thông báo yêu cầu thiết lập ít nhất 1 mặt hàng thu mua &amp; vị trí hợp lệ (MSG-MTH-06).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Cơ sở Verified nhưng ActivePriceCount = 0.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BR-MTH-03</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">STC-RCY-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Thiết lập lịch mở cửa 7 ngày trong tuần và tự động tổng hợp chuỗi OperatingHours</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Mở mục cấu hình Lịch hoạt động tuần.&#10;2. Đặt Thứ 2–Thứ 6: 08:00–17:30; Thứ 7: 08:00–12:00; Chủ Nhật: Đóng cửa.&#10;3. Nhấn Lưu.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Chuỗi OperatingHours tự động gộp thành &apos;T2-T6: 08:00 - 17:30; T7: 08:00 - 12:00&apos;.&#10;- Dữ liệu đồng bộ lên thẻ cơ sở trên /map.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Đã đăng nhập recycler.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Weekly Schedule Summary</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 8: M05_Discovery ==================== -->
 <Worksheet ss:Name="M05_Discovery">
  <Table>
   <Column ss:Width="105"/>
