   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Workflow</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Module 12: Recycler Star Rating, Abuse Moderation &amp; 360° Complaint Arbitration (U-10, U-11, S-05)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Kiểm thử End-to-End luồng Đánh giá sao &amp; Kiểm duyệt bình luận trên /user/receipt và /map (U-10, BR-RVW-01..03), luồng gửi Khiếu nại hai chiều kèm ảnh chứng cứ R2 trên /user/complaints (U-11), và quy trình Staff (HANDLE_COMPLAINT) thẩm định qua Hồ sơ Trọng tài 360°, thu hồi điểm thưởng (UserPointWallet &gt;= 0) và cảnh cáo đối tác trên /staff/complaints (S-05).</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
