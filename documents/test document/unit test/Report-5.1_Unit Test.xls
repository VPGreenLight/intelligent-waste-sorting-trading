 <!-- ==================== SHEET 2: Test Cases ==================== -->
 <Worksheet ss:Name="Test Cases">
  <Table>
   <Column ss:Width="55"/>
   <Column ss:Width="260"/>
   <Column ss:Width="165"/>
   <Column ss:Width="360"/>
   <Column ss:Width="260"/>
   <Row ss:Index="2" ss:Height="32">
    <Cell ss:MergeAcross="4" ss:StyleID="SectionPlain"><Data ss:Type="String">TEST CASE LIST</Data></Cell>
   </Row>
   <Row ss:Index="4" ss:Height="22">
    <Cell ss:MergeAcross="1" ss:StyleID="BrownLabel"><Data ss:Type="String">Project Name</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Intelligent Waste Sorting and Trading Platform (EcoLink)</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="1" ss:StyleID="BrownLabel"><Data ss:Type="String">Project Code</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">SEP490_G141</Data></Cell>
   </Row>
   <Row ss:Height="190">
    <Cell ss:MergeAcross="1" ss:StyleID="BrownLabel"><Data ss:Type="String">Test Environment Setup Description</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">1. Unit Test Runner &amp; Mocking Framework:&#10;   - .NET 10.0 SDK + xUnit 2.9.3 + Moq + FluentAssertions (Ecolink.UnitTests)&#10;   - EF Core 10.0 InMemory / SQLite In-Memory Provider cho các bài test Service Layer&#10;   - Lưu ý Build Environment (INC-2026-TST-11): Tắt tiến trình Ecolink.WebApi.exe đang chạy hoặc truyền -p:BuildProjectReferences=false / chạy riêng biệt để tránh lỗi MSBuild MSB3027 khóa tệp DLL khi chạy Test Explorer.&#10;2. AI Vision Unit Test Environment:&#10;   - Python 3.11 + pytest / FastAPI TestClient cho Ecolink.AiService (YOLO26 Two-Stage yolo26_detect &amp; 10 categories)&#10;3. Scope &amp; Round Progression:&#10;   - 14 Core Service Modules (228 Representative TCs: 107 Normal, 76 Abnormal, 45 Boundary)&#10;   - Round 1: 220 Passed / 8 Failed (INC-2026-HND-04, INC-2026-TST-12, INC-2026-TST-13, INC-2026-VAL-14) -&gt; Fix -&gt; Round 2: 228/228 Passed (100.00%).</Data></Cell>
   </Row>
   <Row ss:Index="8" ss:Height="26">
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Function Name</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Sheet Name</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Description</Data></Cell>
    <Cell ss:StyleID="NavyHeader"><Data ss:Type="String">Pre-Condition</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RegisterUserAsync (AuthService)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử đăng ký tài khoản Citizen, khởi tạo UserEcoProfile mặc định và chặn trùng Email/Username (BR-AUTH-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">EF Core InMemory DB sạch; PasswordHasher và JwtTokenGenerator sẵn sàng.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RegisterRecyclerAsync (AuthService)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử đăng ký trực tiếp đối tác Recycler kèm tọa độ PostGIS SRID 4326 và chặn trùng Email (BR-AUTH-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tài khoản recycler chưa tồn tại trong bảng users.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">LoginAsync (AuthService)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử đăng nhập Username/Email, chuẩn hóa chuỗi, chống User Enumeration (BR-AUTH-03) và khóa 15 phút sau 5 lần sai (BR-AUTH-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Tài khoản mẫu đang Active hoặc đã tăng FailedLoginAttempts.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AuthenticateGoogleAsync (AuthService)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử đăng nhập/liên kết Google OAuth 2.0 (BR-AUTH-02) và xử lý ngoại lệ InvalidJwtException (BR-AUTH-07).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mock GoogleJsonWebSignature.Payload hợp lệ hoặc token giả mạo.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RefreshTokenAsync (AuthService)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử Token Rotation, phát hiện Token Replay Attack thu hồi toàn bộ chuỗi RefreshToken (BR-AUTH-05) và kiểm tra hết hạn.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bảng refresh_tokens chứa token còn hạn, đã thu hồi hoặc hết hạn.</Data></Cell>
   </Row>
   <Row ss:Height="36">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ForgotPasswordAsync &amp; ResetPasswordAsync</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử gửi OTP quên mật khẩu kèm Rate Limit 60s (BR-AUTH-09) và đặt lại mật khẩu mới (BR-AUTH-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mock EmailService; PasswordResetToken còn hạn 15 phút.</Data></Cell>
   </Row>
   <Row ss:Height="36">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Permissions &amp; Demo Seeding (AuthService)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;1_Authentication&apos;!A1"><Data ss:Type="String">1_Authentication</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử nạp động 7 quyền RBAC theo StaffProfile.Status và kiểm tra seed tọa độ demo Hòa Lạc.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">StaffProfile đang Active/Suspended và EnsureDemoUsersAsync.</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ClassifyWasteImageAsync (AiVisionHttpClient)</Data></Cell>
    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;2_AI_Classification&apos;!A1"><Data ss:Type="String">2_AI_Classification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử gọi HTTP POST tới FastAPI AI Vision với yolo26_detect/yolo26n_cls và fallback an toàn khi lỗi HTTP/mất kết nối.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mock HttpMessageHandler cho client Ecolink.WebApi.</Data></Cell>
