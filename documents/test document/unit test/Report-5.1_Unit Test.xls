tyleID="s53"><Data ss:Type="String">Testing Type</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Boundary</Data></Cell></Row><Row><Cell ss:StyleID="s50"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">14</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">8</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">5</Data></Cell></Row><Row ss:Index="11" ss:Height="28"><Cell ss:StyleID="s54"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Pre-conditions</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Input parameters</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Expected Results</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 1</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Test date</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Tester</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 2</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 3</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Defect IDs</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Note</Data></Cell></Row><Row><Cell ss:StyleID="s106" ss:MergeAcross="11"><Data ss:Type="String">GetOrderChatThreadAsync &amp; VerifyChatRoomAccessAsync (NegotiationChatService - U-08 &amp; R-05)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId tồn tại với Status = Negotiating, chủ đơn citizenId (11111111-...), cơ sở nhận đơn recyclerId (22222222-...), có 1 đề xuất Pending và 2 tin nhắn chưa đọc từ Recycler</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;callerUserId=&quot;11111111-...&quot;;&#10;callerRole=&quot;Citizen&quot;;&#10;page=1; pageSize=50</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: OrderChatThreadDto { OrderStatus = &quot;Negotiating&quot;, IsProposalLocked = false, IsChatOpen = true, UnreadCount = 2, ActiveProposal != null, Messages.TotalRecords &gt;= 2 }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tải thông tin phòng chat, trạng thái khóa IsProposalLocked và đề xuất hiệu lực (BR-NEG-01, BR-NEG-02, BR-NEG-03)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang ở trạng thái tranh chấp OrderStatus.Disputed; người gọi có vai trò Staff (33333333-...)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=disputedOrderId;&#10;callerUserId=&quot;33333333-...&quot;;&#10;callerRole=&quot;Staff&quot;;&#10;page=1; pageSize=50</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: OrderChatThreadDto { OrderStatus = &quot;Disputed&quot;, IsProposalLocked = true, Messages.Items chứa đầy đủ lịch sử tin nhắn bất biến }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cấp quyền đọc bằng chứng chat cho Staff khi đơn đang Disputed (BR-NEG-01, BR-DSP-06)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang Negotiating; người gọi là tài khoản thứ ba otherUserId (88888888-...) không thuộc đơn bàn giao</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;callerUserId=&quot;88888888-...&quot;;&#10;callerRole=&quot;Citizen&quot;;&#10;page=1; pageSize=50</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: ForbiddenAccessException (&quot;BR-NEG-01&quot;, &quot;MSG-NEG-FORBIDDEN&quot;)&#10;Log Message: &quot;Tin nhắn thương lượng chỉ hiển thị cho Người dân và Cơ sở thu gom thuộc yêu cầu bàn giao này (BR-NEG-01).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cô lập quyền riêng tư phòng chat theo đúng chủ đơn &amp; cơ sở nhận đơn (BR-NEG-01)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId hợp lệ; truyền tham số phân trang vượt biên âm và vượt trần (page = -1, pageSize = 500)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;callerUserId=&quot;11111111-...&quot;;&#10;callerRole=&quot;Citizen&quot;;&#10;page=-1; pageSize=500</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: OrderChatThreadDto { Messages.PageNumber = 1, Messages.PageSize = 100 }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tự động kẹp biên phân trang Math.Max(1, page) và Math.Clamp(pageSize, 1, 100)</Data></Cell></Row><Row><Cell ss:StyleID="s107" ss:MergeAcross="11"><Data ss:Type="String">SendMessageAsync &amp; MarkMessagesAsReadAsync (NegotiationChatService - U-08 &amp; R-05)</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang ở trạng thái Pending</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;senderUserId=&quot;11111111-...&quot;;&#10;senderRole=&quot;Citizen&quot;;&#10;MessageType=&quot;Text&quot;;&#10;MessageContent=&quot;Mình có 12kg vỏ chai PET sạch&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: (ChatMessageDto { MessageType = &quot;Text&quot;, SenderRole = &quot;Citizen&quot;, IsRead = false }, RecipientNotification = &quot;Bạn có tin nhắn mới từ Nguyễn Văn An.&quot;)&#10;Exception: N/A&#10;Log Message: &quot;[NEG] Tin nhắn Text mới trong đơn {OrderId} từ Citizen&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gửi tin nhắn văn bản thời gian thực và sinh thông báo MSG-NEG-02</Data></Cell></Row><Row ss:Height="120"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC006</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đã chốt điều khoản (OrderStatus.Accepted hoặc OrderStatus.Completed)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=acceptedOrderId;&#10;senderUserId=&quot;22222222-...&quot;;&#10;senderRole=&quot;Recycler&quot;;&#10;MessageType=&quot;Image&quot;;&#10;AttachmentUrl=&quot;https://r2.../map.jpg&quot;;&#10;MessageContent=&quot;Xe tải mình đang đậu đầu hẻm nhé&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: (ChatMessageDto { MessageType = &quot;Image&quot;, AttachmentUrl = &quot;https://r2.../map.jpg&quot; }, RecipientNotification != null)&#10;Exception: N/A&#10;Log Message: &quot;[NEG] Tin nhắn Image mới trong đơn {OrderId} từ Recycler&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Thực thi BR-NEG-02: kênh chat thông thường (Text/Image) vẫn giữ mở sau khi đơn đã Accepted hoặc Completed</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC007</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đã bị hủy hoặc từ chối (OrderStatus.Cancelled / Rejected / Expired)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=cancelledOrderId;&#10;senderUserId=&quot;11111111-...&quot;;&#10;senderRole=&quot;Citizen&quot;;&#10;MessageType=&quot;Text&quot;;&#10;MessageContent=&quot;Alo&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-NEG-02&quot;, &quot;MSG-NEG-CHAT-CLOSED&quot;)&#10;Log Message: &quot;Đơn bàn giao đang ở trạng thái 'Cancelled' nên không thể gửi tin nhắn mới.&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn gửi tin nhắn mới vào đơn đã hủy / từ chối / hết hạn</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC008</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Trong orderId có 2 tin nhắn chưa đọc từ Citizen gửi và 1 tin nhắn chưa đọc do chính Recycler gửi</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;readerUserId=&quot;22222222-...&quot;;&#10;readerRole=&quot;Recycler&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: markedCount = 2 (2 tin nhắn của Citizen chuyển IsRead = true, ReadAt != null; tin nhắn của Recycler giữ IsRead = false)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đánh dấu đã đọc chỉ áp dụng lên tin nhắn của đối phương</Data></Cell></Row><Row><Cell ss:StyleID="s108" ss:MergeAcross="11"><Data ss:Type="String">SendProposalAsync (NegotiationChatService - U-08 &amp; R-05)</Data></Cell></Row><Row ss:Height="134"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC009</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang ở trạng thái Pending (ProposedTimeSlot = &quot;2026-11-05 09:00 - 11:00&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;senderUserId=&quot;11111111-...&quot;;&#10;senderRole=&quot;Citizen&quot;;&#10;ProposedPricePerKg=7500;&#10;ProposedWeightKg=12.5;&#10;ProposedTimeSlot=&quot;2026-11-05 14:00 - 16:00&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: (ProposalMessage { MessageType = &quot;Proposal&quot;, Proposal.ProposalStatus = &quot;Pending&quot; }, SupersededIds = [], ToastMessage = &quot;Yêu cầu trao đổi của bạn đã được gửi đến Vựa phế liệu EcoGreen.&quot;) (TradeOrder.Status chuyển sang Negotiating)&#10;Exception: N/A&#10;Log Message: &quot;[NEG] Đề xuất thương lượng mới {ProposalId} trong đơn {OrderId}&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chuyển trạng thái Pending -&gt; Negotiating (BR-HND-02), cập nhật khung giờ (BR-NEG-04) và trả về MSG-NEG-01</Data></Cell></Row><Row ss:Height="120"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC010</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang Negotiating và đã có đề xuất proposalId_1 ở trạng thái ProposalStatus.Pending</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;senderUserId=&quot;22222222-...&quot;;&#10;senderRole=&quot;Recycler&quot;;&#10;ProposedPricePerKg=7200;&#10;ProposedWeightKg=12.5;&#10;ProposedTimeSlot=&quot;2026-11-05 15:00 - 17:00&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: (ProposalMessage #2 { ProposalStatus = &quot;Pending&quot; }, SupersededIds = [proposalId_1]) (proposalId_1 trong DB chuyển thành ProposalStatus.Superseded)&#10;Exception: N/A&#10;Log Message: &quot;[NEG] Đề xuất thương lượng mới {ProposalId} trong đơn {OrderId} (Ghi đè 1 đề xuất cũ).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Thực thi BR-NEG-03: phản đề xuất mới tự động ghi đè (Superseded) đề xuất trước đó</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC011</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đã được chốt (OrderStatus.Accepted hoặc OrderStatus.Scheduled)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=acceptedOrderId;&#10;senderUserId=&quot;11111111-...&quot;;&#10;senderRole=&quot;Citizen&quot;;&#10;ProposedPricePerKg=8000;&#10;ProposedWeightKg=12.5;&#10;ProposedTimeSlot=&quot;2026-11-06 09:00 - 11:00&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-NEG-02&quot;, &quot;MSG-NEG-PROPOSAL-LOCKED&quot;)&#10;Log Message: &quot;Việc đưa ra hoặc sửa đổi đề xuất giá/khung giờ chỉ được phép khi đơn đang 'Pending' hoặc 'Negotiating' (BR-NEG-02).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Thực thi BR-NEG-02: khóa hoàn toàn tính năng gửi đề xuất mới sau khi đơn chuyển sang Accepted</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC012</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId không tồn tại trong bảng trade_orders</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=&quot;99999999-9999-9999-9999-999999999999&quot;;&#10;senderUserId=&quot;11111111-...&quot;;&#10;request=SendProposalRequest</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: NotFoundException (&quot;Không tìm thấy yêu cầu bàn giao...&quot;)&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra tồn tại của đơn bàn giao trước khi thương lượng</Data></Cell></Row><Row><Cell ss:StyleID="s109" ss:MergeAcross="11"><Data ss:Type="String">RespondToProposalAsync &amp; AcceptOrderInitialTermsAsync (NegotiationChatService - U-08 &amp; R-05)</Data></Cell></Row><Row ss:Height="134"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC013</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang Negotiating; proposalId_2 do Recycler gửi đang ở trạng thái ProposalStatus.Pending (7,200 đ/kg, 12.5 kg, &quot;2026-11-05 15:00 - 17:00&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;proposalMessageId=proposalId_2;&#10;responderUserId=&quot;11111111-...&quot; (Citizen);&#10;IsAccepted=true</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: (ProposalAcceptanceResultDto { OrderStatus = &quot;Accepted&quot;, AgreedPricePerKg = 7200, ConfirmedWeightKg = 12.5, ConfirmedTimeSlot = &quot;2026-11-05 15:00 - 17:00&quot;, IsProposalLocked = true, SystemMessage.MessageType = &quot;System&quot; }, ToastMessage = &quot;Nguyễn Văn An đã chấp nhận đề nghị của bạn.&quot;)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Lưu cứng điều khoản vào TradeOrder, khóa khung giờ thu gom (BR-NEG-03, BR-NEG-05) và trả về MSG-NEG-03</Data></Cell></Row><Row ss:Height="120"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC014</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang Pending kèm InitialPricePerKg = 7000, ProposedTimeSlot = &quot;2026-11-05 09:00 - 11:00&quot;; chưa có phản đề xuất trung gian</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;recyclerUserId=&quot;22222222-...&quot;;&#10;recyclerRole=&quot;Recycler&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: (ProposalAcceptanceResultDto { OrderStatus = &quot;Accepted&quot;, AgreedPricePerKg = 7000, ConfirmedTimeSlot = &quot;2026-11-05 09:00 - 11:00&quot;, IsProposalLocked = true }, ToastMessage = &quot;Vựa phế liệu EcoGreen đã chấp nhận đề nghị của bạn.&quot;)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Recycler (R-05) bấm chấp nhận trực tiếp yêu cầu bàn giao để chốt khung giờ chính thức (BR-NEG-05)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC015</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">proposalId_2 được gửi bởi Recycler (22222222-...); chính Recycler gọi RespondToProposalAsync để tự chấp nhận</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;proposalMessageId=proposalId_2;&#10;responderUserId=&quot;22222222-...&quot;;&#10;IsAccepted=true</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-NEG-03&quot;, &quot;MSG-NEG-SELF-RESPONSE&quot;)&#10;Log Message: &quot;Bạn không thể tự phản hồi đề xuất do chính mình tạo ra. Chỉ đối phương mới có quyền chấp nhận hoặc từ chối.&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn người tạo đề xuất tự bấm chấp nhận đề xuất của chính mình (BR-NEG-03)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC016</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">proposalId_1 đã bị ghi đè sang trạng thái ProposalStatus.Superseded bởi proposalId_2</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;proposalMessageId=proposalId_1;&#10;responderUserId=&quot;11111111-...&quot;;&#10;IsAccepted=true</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-NEG-03&quot;, &quot;MSG-NEG-SUPERSEDED&quot;)&#10;Log Message: &quot;Đề xuất này đã bị ghi đè bởi một đề xuất mới hơn. Chỉ đề xuất mới nhất đang hiệu lực mới có thể chấp nhận (BR-NEG-03).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn chấp nhận đề xuất cũ đã hết hiệu lực (BR-NEG-03)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC017</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen (11111111-...) cố tình gọi AcceptOrderInitialTermsAsync của phía Recycler</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">orderId=validOrderId;&#10;recyclerUserId=&quot;11111111-...&quot;;&#10;recyclerRole=&quot;Citizen&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: ForbiddenAccessException (&quot;BR-NEG-05&quot;, &quot;MSG-NEG-ONLY-RECYCLER&quot;)&#10;Log Message: &quot;Chỉ cơ sở thu gom (Recycler) nhận đơn mới có quyền bấm chấp nhận yêu cầu bàn giao ban đầu (BR-NEG-05).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Bảo vệ quyền chốt đơn ban đầu dành riêng cho Recycler nhận đơn (BR-NEG-05)</Data></Cell></Row><Row><Cell ss:StyleID="s110" ss:MergeAcross="11"><Data ss:Type="String">SendChatMessageRequestValidator &amp; SendProposalRequestValidator (NegotiationChatValidators)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC018</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra độ dài biên của nội dung tin nhắn văn bản (2000 ký tự vs 2001 ký tự)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">MessageType=&quot;Text&quot;;&#10;MessageContent=new string('a', 2000) (và 2001 ký tự)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: IsValid = true với 2000 ký tự; IsValid = false với 2001 ký tự (&quot;Nội dung tin nhắn không được vượt quá 2000 ký tự.&quot;)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra biên trên độ dài tin nhắn văn bản MaxLength = 2000</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC019</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra giá trị biên trên của đơn giá và khối lượng trong bản đề xuất</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ProposedPricePerKg=10_000_000;&#10;ProposedWeightKg=100_000;&#10;ProposedTimeSlot=&quot;2026-11-05 08:00 - 10:00&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: ValidationResult { IsValid = true, Errors.Count = 0 }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chấp nhận giá trị biên hợp lệ tối đa 10.000.000 VNĐ/kg và 100.000 kg</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC020</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gửi tin nhắn Image thiếu AttachmentUrl hoặc gửi đề xuất có ProposedPricePerKg = 0 và bỏ trống ProposedTimeSlot</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ProposedPricePerKg=0;&#10;ProposedWeightKg=-5;&#10;ProposedTimeSlot=&quot;&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: ValidationResult { IsValid = false, Errors.Count = 3 (đơn giá &gt; 0, khối lượng &gt; 0, khung giờ không được để trống) }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-03</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Bắt lỗi đầu vào khi thiếu khung giờ đề xuất hoặc giá/khối lượng âm (BR-NEG-04)</Data></Cell></Row><Row><Cell ss:StyleID="s111" ss:MergeAcross="11"><Data ss:Type="String">TradeTransactionService (Inquiry Draft, TimeSlot Window, Order Inbox) &amp; SendProposalAsync (v2.7.0)</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC021</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen citizen_hl &amp; Recycler collector_hl1 có RecyclerProfile (Verified, Online) và CollectionPartner trong InMemory DB</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreateTradeOrderAsync(UserId = citizen.Id, PartnerId = recyclerUser.Id, EstimatedWeightKg = 10, CategoryCode = &quot;plastic&quot;, InitialPricePerKg = 5500, ProposedTimeSlot = &quot;10:00 - 12:00&quot;, PickupAddress = &quot;Cổng phụ Khu CNC Hòa Lạc&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: TradeOrderDto { PartnerName = &quot;Trạm Thu Gom Tái Chế Xanh Hòa Lạc&quot;, RecyclerUserId = recyclerUser.Id, Status = &quot;Pending&quot; }; đơn xuất hiện ở cả GetUserOrdersAsync(citizen.Id) và GetUserOrdersAsync(recyclerUser.Id)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khởi tạo đơn thương lượng qua tra cứu RecyclerProfile &amp; đồng bộ danh sách đơn cho 2 phía</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC022</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen &amp; Recycler (CollectionPartner) hợp lệ trong DB</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi CreateTradeOrderAsync(UserId = citizen.Id, PartnerId = recyclerUser.Id, IsInquiryDraft = true) 2 lần liên tiếp</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Lần 1: Status = &quot;Negotiating&quot;, IsInquiryOnly = true, EstimatedWeightKg = 0, CategoryCode = null, AgreedPricePerKg = null, không tạo dòng HandoverRequests; Lần 2: trả lại đúng Id đơn cũ (Count(TradeOrders) == 1)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tạo &amp; tái sử dụng nháp phòng chat hỏi giá (IsInquiryDraft) tránh sinh đơn rác</Data></Cell></Row><Row ss:Height="120"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC023</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang ở trạng thái Negotiating</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">SendProposalAsync(order.Id, citizen.Id, &quot;Citizen&quot;, { ProposedPricePerKg = 24000, ProposedWeightKg = 6.5, ProposedTimeSlot = &quot;14:00 - 16:00&quot;, CategoryCode = &quot;metal&quot;, PickupAddress = &quot;Cổng phụ Khu CNC Hòa Lạc, Thạch Thất, Hà Nội&quot;, Note = &quot;Vỏ lon nhôm đã ép dẹp&quot; })</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">proposalMsg.Proposal.CategoryCode = &quot;metal&quot;, PickupAddress khớp; TradeOrder trong DB cập nhật CategoryCode = &quot;metal&quot;, EstimatedWeightKg = 6.5, PickupAddress tương ứng</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cập nhật loại phế liệu, khối lượng &amp; địa chỉ lấy hàng ngay trong luồng đề xuất chat</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC024</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen mở nháp chat hỏi giá (IsInquiryDraft = true) với Recycler có bảng giá &quot;plastic&quot; (7,200 đ/kg)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nâng cấp qua CreateTradeOrderAsync(..., EstimatedWeightKg = 10, CategoryCode = &quot;plastic&quot;, InitialPricePerKg = 7200, IsInquiryDraft = false)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giữ nguyên Id của đơn hỏi giá, chuyển IsInquiryOnly = false, Status = &quot;Pending&quot;, AgreedPricePerKg = null; HandoverRequestItems.AgreedPricePerKg = null; GetOrderChatThreadAsync trả IsProposalLocked = false</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nâng cấp đơn hỏi giá thành yêu cầu bàn giao chính thức mà không khóa cứng giá trước khi chốt</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC025</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen &amp; Recycler hợp lệ; ngày hiện tại theo ICT (UTC + 7)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreateTradeOrderAsync &amp; UpdateOrderTimeSlotAsync với ngày quá khứ (-1 ngày), vượt biên (+31 ngày), biên hợp lệ (+30 ngày) và giữa khoảng (+15 ngày)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Ngày -1 và +31 đều ném BusinessRuleException (&quot;BR-NEG-04&quot;); ngày +30 và +15 thành công và đồng bộ ScheduledAt về đúng ngày ICT tương ứng</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra biên khung ngày đặt lịch [Today .. Today + 30 ngày] (BR-NEG-04)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC026</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn orderId đang Negotiating; ngày hiện tại theo ICT (UTC + 7)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">SendProposalAsync với ProposedTimeSlot ngày -1, ngày +31 và ngày +30</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Ngày -1 và +31 đều ném BusinessRuleException (&quot;BR-NEG-04&quot;); ngày +30 hợp lệ, Proposal.ProposedTimeSlot lưu đúng và TradeOrder.ScheduledAt đồng bộ +30 ngày</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra biên khung ngày hẹn [Today .. Today + 30 ngày] khi gửi đề xuất thương lượng</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC027</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">quietOrder (tạo cách -2h, có tin Citizen &amp; System chưa đọc) và activeOldOrder (tạo -4h, có tin Image -10m &amp; Text -5m chưa đọc từ Recycler)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">tradeService.GetUserOrdersAsync(citizen.Id)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Trả về 2 đơn xếp activeOldOrder ở [0] (UnreadCount = 2, LastMessagePreview = &quot;Hẹn bạn 14h nhé&quot;, LastMessageSenderId = recyclerUser.Id, LastMessageSenderRole = &quot;Recycler&quot;), quietOrder ở [1] (UnreadCount = 0, LastMessagePreview = &quot;Thông báo hệ thống&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Sắp xếp hộp thư đơn theo tin nhắn mới nhất, đếm đúng tin chưa đọc từ đối phương &amp; hiển thị preview</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="9_Governance_Analytics"><Table ss:ExpandedColumnCount="12" ss:ExpandedRowCount="46" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="48" ss:DefaultRowHeight="12.75"><Column ss:Index="1" ss:StyleID="Default" ss:Width="85"/><Column ss:Index="2" ss:StyleID="Default" ss:Width="180"/><Column ss:StyleID="Default" ss:Width="210"/><Column ss:StyleID="Default" ss:Width="290"/><Column ss:StyleID="Default" ss:Width="75"/><Column ss:StyleID="Default" ss:Width="65"/><Column ss:StyleID="Default" ss:Width="80"/><Column ss:StyleID="Default" ss:Width="130"/><Column ss:StyleID="Default" ss:Width="65" ss:Span="1"/><Column ss:Index="11" ss:StyleID="Default" ss:Width="75"/><Column ss:StyleID="Default" ss:Width="180"/><Row ss:Index="2"><Cell ss:StyleID="s50"><Data ss:Type="String">Code Module</Data></Cell><Cell ss:StyleID="s112" ss:MergeAcross="2"><Data ss:Type="String">AdminAnalyticsService, AccountGovernanceService, StaffManagementService, StaffAttendanceService, AuditLogService &amp; GovernanceValidators</Data></Cell></Row><Row><Cell ss:StyleID="s50"><Data ss:Type="String">Number of TCs</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">30</Data></Cell><Cell ss:StyleID="s113" ss:MergeAcross="1"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Testing Round</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Failed</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Pending</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 1</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">30</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 2</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">30</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 3</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">30</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Testing Type</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Boundary</Data></Cell></Row><Row><Cell ss:StyleID="s50"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">15</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">10</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">5</Data></Cell></Row><Row ss:Index="11" ss:Height="28"><Cell ss:StyleID="s54"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Pre-conditions</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Input parameters</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Expected Results</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 1</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Test date</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Tester</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 2</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 3</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Defect IDs</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Note</Data></Cell></Row><Row><Cell ss:StyleID="s114" ss:MergeAcross="11"><Data ss:Type="String">AdminAnalyticsService &amp; AuditLogService (A-01 &amp; A-02)</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có 1 Citizen Active, 1 Recycler Verified, 1 Recycler Pending, 2 đơn Completed (10 kg, 100.000đ), 1 đơn Cancelled (50 kg), 1 đơn VietQR PAID (199.000đ)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Period=&quot;30d&quot;;&#10;FromDate=null; ToDate=null</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: ExecutiveKpiSummaryDto { ActiveCitizensCount = 1, VerifiedRecyclersCount = 1, CompletedHandoversCount = 2, TotalRecycledWeightKg = 10.0, GrossTradeValueVnd = 100000, VietQrServiceRevenueVnd = 199000, OperationalBacklog.PendingRecyclerKybCount = 1 }&#10;Exception: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Loại trừ đơn Cancelled và cơ sở Pending khỏi số liệu KPI thực tế (BR-ADM-07)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có 1 đơn Completed gồm 6 kg Nhựa (Plastic) và 4 kg Giấy (Paper), kèm 1 đơn Pending 90 kg</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">months=6</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AnalyticsChartsDto { MonthlyHandoverTrend.Count = 6, MonthlyHandoverTrend[^1].RecycledWeightKg = 10, WasteCategoryBreakdown[0].CategoryCode = &quot;PLASTIC&quot;, WasteCategoryBreakdown[0].SharePercent = 60 }</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Biểu đồ xu hướng &amp; tỷ trọng chỉ tính trên giao dịch đã hoàn tất (BR-ADM-07)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi GetAnalyticsChartsAsync với số tháng dưới biên và vượt biên</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">months=0 và months=36</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: MonthlyHandoverTrend.Count = 1 (khi 0) và 12 (khi 36)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kẹp biên Math.Clamp(months, 1, 12)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có tài khoản &quot;duc.nguyen@email.vn&quot;, SĐT &quot;0912345678&quot; trong bảng users</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Dataset=&quot;accounts&quot;;&#10;Format=&quot;csv&quot; và Format=&quot;xlsx&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: CSV có UTF-8 BOM (0xEF 0xBB 0xBF), XLSX hợp lệ chuẩn OpenXML ZIP; cả hai chứa &quot;du***@email.vn&quot; &amp; &quot;091****678&quot;, không lộ PII gốc; sinh 2 dòng EXPORT_REPORT trong audit_logs</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm chứng che dấu PII (BR-ADM-06) &amp; tự động ghi Audit Log (BR-ADM-05)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Truyền định dạng xuất tệp &quot;pdf&quot; hoặc dataset &quot;secret_tokens&quot; không hỗ trợ</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Dataset=&quot;accounts&quot;, Format=&quot;pdf&quot; và Dataset=&quot;secret_tokens&quot;, Format=&quot;csv&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Exception: BusinessRuleException (&quot;BR-ADM-06&quot;, &quot;MSG-GEN-01&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn định dạng &amp; tên dataset ngoài danh sách hỗ trợ</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC006</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đã tồn tại 1 bản ghi AuditLog trong CSDL với Action = &quot;TEST_ACTION&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Thử cập nhật savedLog.Reason và thử db.AuditLogs.Remove(savedLog) rồi SaveChangesAsync()</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Exception: InvalidOperationException chứa &quot;BR-ADM-05&quot; trên cả Update và Delete</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cưỡng chế bất biến Append-Only qua AuditLogImmutabilityInterceptor (BR-ADM-05)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC007</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có 2 bản ghi AuditLog: &quot;LOCK_ACCOUNT&quot; và &quot;EXPORT_REPORT&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Action=&quot;export_report&quot;;&#10;Keyword=&quot;tuần 46&quot;;&#10;PageNumber=1, PageSize=10</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: PagedResult&lt;AuditLogItemDto&gt; { TotalRecords = 1, Items[0].Action = &quot;EXPORT_REPORT&quot; }</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Lọc đa điều kiện trên bảng audit_logs chỉ đọc (A-02)</Data></Cell></Row><Row><Cell ss:StyleID="s115" ss:MergeAcross="11"><Data ss:Type="String">AccountGovernanceService (S-06 &amp; S-07)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC008</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có 1 Admin, 1 Staff, 1 Citizen (14.5 kg, 150 điểm xanh) và 1 Recycler</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetAccountsAsync(new()) và GetAccountDetailAsync(citizenId)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: List TotalRecords = 2 (loại trừ Staff &amp; Admin); Detail ActivityStats { CompletedDealsCount = 1, TotalRecycledKg = 14.5, GreenPoints = 150 }</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Phân tách danh sách kiểm duyệt ngoài với tài khoản vận hành nội bộ (S-06)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC009</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có user u0 (WarningCount = 0) và u2 (WarningCount = 2)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">MinWarnings=2;&#10;PageNumber=-3;&#10;PageSize=500</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: PagedResult { PageNumber = 1, PageSize = 100, TotalRecords = 1, Items[0].Username = &quot;u2&quot; }</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kẹp biên phân trang [1, 100] và lọc ngưỡng số lần cảnh cáo</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC010</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Recycler &quot;minhkhai&quot; đang Active/Online, có 2 RefreshToken active và khóa cache &quot;auth_snapshot:{id}&quot; trong IMemoryCache</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khóa (IsLocked=true, Reason&gt;=10, IncrementWarning=true), sau đó mở khóa (IsLocked=false)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Lock -&gt; Status = Suspended, WarningCount = 1, 2 RefreshTokens revoked, Recycler Offline, Cache evicted; Unlock -&gt; Status = Active, FailedLoginAttempts = 0, AccountModerationLogs = 2</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khóa/mở khóa đồng bộ thu hồi phiên, tắt bản đồ và xóa cache JWT tức thời (BR-ADM-03)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC011</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen &quot;user1&quot; đang Active; nhập lý do khóa ngắn &quot;Quá ngắn&quot; (&lt; 10 ký tự)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">actorId=staffId, targetId=citizenId;&#10;IsLocked=true, Reason=&quot;Quá ngắn&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Exception: BusinessRuleException (&quot;BR-ADM-03&quot;, &quot;MSG-GEN-01&quot;); Citizen giữ nguyên Active</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cưỡng chế bắt buộc lý do kiểm duyệt tối thiểu 10 ký tự (BR-ADM-03)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC012</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Staff A cố tình gọi LockOrUnlockAccountAsync hoặc DeactivateAccountAsync lên Admin</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">actorId=staffId, targetId=adminId;&#10;Reason &gt;= 10</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Exception: ForbiddenAccessException (&quot;BR-ADM-03&quot;, &quot;MSG-ADM-04&quot;); Admin giữ nguyên Active</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn Staff leo thang đặc quyền khóa/vô hiệu hóa nội bộ (BR-ADM-03)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC013</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen &quot;citizen_hist&quot; đã có 5 đơn Completed và 5 HandoverReceipts</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">DeactivateAccountAsync(adminId, citizenId, Reason)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: Status = &quot;Deactivated&quot;, CompletedDealsCount = 5; User không bị xóa vật lý và còn nguyên 5 HandoverReceipts</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Vô hiệu hóa mềm bảo toàn đối soát lịch sử tài chính (BR-ADM-04)</Data></Cell></Row><Row><Cell ss:StyleID="s116" ss:MergeAcross="11"><Data ss:Type="String">StaffManagementService (A-03 &amp; A-04)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC014</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Admin adminId hợp lệ; chưa có Staff &quot;ngoc.pham@ecolink.vn&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreateStaffAccountAsync (không truyền quyền), sau đó UpdateStaffAccountAsync kèm ResetTemporaryPassword</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Created StaffCode = &quot;NV-001&quot;, Permissions = [] (0 quyền mặc định); Update đổi phòng ban &amp; thu hồi RefreshToken cũ</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Áp dụng Least-Privilege (BR-ADM-01) &amp; cấp lại mật khẩu tạm</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC015</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đã tồn tại Staff &quot;nv1@ecolink.vn&quot; với StaffCode = &quot;NV-088&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tạo Staff mới trùng email &quot;NV1@ECOLINK.VN&quot; và thử tạo khác email nhưng trùng StaffCode=&quot;NV-088&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Exception: BusinessRuleException (&quot;BR-AUTH-01&quot; khi trùng Email; &quot;BR-ADM-01&quot; khi trùng StaffCode)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Bảo vệ tính duy nhất Email &amp; Mã nhân viên nội bộ</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC016</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Staff staff.StaffId cố tình tự đình chỉ chính mình; hoặc Admin truyền Status = &quot;DeletedForever&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">UpdateStaffStatusAsync(staffId, staffId, ...) và UpdateStaffStatusAsync(adminId, staffId, &quot;DeletedForever&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Self-lock -&gt; ForbiddenAccessException (&quot;MSG-ADM-04&quot;); Invalid status -&gt; BusinessRuleException (&quot;BR-ADM-03&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn tự khóa chính mình &amp; kiểm soát tập trạng thái nhân sự</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC017</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Staff vừa tạo; cấp quyền [&quot;ai.dataset&quot;, &quot;MANAGE_ACCOUNTS&quot;], sau đó thu hồi còn [&quot;CURATE_DATASET&quot;]</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">UpdateStaffPermissionsAsync và GetStaffPermissionsAsync</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chuẩn hóa &quot;ai.dataset&quot; -&gt; &quot;CURATE_DATASET&quot;; thu hồi xóa ngay key &quot;auth_snapshot:{id}&quot; khỏi IMemoryCache và ghi OldValues chứa &quot;MANAGE_ACCOUNTS&quot; vào audit_logs</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chuẩn hóa 2 chiều RBAC &amp; hiệu lực thu hồi quyền tức thời (BR-ADM-02, MSG-ADM-01)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC018</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi StaffPermissions.Normalize/IsValid và truyền &quot;SUPER_ROOT_HACK&quot; vào UpdateStaffPermissionsAsync</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Permissions = [&quot;SUPER_ROOT_HACK&quot;]</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">IsValid = false; UpdateStaffPermissionsAsync ném BusinessRuleException (&quot;BR-ADM-02&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn cấp phát mã quyền ngoài danh mục 7 quyền chuẩn (BR-ADM-02)</Data></Cell></Row><Row><Cell ss:StyleID="s117" ss:MergeAcross="11"><Data ss:Type="String">StaffAttendanceService &amp; GovernanceValidators (S-11 &amp; Validation)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC019</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Staff &quot;staff_att&quot; có UserEcoProfile.CurrentGreenPoints = 0, thực hiện 1 tác vụ kiểm toán trong ca</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CheckInAsync -&gt; LogAsync -&gt; CheckOutAsync -&gt; GetAllStaffAttendanceAsync</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CheckIn -&gt; +10 WorkPointsEarned, CurrentStreakDay = 1, CurrentGreenPoints vẫn = 0; CheckOut &amp; Admin report ghi nhận TasksCompletedSnapshot &gt;= 1</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tách biệt ví điểm công dân (BR-GAM-08) &amp; ghi nhận nhật ký ca (S-11)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC020</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Staff thử CheckOutAsync khi chưa CheckIn; thử CheckIn lần 2 cùng ngày; thử CheckOut lần 2</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi lặp CheckInAsync &amp; CheckOutAsync sai thứ tự</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cả 3 tình huống đều ném BusinessRuleException (&quot;BR-GAM-09&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cưỡng chế 1 lượt Check-in / Check-out mỗi ngày theo múi giờ UTC+7 (BR-GAM-09)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC021</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">3 nhân viên với lịch sử trước đó: (A) hôm qua StreakDay = 6, (B) hôm qua StreakDay = 7, (C) cách 2 ngày StreakDay = 5</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi CheckInAsync trong ngày hôm nay (UTC+7) cho cả 3 nhân viên</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">(A) -&gt; StreakDay = 7, PointsEarned = 15; (B) -&gt; quay vòng StreakDay = 1, PointsEarned = 10; (C) -&gt; đứt chuỗi reset StreakDay = 1</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm thử chính xác 3 biên chuỗi chuyên cần 7 ngày (BR-GAM-09)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC022</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khởi tạo cả 8 FluentValidators trong GovernanceValidators.cs</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Test độ dài biên: Reason (9/10/501), FullName (2/3), Password (7/8), ShiftNote (500/501), Permissions</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đạt chuẩn biên: từ chối &lt; 10 ký tự lý do, &lt; 3 tên, &lt; 8 mật khẩu, &gt; 500 ghi chú ca trực và sai mã trạng thái/quyền</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-16</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Xác minh toàn diện các ngưỡng Validation trước tầng Service</Data></Cell></Row><Row><Cell ss:StyleID="s118" ss:MergeAcross="11"><Data ss:Type="String">NotificationService &amp; InMemoryChannelEventBus (SU-04, EI-07, v2.6.0)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC023</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Trong DB có 3 thông báo của userA (2 chưa đọc) và 1 của userB</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetMyNotificationsAsync(userA, IsRead=false, NotificationType=&quot;payment_success&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: UnreadCount = 2, TotalRecords = 1, chỉ trả về thông báo khớp loại của userA</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cô lập &amp; lọc hộp thư thông báo</Data></Cell></Row><Row ss:Height="45"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC024</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">userId có 2 thông báo chưa đọc (n1, n2)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">MarkAsReadAsync(userId, n1.Id)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">n1.IsRead = true, ReadAt != null, UnreadCount = 1, gọi PushUnreadCountAsync(userId, 1)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đánh dấu đã đọc &amp; đồng bộ SignalR</Data></Cell></Row><Row ss:Height="45"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC025</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Thông báo thuộc quyền sở hữu của ownerId</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">MarkAsReadAsync(intruderId, notif.Id) và ID không tồn tại</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Throw ForbiddenAccessException(&quot;BR-NTF-01&quot;, &quot;MSG-NTF-02&quot;) và NotFoundException</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chống IDOR trên thông báo</Data></Cell></Row><Row ss:Height="45"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC026</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">userA có 2 thông báo chưa đọc, userB có 1 chưa đọc</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">MarkAllAsReadAsync(userA)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">MarkedCount = 2, UnreadCount = 0; thông báo của userB giữ nguyên chưa đọc</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đánh dấu đã đọc tất cả an toàn</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC027</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Mock INotificationRealtimeNotifier sẵn sàng</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreateAndPushAsync(userId, &quot;Thanh toán thành công&quot;, ..., &quot;payment_success&quot;, ...)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Lưu DB (NotificationType = &quot;PAYMENT_SUCCESS&quot;), gọi PushNotificationAsync kèm unreadCount = 1</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Phát thông báo bền vững + realtime</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC028</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chuỗi chứa SĐT VN 0912345678, email citizen.user@ecolink.vn, mã đơn ECO20261120</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">NotificationService.MaskSensitivePii(raw)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Che SĐT -&gt; 091***78, Email -&gt; c***@ecolink.vn, giữ nguyên ECO20261120 và 150,000 VNĐ (BR-NTF-05)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Bảo mật che PII trong thông báo</Data></Cell></Row><Row ss:Heigh