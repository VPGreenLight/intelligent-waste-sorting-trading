    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;2_AI_Classification&apos;!A1"><Data ss:Type="String">2_AI_Classification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử quản trị chính sách nền tảng (BR-POL-03), 10 nhóm rác YOLO26 Two-Stage và chặn định giá nhóm không tái chế (BR-MTH-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Bảng waste_categories có 10 danh mục (gồm battery, biological, trash).</Data></Cell>
   </Row>
