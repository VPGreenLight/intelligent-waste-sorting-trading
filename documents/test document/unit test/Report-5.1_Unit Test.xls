tring">Ném BusinessRuleException (RuleCode=&quot;BR-PAY-01&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC011_CreatePayInOrder_TamperedClientAmount_ThrowsBrPay01_Abnormal] Chống giả mạo giá</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC012</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">User A tạo đơn PREMIUM, User B khác sở hữu</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">User B gọi GetUserOrdersAsync, GetOrderForUserAsync, CancelPendingOrderAsync</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Danh sách của User B rỗng; xem và hủy đơn của A ném ForbiddenAccessException</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC012_OtherCitizenViewOrCancelOrder_ThrowsForbiddenIdor_Abnormal] Chống IDOR (BR-AUTH-08)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC013</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tài khoản Role = User (Citizen)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi CreatePayInOrderAsync với &quot;BASIC&quot; và &quot;PRO&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Mua BASIC ném BusinessRuleException (&quot;BR-PAY-01&quot;); mua PRO ném ForbiddenAccessException</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC013_PurchaseFreeBasicOrCitizenBuyPro_Rejected_Abnormal] BR-PAY-01, BR-PAY-03</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC014</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Recycler có hồ sơ KYB VerificationStatus = Pending</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetAvailablePackagesAsync &amp; CreatePayInOrderAsync(&quot;PRO&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">PRO.IsEligible = false; tạo đơn ném BusinessRuleException (&quot;MSG-PAY-06&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC014_UnverifiedKybRecyclerBuyPro_ThrowsMsgPay06_Abnormal] Khóa KYB gói PRO</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC015</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn PREMIUM (59,000đ) đang Pending</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">SimulateTransferAsync(&quot;Underpaid&quot;, 50_000m)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Status=&quot;PENDING&quot;, ReconciliationStatus=&quot;Underpaid&quot;, không kích hoạt gói (CurrentTier=&quot;Basic&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC015_UnderpaidWebhook_KeepsPendingAndFlagsAnomalyWithoutActivation_Abnormal] Kịch bản Underpaid</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC016</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cấu hình VietQr:WebhookSecret = &quot;ecolink-super-secret&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ProcessWebhookAsync(Signature=&quot;BAD_SIGNATURE&quot;, headerSecret=&quot;wrong-header&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Trả về Success=false, Status=&quot;INVALID_SIGNATURE&quot;, ghi log InvalidSignature</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC016_InvalidWebhookSignature_RejectedWithMsgPay05AndLogsAudit_Abnormal] Bảo mật chữ ký (MSG-PAY-05)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC017</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hệ thống có gói BASIC &amp; đơn PREMIUM đã thanh toán Paid</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">TogglePackageStatusAsync(BasicId, false) &amp; CancelPendingOrderAsync(paidOrder)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tắt BASIC ném BusinessRuleException (&quot;BR-PAY-05&quot;); hủy đơn Paid ném ConflictException (&quot;BR-PAY-01&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC017_DisableBasicPackageAndCancelPaidOrder_ThrowExpectedRules_Abnormal] Khóa gói nền &amp; đơn đã thu tiền</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC018</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn PRO (1tr) và webhook mồ côi 500k</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ManualMatchOrder thiếu tiền, CloseAnomaly rồi thử MarkRefunded lần 2</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khớp thiếu tiền ném BusinessRuleException (&quot;BR-PAY-06&quot;); xử lý lần 2 ném ConflictException (&quot;BR-PAY-06&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC018_AdminDoubleResolveOrUnderfundedManualMatch_Rejected_Abnormal] Chống đối soát sai / lặp</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC019</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn PREMIUM (59,000đ) trong hạn QR</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">SimulateTransferAsync(&quot;Overpaid&quot;, 65_000m)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Status=&quot;PAID&quot;, ReconciliationStatus=&quot;Overpaid&quot;, PaidAmount=65000, kích hoạt ngay Premium</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC019_OverpaidWebhook_ActivatesPackageImmediatelyAndFlagsOverpaid_Boundary] Biên dư tiền (Overpaid)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC020</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đơn PRO (1tr) vừa quá hạn QR 15 phút</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">SimulateTransferAsync(&quot;LateTransfer&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Status=&quot;EXPIRED&quot;, ReconciliationStatus=&quot;LateTransfer&quot;, ghi log LateTransfer không tự kích hoạt</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC020_LateTransferOnExpiredQr_MarksExpiredAndFlagsLateTransfer_Boundary] Biên quá hạn 15 phút</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC021</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Citizen lần đầu đọc cache (Basic), sau đó thanh toán PREMIUM</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetUserEntitlementsAsync, SimulateTransferAsync, GetBatchEntitlementsAsync([])</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cache ban đầu trả Basic; sau SimulateTransfer tự xóa cache trả Premium; tập ID rỗng trả từ điển rỗng</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC021_EntitlementCacheHitAndInvalidation_UpdatesImmediatelyAfterActivation_Boundary] Vòng đời IMemoryCache</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC022</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hai bộ UpsertServicePackageRequestValidator &amp; ResolvePaymentAnomalyRequestValidator</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Biên giá 2,000đ vs 1,500đ; chu kỳ 1/730 vs 0/731; note 10/9 ký tự; thiếu TargetOrderCode/BankRef</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giá &lt; 2000, chu kỳ ngoài [1..730], note &lt; 10 ký tự, hoặc thiếu trường bắt buộc trả IsValid=false</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-17</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC022_ServicePackageValidators_EnforceBoundaryPricesDurationsAndResolutionNote_Boundary] FluentValidation Boundaries</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC023</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Recycler Verified đang kích hoạt gói PRO</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetAvailablePackagesAsync, sau đó CreatePayInOrderAsync(&quot;PREMIUM&quot;) và CreatePayInOrderAsync(&quot;PRO&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">BASIC &amp; PREMIUM có IsIncludedInHigherPlan=true, CanRenew=false; PRO có IsCurrentPlan=true, IsEligible=false, IsNotCurrentlyActivePro=false; mua PREMIUM ném BR-PAY-04; mua lại PRO ném MSG-PAY-06</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC023_ActivePro_MarksLowerPackagesIncluded_DisablesRenewal_AndBlocksPremiumOrProRepurchase] Chặn hạ cấp &amp; gia hạn lặp PRO (BR-PAY-04, R-07)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC024</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Recycler rec_w5 (WarningCount = 5) và rec_w6 (WarningCount = 6), cả hai đều Verified</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreatePayInOrderAsync(&quot;PRO&quot;) cho rec_w5; GetAvailablePackagesAsync &amp; CreatePayInOrderAsync(&quot;PRO&quot;) cho rec_w6</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">rec_w5 tạo đơn PRO thành công; rec_w6 có PRO.IsEligible=false, IsWarningLimitOk=false, CurrentWarningCount=6 và ném BusinessRuleException (&quot;MSG-PAY-06&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC024_ProEligibility_AllowsUpTo5WarningsAndIgnoresComplaints_BlocksAt6Warnings] Kiểm tra biên cảnh cáo WarningCount &lt;= 5 vs 6 (R-07)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC025</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Recycler Verified ban đầu AverageRating = 3.5, TotalReviews = 3; sau đó giả lập kỳ PRO cũ Expired với TotalReviews = 0 và TotalReviews = 2, AverageRating = 4.6</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreatePayInOrderAsync(&quot;PRO&quot;) &amp; GetAvailablePackagesAsync qua 3 trạng thái</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Điểm &lt; 4.0 sao ném MSG-PAY-06; tái đăng ký với TotalReviews=0 trả IsReRegistration=true, IsPositiveFeedbackMet=false; đạt &gt;= 1 review &gt;= 4.0 sao cho phép tạo đơn PRO</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC025_ProEligibility_BlocksLowRating_AndRequiresPositiveReviewOnReRegistration] Điều kiện uy tín gói PRO (&gt;= 4.0★ &amp; review khi tái đăng ký)</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC026</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tài khoản Role = User (Citizen) Active</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetAvailablePackagesAsync(citizenId, UserRole.User)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chỉ trả [&quot;BASIC&quot;, &quot;PREMIUM&quot;], ẩn hoàn toàn gói &quot;PRO&quot; của Recycler</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC026_GetAvailablePackages_WhenCitizenUser_FiltersOutRecyclerProPackage] Lọc danh mục gói theo vai trò (U-16)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC027</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tài khoản có User.Role = Recycler &amp; RecyclerProfile Verified nhưng JWT claim cũ vẫn truyền UserRole.User</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetAvailablePackagesAsync(id, UserRole.User, &quot;Recycler&quot;) &amp; CreatePayInOrderAsync(id, UserRole.User, &quot;PRO&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hệ thống đối chiếu Role thực trong DB trả đủ [&quot;BASIC&quot;, &quot;PREMIUM&quot;, &quot;PRO&quot;] (PRO.IsEligible=true) và tạo đơn PRO (1,000,000đ) thành công</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">[UTC027_UpgradedRecyclerWithStaleUserJwtClaim_ResolvesDbRoleAndExposesEligibleProPackage] Giải quyết stale JWT claim sau duyệt KYB (R-07)</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="11_AI_Feedback_Dataset"><Table ss: