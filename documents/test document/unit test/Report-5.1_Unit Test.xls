    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử suy luận YOLO26 Two-Stage, ngưỡng OOD 0.60 (BR-AI-01), kiểm tra định dạng ảnh/file rỗng và ghi log phản hồi.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ModelManager FastAPI nạp 5 trọng số mô hình YOLO26/legacy.</Data></Cell>
   </Row>
