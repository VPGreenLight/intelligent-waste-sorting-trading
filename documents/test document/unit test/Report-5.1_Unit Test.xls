ss:MergeAcross="1"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Testing Round</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Failed</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Pending</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 1</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">32</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 2</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">32</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 3</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">32</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Testing Type</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Boundary</Data></Cell></Row><Row><Cell ss:StyleID="s50"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">20</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">7</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">5</Data></Cell></Row><Row ss:Index="11" ss:Height="28"><Cell ss:StyleID="s54"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Pre-conditions</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Input parameters</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Expected Results</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 1</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Test date</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Tester</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 2</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Round 3</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Defect IDs</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Note</Data></Cell></Row><Row><Cell ss:StyleID="s68" ss:MergeAcross="11"><Data ss:Type="String">ClassifyWasteImageAsync (AiVisionHttpClient)</Data></Cell></Row><Row ss:Height="120"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">AI Vision Service (localhost:8000) đang hoạt động, trả về HTTP 200 OK</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">imageStream=MemoryStream(valid_jpeg_bytes);&#10;fileName=&quot;plastic_bottle.jpg&quot;;&#10;model=&quot;yolo26_detect&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResultDto { Success = true, IsOutOfDistribution = false, TopPrediction.Label = &quot;plastic&quot;, TopPrediction.Confidence = 0.945 }&#10;Exception: N/A&#10;Log Message: &quot;Gửi ảnh phân tích tới AI Vision Service với Model 'yolo26_detect' tại: http://localhost:8000/api/v1/classify&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Luồng phân loại chuẩn qua HttpClient với mô hình mặc định YOLO26 Two-Stage yolo26_detect</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">AI Vision Service đang hoạt động, truyền model = &quot;yolo26n_cls&quot; (tương thích alias yolov8n)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">imageStream=MemoryStream(valid_png_bytes);&#10;fileName=&quot;cardboard_box.png&quot;;&#10;model=&quot;yolo26n_cls&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResultDto { Success = true, TopPrediction.Label = &quot;cardboard&quot; }&#10;Exception: N/A&#10;Log Message: &quot;Gửi ảnh phân tích tới AI Vision Service với Model 'yolo26n_cls' tại: http://localhost:8000/api/v1/classify&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Phân loại với mô hình YOLO26 Nano (yolo26n_cls, tương thích ngược alias yolov8n)</Data></Cell></Row><Row ss:Height="120"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">AI Vision Service trả về HTTP 400 BadRequest kèm nội dung lỗi</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">imageStream=MemoryStream(bytes);&#10;fileName=&quot;test.jpg&quot;;&#10;model=&quot;invalid_model&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResultDto { Success = false, IsOutOfDistribution = false, InferenceTimeMs = 0, ErrorMessage = &quot;Mô hình 'invalid_model' không tồn tại.&quot; }&#10;Exception: N/A&#10;Log Message: &quot;AI Service trả về mã lỗi: BadRequest, Body: Mô hình 'invalid_model' không tồn tại.&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Xử lý an toàn khi AI trả về HTTP != 2xx</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">AI Vision Service bị ngắt kết nối (HttpRequestException: Connection refused)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">imageStream=MemoryStream(valid_jpeg_bytes);&#10;fileName=&quot;bottle.jpg&quot;;&#10;model=&quot;yolo26_detect&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResultDto { Success = false, TopPrediction.Label = &quot;unknown&quot;, ErrorMessage = &quot;Lỗi kết nối tới AI Service: Connection refused&quot; }&#10;Exception: N/A&#10;Log Message: &quot;Lỗi kết nối tới AI Vision Service&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Fallback an toàn không làm sập Core Backend</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">AI Vision Service trả về HTTP 200 nhưng body JSON là &quot;null&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">imageStream=MemoryStream(valid_jpeg_bytes);&#10;fileName=&quot;empty_json.jpg&quot;;&#10;model=&quot;yolo26_detect&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResultDto { Success = false, ErrorMessage = &quot;Không thể giải mã phản hồi từ AI Service.&quot; }&#10;Exception: N/A&#10;Log Message: &quot;Gửi ảnh phân tích tới AI Vision Service với Model 'yolo26_detect' tại: http://localhost:8000/api/v1/classify&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra null-coalescing khi deserialize JSON</Data></Cell></Row><Row><Cell ss:StyleID="s69" ss:MergeAcross="11"><Data ss:Type="String">classify_waste_image &amp; submit_misclassification_feedback (Ecolink.AiService/app.py)</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC006</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Trọng số yolo26_detect, yolo26s_cls, yolo26n_cls, mobilenet_v3, efficientnet_b0 đã nạp vào ModelManager</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">file=UploadFile(&quot;bottle.jpg&quot;, &quot;image/jpeg&quot;);&#10;model=&quot;yolo26_detect&quot;;&#10;use_detection_crop=True;&#10;confidence_threshold=0.60</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResponse { success = True, is_out_of_distribution = False, top_prediction.label = &quot;plastic&quot;, sorting_rule != None } (Confidence = 0.945)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Suy luận YOLO26 Two-Stage (yolo26_detect + Crop Classify) &amp; gắn quy tắc tĩnh (U-01)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC007</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Mô hình trả về top_prediction.confidence = 0.60 (chạm đúng biên ngưỡng OOD)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">file=UploadFile(&quot;blurry_paper.jpg&quot;, &quot;image/jpeg&quot;);&#10;model=&quot;mobilenet_v3&quot;;&#10;confidence_threshold=0.60</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResponse { success = True, is_out_of_distribution = False, confidence_threshold = 0.60, sorting_rule != None }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giá trị biên confidence == 0.60 được tính là hợp lệ (BR-AI-01)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC008</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Mô hình trả về top_prediction.confidence = 0.599 (nhỏ hơn ngưỡng OOD 0.001)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">file=UploadFile(&quot;ood_shoe.jpg&quot;, &quot;image/jpeg&quot;);&#10;model=&quot;efficientnet_b0&quot;;&#10;confidence_threshold=0.60</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: AiScanResponse { success = True, is_out_of_distribution = True, sorting_rule = None }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kích hoạt cờ cảnh báo ngoại lai is_out_of_distribution = True (BR-AI-01)</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC009</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gửi tên model không có trong model_manager.registry</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">file=UploadFile(&quot;bottle.jpg&quot;, &quot;image/jpeg&quot;);&#10;model=&quot;resnet50_unknown&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: HTTPException (status_code=400)&#10;Log Message: &quot;Mô hình 'resnet50_unknown' không tồn tại hoặc chưa được hỗ trợ. Các mô hình khả dụng: ['yolo26_detect', 'yolo26s_cls', 'yolo26n_cls', 'efficientnet_b0', 'mobilenet_v3']&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn tên model sai</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC010</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gửi file không phải định dạng ảnh (content_type = &quot;application/pdf&quot;)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">file=UploadFile(&quot;document.pdf&quot;, &quot;application/pdf&quot;);&#10;model=&quot;yolo26_detect&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: HTTPException (status_code=400)&#10;Log Message: &quot;Tập tin tải lên phải là hình ảnh hợp lệ (jpg, png, webp).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra MIME type đầu vào</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC011</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gửi file ảnh có kích thước 0 byte (len(contents) == 0)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">file=UploadFile(&quot;empty.jpg&quot;, &quot;image/jpeg&quot;, b&quot;&quot;);&#10;model=&quot;yolo26_detect&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: HTTPException (status_code=400)&#10;Log Message: &quot;Tập tin hình ảnh tải lên không có dữ liệu (rỗng).&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Biên kích thước file = 0 byte</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC012</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">File data/feedback.json sẵn sàng ghi nhận báo cáo nhận diện sai (U-03)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">predicted_label=&quot;plastic&quot;;&#10;user_reported_label=&quot;glass&quot;;&#10;confidence_score=0.62;&#10;note=&quot;Chai thủy tinh trong suốt&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: { &quot;success&quot;: True, &quot;message&quot;: &quot;Ghi nhận phản hồi thành công!...&quot;, &quot;feedback&quot;: { &quot;status&quot;: &quot;pending_verification&quot; } }&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giang Nguyễn Đức</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">