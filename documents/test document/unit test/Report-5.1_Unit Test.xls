    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;4_Recycler_Pricing_Avail&apos;!A1"><Data ss:Type="String">4_Recycler_Pricing_Avail</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử lọc bảng giá thu mua, thêm mới đơn giá và chặn thêm trùng loại rác hoặc danh mục không thu mua (BR-MTH-03).</Data></Cell>
