    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;4_Recycler_Pricing_Avail&apos;!A1"><Data ss:Type="String">4_Recycler_Pricing_Avail</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử sửa giá, lưu đồng loạt nguyên tử (Atomic Rollback khi có dòng lỗi) và chặn tắt dòng giá active cuối cùng (BR-PRC-03).</Data></Cell>
