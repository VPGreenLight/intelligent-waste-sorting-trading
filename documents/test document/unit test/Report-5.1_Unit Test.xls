    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;3_Recycler_Onboarding&apos;!A1"><Data ss:Type="String">3_Recycler_Onboarding</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tải tệp lên Cloudflare R2 / Local fallback và kiểm tra giới hạn kích thước/định dạng.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mock S3Client / FileSystem local storage.</Data></Cell>
   </Row>
