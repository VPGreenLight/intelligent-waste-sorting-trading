    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;2_AI_Classification&apos;!A1"><Data ss:Type="String">2_AI_Classification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử tra cứu quy tắc 10 nhóm rác, chuẩn hóa mã và vô hiệu hóa cache quy tắc.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteRuleEngineService nạp sẵn 10 DefaultSeeds.</Data></Cell>
   </Row>
   <Row ss:Height="36">
