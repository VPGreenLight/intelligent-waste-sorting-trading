t;, StandardBinColor = &quot;Xanh Dương&quot; }&#10;Exception: N/A&#10;Log Message: &quot;Tìm thấy quy tắc phân loại cho loại rác: paper&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chuẩn hóa ToLowerInvariant().Trim()</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC015</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">_ruleCache không chứa mã &quot;battery_hazard&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">categoryCode=&quot;battery_hazard&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: N/A&#10;Log Message: &quot;Không tìm thấy quy tắc cấu hình cho loại rác: battery_hazard&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Trả về null khi không có quy tắc khớp</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC016</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">_ruleCache đang chứa đầy đủ 10 danh mục mặc định</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">(Không có tham số)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: IEnumerable&lt;WasteSortingGuideDto&gt; (Count = 10: battery, biological, cardboard, clothes, glass, metal, paper, plastic, shoes, trash)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Lấy toàn bộ 10 danh mục hướng dẫn chuẩn YOLO26</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC017</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">_ruleCache đang có khóa &quot;plastic&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">categoryCode=&quot;plastic&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: Task.CompletedTask (GetSortingGuideAsync(&quot;plastic&quot;) sau đó trả về null)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Xóa cache cục bộ của 1 danh mục</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC018</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">_ruleCache đã bị xóa 1 phần trước đó</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">categoryCode=null</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: Task.CompletedTask (_ruleCache được làm mới lại đủ 10 quy tắc mặc định)&#10;Exception: N/A&#10;Log Message: N/A</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-10-29</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Nguyen Thanh Luan</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khôi phục toàn bộ _ruleCache (10 danh mục)</Data></Cell></Row><Row><Cell ss:StyleID="s71" ss:MergeAcross="11"><Data ss:Type="String">GetMyScanHistoryAsync, WasteCategory CRUD &amp; Rule Engine Publish (v2.6.0)</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC019</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có bản ghi AiScanHistory của userA và userB trong InMemory DB</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">userId = userA, WasteScanHistoryFilterRequest()</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: TotalRecords = 1, chỉ chứa lịch sử của userA, SortingGuide được hydrate đúng (StandardBinColor = &quot;Cam&quot;) (BR-CLS-08)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cô lập lịch sử quét cá nhân</Data></Cell></Row><Row ss:Height="45"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC020</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có 3 bản ghi quét của cùng User ở các ngày và nhãn khác nhau</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CategoryCode = &quot;  PLASTIC &quot;, FromDate/ToDate trong khoảng 2 giờ</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: TotalRecords = 1, chỉ trả đúng bản ghi &quot;plastic&quot; nằm trong khung giờ lọc</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm thử bộ lọc lịch sử quét</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC021</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chưa có danh mục mã &quot;e_waste&quot; trong waste_categories</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreateWasteCategoryRequest { Code = &quot; E_Waste &quot;, Name = &quot;Pin &amp; Thiết bị điện tử&quot;, StandardBinColor = &quot;Đỏ&quot;, IsRecyclable = false }</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: Code = &quot;e_waste&quot;, Status = &quot;Active&quot;; ghi AuditLog &quot;CREATE_WASTE_CATEGORY&quot; (BR-SRT-02)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tạo danh mục mới chuẩn hóa mã</Data></Cell></Row><Row ss:Height="45"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC022</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đã tồn tại danh mục mã &quot;electronic&quot;</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">CreateWasteCategoryRequest { Code = &quot;Electronic&quot;, ... }</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Throw: ConflictException(&quot;BR-SRT-02&quot;, &quot;MSG-SRT-02&quot;)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn trùng mã danh mục</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC023</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Danh mục &quot;plastic&quot; tồn tại trong DB</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">UpdateWasteCategoryRequest { Name = &quot;Nhựa PET/HDPE Chuẩn&quot;, StandardBinColor = &quot;Vàng Cam&quot; }</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: Name/StandardBinColor cập nhật, giữ nguyên Code, gọi InvalidateRuleCacheAsync(&quot;plastic&quot;), ghi AuditLog</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Sửa metadata &amp; làm mới cache</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC024</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Danh mục &quot;plastic&quot; đang Active kèm quy tắc ACTIVE</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ToggleWasteCategoryStatusRequest { Status = &quot;Inactive&quot; }</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">DB giữ nguyên bản ghi ở Status = &quot;Inactive&quot; (BR-SRT-04); GetWasteCategoriesAsync() &amp; GetSortingGuideAsync(&quot;plastic&quot;) không trả về</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Xóa mềm danh mục bảo toàn FK</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC025</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Danh mục &quot;organic_compost&quot; đã tồn tại</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Gọi UpsertSortingRuleAsync lần 1 và lần 2 trên cùng categoryId</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tạo/cập nhật đè trên đúng 1 dòng SortingRule (1-1 BR-SRT-01) ở trạng thái DRAFT, ghi AuditLog</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Quản trị bản nháp Rule Engine</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC026</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Có quy tắc DRAFT cho &quot;tetrapak&quot; &amp; mock IAiVisionClient</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">PublishSortingRuleAsync(adminId, ruleId)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Rule.Status = &quot;ACTIVE&quot;, AiServiceSynced = true, gọi SyncSortingRuleAsync, GetSortingGuideAsync(&quot;tetrapak&quot;) khả dụng ngay (BR-SRT-03)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Phát hành &amp; đồng bộ AI Service</Data></Cell></Row><Row ss:Height="50"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC027</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ruleId không tồn tại hoặc nội dung PreparationSteps rỗng</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">PublishSortingRuleAsync</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Throw NotFoundException với ID lạ và BusinessRuleException(&quot;BR-SRT-03&quot;, &quot;MSG-SRT-03&quot;) khi thiếu nội dung</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Ràng buộc điều kiện phát hành</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC028</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khởi tạo 4 FluentValidators trong WasteCatalogValidators.cs</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Biên độ dài &amp; regex Code (^[a-z0-9_]+$, 50), Name (100), Status (Active/Inactive), Title (150), ApplicableRegion (100)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Từ chối đúng toàn bộ trường hợp sai regex/biên vượt, chấp nhận biên hợp lệ</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Boundary</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-20</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Kiểm tra biên Validator M-03</Data></Cell></Row><Row><Cell ss:StyleID="s72" ss:MergeAcross="11"><Data ss:Type="String">GetAllRuleDetailsAsync, PlatformPolicyService, YOLO26 Two-Stage &amp; 10 Categories (v2.7.0)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC029</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tạo danh mục &quot;pvc_pipe&quot; qua CreateWasteCategoryAsync (tự sinh SortingRule DRAFT) và thêm thẳng danh mục cũ &quot;used_oil&quot; vào DB chưa có SortingRule</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetAllRuleDetailsAsync(includeDraft: true) &amp; GetAllRuleDetailsAsync(includeDraft: false)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">includeDraft=true trả cả 2: pvcRule (RuleId != Empty, Status = &quot;DRAFT&quot;) và legacyRule (RuleId = Empty, Status = &quot;DRAFT&quot;, CategoryCode = &quot;used_oil&quot;); includeDraft=false loại bỏ cả 2</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hỗ trợ hiển thị cả danh mục cũ chưa có SortingRule trong Rule Engine</Data></Cell></Row><Row ss:Height="92"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC030</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">InMemory DB sạch với PlatformPolicyService &amp; AuditLogService (adminId)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">GetPublicPoliciesAsync(&quot;PRIVACY&quot;), CreatePolicyAsync(&quot;TERMS&quot;, ...), CreatePolicyAsync(Code=&quot;TERM-04&quot;) trùng mã, UpdatePolicyAsync(..., Status=&quot;DRAFT&quot;), ẩn/xóa mục ACTIVE cuối cùng, DeletePolicyAsync(DRAFT)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tự seed 5 mục mặc định; lọc PRIVACY trả &quot;PRIV-01&quot;; tạo mới tự sinh &quot;TERM-04&quot;; trùng mã ném ConflictException(&quot;BR-POL-02&quot;); ẩn/xóa mục ACTIVE cuối cùng ném BusinessRuleException(&quot;BR-POL-03&quot;); xóa DRAFT thành công &amp; ghi AuditLog CREATE/DELETE_PLATFORM_POLICY</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Quản trị CRUD chính sách nền tảng &amp; bảo vệ tối thiểu 1 mục ACTIVE</Data></Cell></Row><Row ss:Height="64"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC031</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Mock IAiVisionClient trả pipeline=&quot;yolo26_unified_two_stage&quot;, model_used=&quot;yolo26_detect&quot;; AiFeedbackService sẵn sàng</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">ClassifyWasteImageAsync(stream, &quot;pet.png&quot;) (model mặc định) &amp; RecordScanHistoryAsync(..., ModelUsed = null)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">res.Success = true, res.ModelUsed = &quot;yolo26_detect&quot;, HTTP body chứa &quot;yolo26_detect&quot;; bản ghi AiScanHistories lưu ModelUsed = &quot;yolo26_detect&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Khẳng định mô hình mặc định YOLO26 Two-Stage &amp; fallback lưu lịch sử quét</Data></Cell></Row><Row ss:Height="106"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC032</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">AiCategoryNormalizer, WasteRuleEngineService &amp; RecyclerManagementService trên InMemory DB</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">NormalizeCode(&quot;white-glass&quot;/&quot;green-glass&quot;/&quot;brown-glass&quot;/&quot;battery&quot;/&quot;biological&quot;/&quot;clothes&quot;/&quot;shoes&quot;), GetSortingGuideAsync(&quot;battery&quot;), GetWasteCategoriesAsync(), GetAllWasteCategoriesAsync(true, true)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">3 màu thủy tinh chuẩn hóa về &quot;glass&quot;, giữ nguyên 4 mã mới; &quot;battery&quot; có HazardWarning khác rỗng; GetWasteCategoriesAsync() chỉ trả 5 loại thu mua (plastic, paper, glass, metal, cardboard); GetAllWasteCategoriesAsync() trả đủ 10 danh mục gồm 5 loại không giao dịch (battery, biological, clothes, shoes, trash)</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-23</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Đồng bộ hợp đồng 10 danh mục YOLO26 &amp; tách 5 nhóm thu mua vs 5 nhóm không tái chế</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>44</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="3_Recycler_Onboarding"><Table ss:ExpandedColumnCount="12" ss:ExpandedRowCount="35" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="48" ss:DefaultRowHeight="12.75"><Column ss:Index="1" ss:StyleID="Default" ss:Width="85"/><Column ss:Index="2" ss:StyleID="Default" ss:Width="160"/><Column ss:StyleID="Default" ss:Width="200"/><Column ss:StyleID="Default" ss:Width="280"/><Column ss:StyleID="Default" ss:Width="75"/><Column ss:StyleID="Default" ss:Width="65"/><Column ss:StyleID="Default" ss:Width="80"/><Column ss:StyleID="Default" ss:Width="130"/><Column ss:StyleID="Default" ss:Width="65" ss:Span="1"/><Column ss:Index="11" ss:StyleID="Default" ss:Width="75"/><Column ss:StyleID="Default" ss:Width="160"/><Row ss:Index="2"><Cell ss:StyleID="s50"><Data ss:Type="String">Code Module</Data></Cell><Cell ss:StyleID="s73" ss:MergeAcross="2"><Data ss:Type="String">RecyclerOnboardingService &amp; CloudflareR2StorageService</Data></Cell></Row><Row><Cell ss:StyleID="s50"><Data ss:Type="String">Number of TCs</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">20</Data></Cell><Cell ss:StyleID="s74" ss:MergeAcross="1"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Testing Round</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Failed</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">Pending</Data></Cell></Row><Row><Cell ss:StyleID="s53"><Data ss:Type="String">Round 1</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">20</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="Number">0</Data></Cell></Row><Row><Cell ss:StyleID="s53"><D