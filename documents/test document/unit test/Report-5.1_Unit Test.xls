    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>

   <!-- Method 1: RegisterUserAsync -->
   <Row>
    <Cell ss:MergeAcross="11" ss:StyleID="MethodRow"><Data ss:Type="String">RegisterUserAsync</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">UTC001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DB ecolink_db đã kết nối; chưa có user "nguyenvana" hoặc email "vana@ecolink.vn"</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Username="nguyenvana"; Email="vana@ecolink.vn"; Password="Pass@123"; FullName="Nguyễn Văn A"; PhoneNumber="0901234567"</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Return: AuthResponseDto { Success = true, Role = "Citizen", Status = "Active" }&#10;Exception: N/A&#10;Log Message: "Người dùng Citizen mới đăng ký thành công: nguyenvana (vana@ecolink.vn)"</Data></Cell>
