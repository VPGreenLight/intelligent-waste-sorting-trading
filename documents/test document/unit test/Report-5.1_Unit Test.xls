n giao HND-20261104-0001 tới 22222222-...&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Normal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-04</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Tạo yêu cầu bàn giao thành công, sinh mã định danh và lưu chi tiết phế liệu (U-06)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">User đang đăng nhập bằng tài khoản Recycler &quot;collector&quot; (22222222-...)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">userId=&quot;22222222-...&quot;;&#10;RecyclerId=&quot;22222222-...&quot; (trùng UserId);&#10;Items=[{ WasteCategoryId=plasticId, EstimatedWeightKg=5.0 }]</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-HND-01&quot;, &quot;MSG-GEN-01&quot;)&#10;Log Message: &quot;Bạn không thể gửi yêu cầu bàn giao cho chính cơ sở của mình.&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-04</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Chặn người dùng tự gửi yêu cầu cho chính cơ sở của mình (BR-HND-01)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">User &quot;citizen&quot; hiện đang có 3 yêu cầu ở trạng thái hoạt động (Pending, Negotiating, Accepted)</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">userId=&quot;11111111-...&quot;;&#10;request=CreateHandoverRequest hợp lệ</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-HND-LIMIT&quot;, &quot;MSG-GEN-01&quot;)&#10;Log Message: &quot;Bạn chỉ có thể có tối đa 3 yêu cầu đang xử lý cùng lúc.&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">2026-11-04</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Hoàng Thắng Nguyễn</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">N/A</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Giới hạn tối đa 3 đơn active cùng lúc cho mỗi người dân (BR-HND-LIMIT)</Data></Cell></Row><Row ss:Height="78"><Cell ss:StyleID="s56"><Data ss:Type="String">UTC004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Cơ sở RecyclerId đang ở trạng thái VerificationStatus = Pending hoặc ActiveStatus = Offline</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">userId=&quot;11111111-...&quot;;&#10;RecyclerId=offlineRecyclerId;&#10;request=CreateHandoverRequest</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Return: null&#10;Exception: BusinessRuleException (&quot;BR-HND-01&quot;, &quot;MSG-GEN-01&quot;)&#10;Log Message: &quot;Cơ sở thu gom hiện không nhận yêu cầu bàn giao.&quot;</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Abnormal</Data></Cell><Cell ss:StyleID="s57"><Data ss:Type="String">Passed</Data></Cell><Cell ss: