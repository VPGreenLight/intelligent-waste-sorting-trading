    <Cell ss:StyleID="LinkCell" ss:HRef="#&apos;2_AI_Classification&apos;!A1"><Data ss:Type="String">2_AI_Classification</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kiểm thử phân trang lịch sử quét cá nhân, quản trị danh mục rác và phát hành quy tắc nháp sang ACTIVE.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">EF Core InMemory DB kèm tài khoản Citizen/Admin.</Data></Cell>
   </Row>
