 <!-- ==================== SHEET 2: Test Cases ==================== -->
 <Worksheet ss:Name="Test Cases">
  <Table>
   <Column ss:Width="55"/>
   <Column ss:Width="225"/>
   <Column ss:Width="130"/>
   <Column ss:Width="340"/>
   <Column ss:Width="235"/>
   <Column ss:Width="220"/>
   <Row ss:Height="28">
    <Cell ss:MergeAcross="5" ss:StyleID="TitleBanner"><Data ss:Type="String">TEST CASE LIST &amp; INTEGRATION TEST ENVIRONMENT SETUP</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="1" ss:StyleID="SummaryLabel"><Data ss:Type="String">Project Name</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Intelligent Waste Sorting and Trading Platform (EcoLink)</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="1" ss:StyleID="SummaryLabel"><Data ss:Type="String">Project Code</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">SEP490_G141</Data></Cell>
   </Row>
   <Row ss:Height="204">
    <Cell ss:MergeAcross="1" ss:StyleID="SummaryLabel"><Data ss:Type="String">Test Environment Setup Description</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">1. Server &amp; Canonical API Coverage (218 / 218 Canonical APIs):&#10;- Core Backend: ASP.NET Core 10.0 WebApi (Ecolink.WebApi, Clean Architecture, Dual Auth Bearer JWT + HttpOnly Cookies &amp; DB Role Sync, 202 Core Endpoints = 200 REST + 2 SignalR Hubs: /hubs/negotiation-chat &amp; /hubs/notifications).&#10;- Dedicated AI Vision Microservice: Python 3.11 FastAPI (YOLO26 Two-Stage yolo26_detect default + yolo26s_cls + yolo26n_cls along with legacy benchmarks efficientnet_b0, mobilenet_v3; 10 canonical waste categories &amp; 16 FastAPI endpoints /api/v1/*, /health, /, http://127.0.0.1:8000).&#10;2. Database &amp; Storage:&#10;- Relational &amp; Spatial DB: PostgreSQL 16 + PostGIS 3.4 (ecolink_db, SRID 4326 Geography Point).&#10;- Object Storage: Cloudflare R2 (S3-compatible API) / Local Fallback Storage.&#10;- In-Memory Cache: IMemoryCache / Redis 7.&#10;3. Web Browser &amp; Integration Test Runner:&#10;- Test Harness: .NET 10.0 xUnit Runner (src/Ecolink.Backend/EcoLink.ApiTests/EcoLink.ApiTests.csproj, 15 .cs files, 517 [Fact]/[Theory] methods, 707 discovered xUnit cases, HttpClient End-to-End Pipeline).&#10;- Client Browser: Google Chrome / Microsoft Edge v130+.</Data></Cell>
   </Row>
   <Row ss:Index="6" ss:Height="24">
    <Cell ss:MergeAcross="5" ss:StyleID="SectionHeader"><Data ss:Type="String">Integration Test Function List (67 Functions)</Data></Cell>
   </Row>
   <Row ss:Height="26">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Function Name</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Sheet Name</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-Condition</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Detailed Specification File</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 1.1: System Health &amp; Citizen Registration</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify /health endpoint and Citizen account registration (POST /api/v1/auth/register), initializing UserEcoProfile and blocking duplicate username/email (BR-AUTH-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PostgreSQL ecolink_db is ready; users table is migrated.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">01_integration_test_authentication.md</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 1.2: Recycler Direct Registration</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Direct Recycler account registration (POST /api/v1/auth/register-recycler), creating RecyclerProfile in Pending status with PostGIS coordinates.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No duplicate username/email exists in the DB.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">01_integration_test_authentication.md</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 1.3: User Login &amp; Brute-Force Lockout</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Dual Auth login (Bearer JWT + HttpOnly Cookies, X-EcoLink-No-Cookie), preventing User Enumeration (BR-AUTH-03), and locking account for 15 minutes after 5 failed attempts (BR-AUTH-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Seeded citizen, collector, staff, and admin accounts exist.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">01_integration_test_authentication.md</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 1.4: Current User Profile, Dual Auth &amp; Role Sync</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M01_Auth</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Authenticate JWT/Cookie/Query token via GET /api/v1/auth/me and synchronize the latest role directly from DB (UserAuthSnapshotLoader) after Recycler KYB approval.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">User is logged in with a valid JWT/Cookie.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">01_integration_test_authentication.md</Data></Cell>
