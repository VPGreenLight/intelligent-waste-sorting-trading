   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 3.1: Business License &amp; Facility Photo Upload (POST /api/v1/recycler-applications/upload-document)</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify successful upload of Business License (documentType=&quot;permit&quot;) and Facility Photo (documentType=&quot;facility-photo&quot;).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register and log in with a new Citizen account.&#10;2. Send POST /api/v1/recycler-applications/upload-document (multipart/form-data) with a PNG image and documentType=&quot;permit&quot;.&#10;3. Send another upload with documentType=&quot;facility-photo&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests return HTTP Status 200 OK, success = true.&#10;- data.fileUrl returns a valid public URL, data.documentType matches input.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">User is logged in with a valid JWT.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB01_UploadDocument_PermitAndFacilityPhoto_ReturnsValidAttachmentUrls</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking document upload when unauthenticated or when uploading empty file / invalid documentType.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/recycler-applications/upload-document without Bearer token.&#10;2. Send with token but documentType=&quot;invalid-type&quot; or missing file.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 401 Unauthorized.&#10;- Step 2: returns 400 Bad Request (MSG-MTH-06).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Upload Validation &amp; Auth Gate</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 3.2: Citizen Upgrade Application Submission (POST /api/v1/recycler-applications, GET /me)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking upgrade application submission without JWT token or when account is already a Verified Collector (BR-MTH-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/recycler-applications without token.&#10;2. Log in as collector (already a Verified Recycler) and send POST /api/v1/recycler-applications.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns HTTP Status 401 Unauthorized.&#10;- Step 2: returns HTTP Status 400 Bad Request with messageCode = &quot;MSG-MTH-06&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector account exists and is in Verified status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB02_SubmitApplication_WithoutTokenOrAlreadyVerifiedCollector_FailsAppropriately</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify invalid WGS84 geographic coordinate boundaries (latitude &gt; 90 or longitude &gt; 180) on application submission (BR-MTH-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Prepare submission payload with latitude = 95.5 (outside [-90, 90]) and send POST /api/v1/recycler-applications.&#10;2. Send request with longitude = 190.0 (outside [-180, 180]).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 400 Bad Request, messageCode = &quot;MSG-MTH-06&quot;.&#10;- No recycler_profiles record is created in DB.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">New Citizen account has not submitted an application.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB03_SubmitApplication_WithInvalidInput_Returns400WithMsgMth06</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking application submission when facilityName is blank or businessLicenseUrl is missing.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/recycler-applications with facilityName = &quot;&quot;.&#10;2. Send request with businessLicenseUrl = &quot;&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 400 Bad Request, messageCode = &quot;MSG-MTH-06&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">New Citizen account has not submitted an application.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB03_SubmitApplication_WithInvalidInput_Returns400WithMsgMth06</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify valid Citizen application submission succeeds (201 Created) and verification progress is retrievable via GET /api/v1/recycler-applications/me.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Before submitting, call GET /api/v1/recycler-applications/me.&#10;2. Send POST /api/v1/recycler-applications with complete facility details in Hoa Lac (21.0135, 105.5265).&#10;3. Call GET /api/v1/recycler-applications/me again.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 404 Not Found.&#10;- Step 2: returns 201 Created, messageCode = &quot;MSG-MTH-03&quot;, verificationStatus = &quot;Pending&quot;, persists Location = Point(105.5265, 21.0135) SRID 4326.&#10;- Step 3: returns 200 OK with verificationStatus = &quot;Pending&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid new Citizen account.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB04_SubmitApplication_ValidCitizen_CreatesPendingApplicationAndRetrievableViaGetMe</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking duplicate submission while the same Citizen&apos;s previous application is Pending (BR-MTH-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen submits valid application #1 (201 Created).&#10;2. While application is Pending, use the same token to send POST /api/v1/recycler-applications a second time.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Second submission is blocked with HTTP Status 400 Bad Request, messageCode = &quot;MSG-MTH-06&quot;.&#10;- Message: &quot;Your Recycler facility registration application is currently pending verification...&quot;</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen&apos;s first application is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB05_SubmitApplication_DuplicateWhenAlreadyPending_Returns400WithMsgMth06</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 3.3: Staff/Admin Application Queue &amp; Detail Inspection (GET /api/v1/recycler-applications, GET /{userId})</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify RBAC authorization: Block Citizen from accessing Staff/Admin verification queue and application details (S-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Use Citizen token to call GET /api/v1/recycler-applications.&#10;2. Use Citizen token to call GET /api/v1/recycler-applications/{userId}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests are blocked by [Authorize(Roles = &quot;Staff,Admin&quot;)] with HTTP Status 403 Forbidden.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">At least 1 Pending application exists in the system.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB06_StaffReview_ListAndDetail_EnforcesStaffOrAdminRole</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify Staff/Admin queries paginated application queue filtered by status (status=Pending) and views application detail.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Log in as admin (or staff).&#10;2. Send GET /api/v1/recycler-applications?status=Pending&amp;pageNumber=1&amp;pageSize=20.&#10;3. Send GET /api/v1/recycler-applications/{userId} to inspect document details.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns 200 OK, data.totalCount &gt;= 1, all items in data.items have verificationStatus = &quot;Pending&quot;.&#10;- Step 3: returns 200 OK with full facilityName, businessLicenseUrl, facilityPhotoUrl.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Pending application submitted in previous step exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB06_StaffReview_ListAndDetail_EnforcesStaffOrAdminRole</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 3.4: Application Verification, Rejection Resubmission &amp; Cross-Module Role/Price Upgrade (PUT /{userId}/verification)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking Staff/Admin from rejecting an application (isApproved = false) with an empty rejectionReason.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Use admin token to send PUT /api/v1/recycler-applications/{userId}/verification with {&quot;isApproved&quot;: false, &quot;rejectionReason&quot;: &quot;&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request, messageCode = &quot;MSG-MTH-06&quot;.&#10;- Application status in DB remains Pending.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">{userId} application is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB07_StaffReview_RejectRequiresReason_AndAllowsCitizenToResubmit</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify integration flow: Reject application with reason (MSG-MTH-05) -&gt; Citizen updates documents and successfully resubmits (Rejected -&gt; Pending).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Admin sends PUT /api/v1/recycler-applications/{userId}/verification with {&quot;isApproved&quot;: false, &quot;rejectionReason&quot;: &quot;Blurry business license photo&quot;}.&#10;2. Citizen updates businessLicenseUrl and resubmits POST /api/v1/recycler-applications.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 200 OK (MSG-MTH-05), verificationStatus = &quot;Rejected&quot;, persists rejectionReason.&#10;- Step 2: returns 201 Created (MSG-MTH-03), application returns to Pending and clears old rejectionReason.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">{userId} application is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB07_StaffReview_RejectRequiresReason_AndAllowsCitizenToResubmit</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-ONB-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-Module Integration (M3 -&gt; M1 -&gt; M4): Staff/Admin approves application (Verified) -&gt; Auto-upgrades User.Role to Recycler -&gt; Auto-seeds default price list.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Admin sends PUT /api/v1/recycler-applications/{userId}/verification with {&quot;isApproved&quot;: true, &quot;rejectionReason&quot;: null}.&#10;2. User logs in again via POST /api/v1/auth/login to get a new JWT.&#10;3. Use new JWT to call GET /api/v1/recycler/profile and GET /api/v1/recycler/prices (Module 4).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 200 OK (MSG-MTH-04), verificationStatus = &quot;Verified&quot;.&#10;- Step 2: data.user.role is upgraded to &quot;Recycler&quot;.&#10;- Step 3: Successfully accesses Recycler-only Module 4 APIs and retrieves auto-seeded default price list (prices.Count &gt; 0).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">{userId} application is in Pending status; waste_categories table has recyclable categories.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB08_StaffReview_ApproveApplication_UpgradesUserRoleToRecyclerAndSeedsDefaultPrices</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

