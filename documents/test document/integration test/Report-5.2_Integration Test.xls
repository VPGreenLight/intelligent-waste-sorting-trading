   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 8.1: Negotiation Thread Access Control (GET /api/v1/trade/orders/{orderId}/messages - BR-NEG-01)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that the order owner (Citizen) and assigned facility (Collector) can access the handover request&apos;s negotiation chat thread (GET /api/v1/trade/orders/{orderId}/messages).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a new handover request between citizen and collector.&#10;2. Send GET /api/v1/trade/orders/{orderId}/messages with the citizen token.&#10;3. Repeat with the collector token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests return HTTP Status 200 OK, messageCode = &quot;MSG-NEG-THREAD-OK&quot;.&#10;- data.orderId matches the newly created order and returns complete orderStatus, negotiationStatus, unreadCount, and messages.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Handover request {orderId} exists between citizen and collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG01_GetChatThread_ParticipantsAllowed_OutsiderBlockedWithBrNeg01</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that a third-party user not belonging to the handover request is blocked from accessing the chat thread (BR-NEG-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register a third Citizen account (outsider) unrelated to order {orderId}.&#10;2. Use the outsider token to send GET /api/v1/trade/orders/{orderId}/messages.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Blocked with HTTP Status 400/403, success = false, messageCode = &quot;MSG-AUTH-03&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} belongs to citizen and collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG01_GetChatThread_ParticipantsAllowed_OutsiderBlockedWithBrNeg01</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 8.2: Chat Attachment Upload &amp; Text/Image Messaging (POST /attachments, POST /messages)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify uploading an actual scrap photo to chat attachment storage (POST /api/v1/trade/orders/{orderId}/messages/attachments).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a 64x64 PNG image packaged in MultipartFormDataContent (file=&quot;anh-phe-lieu-chat.png&quot;).&#10;2. Send POST /api/v1/trade/orders/{orderId}/messages/attachments with the citizen token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-NEG-UPLOAD-OK&quot;.&#10;- data.fileUrl returns a valid image URL along with fileName and fileSizeBytes &gt; 0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is open; the sender is an order participant.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG02_SendMessage_TextAndUploadedAttachment_PersistsInThreadAndIncrementsUnread</Data></Cell>
   </Row>
   <Row ss:Height="148">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify sending a text message (Text) and an image message (Image) succeeds (201 Created) and increments unreadCount for the counterparty.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends POST /api/v1/trade/orders/{orderId}/messages with messageType = &quot;Text&quot; and messageContent = &quot;Hello facility, I have 12kg of PET plastic&quot;.&#10;2. Citizen sends a follow-up message with messageType = &quot;Image&quot; and the newly uploaded attachmentUrl.&#10;3. Collector calls GET /messages to inspect unreadCount.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Steps 1 &amp; 2: return 201 Created, messageCode = &quot;MSG-NEG-02&quot;.&#10;- Step 3: collector&apos;s data.unreadCount increases to &gt;= 2.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is open.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG02_SendMessage_TextAndUploadedAttachment_PersistsInThreadAndIncrementsUnread</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of sending a text message when content is blank or exceeds the 1000-character boundary (1005 characters).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /messages with messageType = &quot;Text&quot;, messageContent = &quot;   &quot;.&#10;2. Send another message with messageContent of length 1005 characters.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 400 Bad Request, success = false.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is open.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG03_SendMessage_InvalidPayload_Returns400BadRequest</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of sending an Image message when attachmentUrl is missing or an unsupported messageType (&quot;Audio&quot;) is provided.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /messages with messageType = &quot;Image&quot;, attachmentUrl = &quot;&quot;.&#10;2. Send another message with messageType = &quot;Audio&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases are blocked with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is open.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG03_SendMessage_InvalidPayload_Returns400BadRequest</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 8.3: Price/Time-Slot Proposal &amp; Counter-Proposal Superseding (POST /api/v1/trade/orders/{orderId}/proposals)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of submitting a Proposal when unit price &lt;= 0 or exceeds the 1,000,000 VND/kg cap (BR-NEG-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/trade/orders/{orderId}/proposals with proposedPricePerKg = 0, proposedWeightKg = 5.&#10;2. Resend with proposedPricePerKg = 1500000.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests are blocked with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is in a state that permits negotiation.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG04_SendProposal_InvalidPriceWeightOrPastTimeSlot_Returns400BadRequest</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of submitting a Proposal when weight &lt; 0.1kg (0.05kg) or proposedTimeSlot is in the past (BR-NEG-03, BR-NEG-05).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /proposals with proposedWeightKg = 0.05.&#10;2. Resend with proposedTimeSlot = UtcNow - 2h.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests are blocked with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is open.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG04_SendProposal_InvalidPriceWeightOrPastTimeSlot_Returns400BadRequest</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify counter-proposal superseding rule (BR-NEG-04): When Collector submits Counter-Proposal B, Citizen&apos;s pending Proposal A automatically transitions to Superseded.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends Proposal A (9000 VND/kg, 10kg) -&gt; 201 Created (MSG-NEG-01), proposalStatus = &quot;Pending&quot;.&#10;2. Collector sends Counter-Proposal B (8500 VND/kg, 10kg) -&gt; 201 Created.&#10;3. Call GET /messages to inspect the statuses of Proposal A, Proposal B, and activeProposal.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- On the chat thread: negotiationStatus = &quot;InNegotiation&quot;, activeProposal.id points to Proposal B (Pending), while Proposal A has transitioned to proposalStatus = &quot;Superseded&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is open between citizen and collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG05_SendProposal_AndCounterProposal_SupersedesPreviousActiveProposal_BrNeg04</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 8.4: Proposal Response, Order Terms Locking &amp; Read Receipts (POST /respond, POST /accept-terms, PUT /read)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking the sender from accepting or rejecting a Proposal they created themselves (BR-NEG-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends a Proposal (8500 VND/kg).&#10;2. Use the same citizen token to call POST /api/v1/trade/orders/{orderId}/proposals/{messageId}/respond with {&quot;isAccepted&quot;: true}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request, messageCode = &quot;BR-NEG-04&quot;.&#10;- The proposal remains in Pending status awaiting counterparty response.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The proposal created by citizen is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG06_RespondToProposal_SenderCannotRespondToOwnProposal_Returns400WithBrNeg04</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that when the counterparty rejects a Proposal (isAccepted = false), proposalStatus transitions to Rejected (MSG-NEG-REJECT-OK) and a new Proposal can be submitted.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends Proposal 1 (9500 VND/kg).&#10;2. Collector calls POST /proposals/{id}/respond with {&quot;isAccepted&quot;: false, &quot;responseNote&quot;: &quot;Price exceeds purchasing ceiling&quot;}.&#10;3. Citizen submits Proposal 2 (8200 VND/kg).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: 200 OK (MSG-NEG-REJECT-OK), proposalStatus = &quot;Rejected&quot;, negotiationStatus = &quot;InNegotiation&quot;.&#10;- Step 3: 201 Created, Proposal 2 becomes the new Pending proposal.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order {orderId} is under active negotiation.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG07_RespondToProposal_CounterpartyRejects_MarksProposalRejectedAndAllowsNewProposal</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-Module Integration (M8 -&gt; M6): Counterparty accepts a Proposal (isAccepted = true), locking AgreedPricePerKg, EstimatedTotalAmount, and ConfirmedTimeSlot into the Module 6 handover request (BR-NEG-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends a Proposal (8800 VND/kg, 12kg, slot proposedSlot).&#10;2. Collector calls POST /proposals/{id}/respond with {&quot;isAccepted&quot;: true, &quot;responseNote&quot;: &quot;Agreed at 8,800 VND/kg&quot;}.&#10;3. Call GET /api/v1/handover-requests/{orderId} (Module 6) to inspect the handover request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: 200 OK (MSG-NEG-03), proposalStatus = &quot;Accepted&quot;, negotiationStatus = &quot;Accepted&quot;, agreedPricePerKg = 8800, estimatedTotalAmount = 105600.&#10;- Step 3: The Module 6 handover request has transitioned to status = &quot;Accepted&quot; with the confirmed appointment slot.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The proposal is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG08_RespondToProposal_CounterpartyAccepts_LocksAgreedPriceAndTimeSlotIntoOrder_BrNeg06</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify locking out new Proposals once both parties have agreed on terms (negotiationStatus = Accepted - BR-NEG-02).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. On the order whose proposal was accepted in ITC-NEG-012 (negotiationStatus = &quot;Accepted&quot;), Citizen attempts to send a new POST /proposals request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Blocked with HTTP Status 400 Bad Request, messageCode = &quot;BR-NEG-02&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The order is in negotiationStatus = &quot;Accepted&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG08_RespondToProposal_CounterpartyAccepts_LocksAgreedPriceAndTimeSlotIntoOrder_BrNeg06</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Recycler directly accepts the initial order terms (POST /api/v1/trade/orders/{orderId}/accept-terms) without creating an intermediate Proposal.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a new handover request (Pending).&#10;2. Collector calls POST /api/v1/trade/orders/{orderId}/accept-terms.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-NEG-03&quot;.&#10;- negotiationStatus = &quot;Accepted&quot;, orderStatus = &quot;Accepted&quot;, agreedPricePerKg &gt; 0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A new handover request is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG09_AcceptOrderTerms_DirectAcceptByRecyclerWithoutProposal_LocksNegotiationStatusAccepted</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify marking all unread messages from the counterparty as read (PUT /api/v1/trade/orders/{orderId}/messages/read), resetting unreadCount to 0.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends 2 messages to Collector.&#10;2. Collector calls PUT /api/v1/trade/orders/{orderId}/messages/read.&#10;3. Collector calls GET /api/v1/trade/orders/{orderId}/messages again.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns 200 OK, messageCode = &quot;MSG-NEG-READ-OK&quot;, count of marked messages &gt;= 2.&#10;- Step 3: data.unreadCount = 0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Unread messages exist for collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG10_MarkMessagesAsRead_UpdatesUnreadCountToZeroForRecipient</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 8.5: Inquiry Draft Order Lifecycle, Thread List Enrichment &amp; 30-Day Slot Guard (POST/GET /api/v1/trade/orders)</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify creating an inquiry draft order (IsInquiryDraft = true -&gt; IsInquiryOnly = true), deduplicating open threads, and upgrading it into an official Pending handover request.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen sends POST /api/v1/trade/orders with isInquiryDraft = true to Collector.&#10;2. Submit a second inquiry request while the draft order is still open.&#10;3. Upgrade from the inquiry thread/draft to an official request (isInquiryDraft = false with pickup address &amp; time slot).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: creates an order with Status = &quot;Negotiating&quot;, IsInquiryOnly = true, and Note containing tag [INQUIRY].&#10;- Step 2: reuses/deduplicates the existing open order between the two parties.&#10;- Step 3: upgrades to an official Pending request (strips [INQUIRY] tag, IsInquiryOnly = false) without prematurely locking AgreedPricePerKg.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid Citizen and Collector accounts.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TradeController &amp; NegotiationChatUnitTests.UTC022/UTC024</Data></Cell>
   </Row>
   <Row ss:Height="148">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-NEG-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify thread listing GET /api/v1/trade/orders (automatically including inquiry-only threads isInquiryOnly = true and official handover orders) enriching lastMessagePreview, unreadCount, descending lastMessageAt sort, and enforcing the 30-day slot guard (BR-NEG-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create multiple threads (containing text messages, Image messages, Proposal messages, and System messages).&#10;2. Call GET /api/v1/trade/orders with a participant&apos;s token.&#10;3. Attempt to submit a proposal with proposedTimeSlot &gt; UtcNow + 30 days.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns 200 OK; each item has plain-text lastMessagePreview (&quot;Sent scrap photo&quot;, &quot;Proposal: ... VND/kg - ... kg&quot;, or text truncated to max 90 characters), unreadCount excludes own messages and SenderRole == &quot;System&quot;, sorted descending by lastMessageAt.&#10;- Step 3: blocked with 400 Bad Request (BR-NEG-04, HandoverTradeSyncHelper.ValidateAppointmentWindowUtc, max 30 days).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Threads contain diverse message types and unread messages.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TradeController.GetOrders, HandoverTradeSyncHelper.ValidateAppointmentWindowUtc &amp; NegotiationChatUnitTests.UTC025..027</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 12: M15_Governance ==================== -->
 <Worksheet ss:Name="M15_Governance">
  <Table>
   <Column ss:Width="95"/>
   <Column ss:Width="210"/>
   <Column ss:Width="255"/>
   <Column ss:Width="275"/>
   <Column ss:Width="175"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="75"/>
   <Column ss:Width="195"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Account, Staff &amp; System Governance / Analytics (M15_Governance)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">HTTP End-to-End integration testing for 28 REST APIs (STT 173-194, STT 196-201: including PlatformPoliciesController) &amp; SignalR Hub /hubs/notifications (STT 195) under Module M-15: Admin role enforcement &amp; fine-grained [HasPermission(&quot;MANAGE_ACCOUNTS&quot;)] authorization (BR-ADM-02), executive KPI &amp; chart aggregation from Completed transactions (BR-ADM-07), PII-anonymized CSV/XLSX report exports (BR-ADM-06), immutable audit_logs trail (BR-ADM-05), account lock/soft-deactivation (BR-ADM-03, BR-ADM-04), zero-permission Staff provisioning (BR-ADM-01), UTC+7 shift attendance check-in/out (BR-GAM-08, BR-GAM-09), System Notifications inbox (SU-04), and Platform Terms &amp; Policies governance (PlatformPoliciesController, BR-POL-03) (EcoLink.ApiTests/GovernanceTests.cs &amp; NotificationTests.cs).</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">24</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
