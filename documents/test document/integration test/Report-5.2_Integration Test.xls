    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 7.2: Receipt Preview &amp; Deviation Warning</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M07_Receipt</Data></Cell>
