   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 9.1: Executive Dashboard KPIs, Charts, Anonymized Exports &amp; Audit Trail (A-01, A-02 - STT 173-176)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify top-level Admin role enforcement on executive KPI and internal staff endpoints (blocking Guest, Citizen, and Staff).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/admin/analytics/kpi-summary without a token.&#10;2. Repeat using a Citizen token and a Staff token.&#10;3. Send GET /api/v1/admin/staff using Citizen and Staff tokens.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Without token: HTTP 401 Unauthorized.&#10;- Citizen &amp; Staff tokens: HTTP 403 Forbidden across all Admin-only endpoints.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">citizen, staff, and admin accounts are seeded.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV01</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Admin retrieves executive KPI summaries via GET /api/v1/admin/analytics/kpi-summary across periods 7d, 30d, and all.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/admin/analytics/kpi-summary with period = &quot;7d&quot;, &quot;30d&quot;, and &quot;all&quot; using the admin token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP 200 OK, success = true.&#10;- Returns complete activeCitizensCount, verifiedRecyclersCount, completedHandoversCount, totalRecycledWeightKg, vietQrServiceRevenueVnd, aiBenchmark, and operationalBacklog.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV02</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify querying analytics chart datasets via GET /api/v1/admin/analytics/charts?months=6.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/admin/analytics/charts?months=6 using the admin token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP 200 OK.&#10;- monthlyHandoverTrend is a JSON array with exactly 6 elements; wasteCategoryBreakdown and aiQualityByGroup are valid JSON arrays.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV03</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify exporting a CSV report (dataset=accounts&amp;format=csv) with PII masking (BR-ADM-06) and automatic EXPORT_REPORT audit logging (BR-ADM-05).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/admin/reports/export?dataset=accounts&amp;format=csv.&#10;2. Inspect the returned CSV content.&#10;3. Call GET /api/v1/admin/audit-logs?action=EXPORT_REPORT.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP 200 OK; CSV content contains masked email pattern (***@).&#10;- The audit_logs table records an entry with Action = &quot;EXPORT_REPORT&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Account data exists and logged in with Admin token.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV04</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify exporting a valid OpenXML Excel .xlsx report (dataset=handovers&amp;format=xlsx) and rejecting unsupported pdf format.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/admin/reports/export?dataset=handovers&amp;format=xlsx.&#10;2. Call again with format=pdf.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: HTTP 200 OK; binary payload starts with ZIP signature &quot;PK&quot; and contains &quot;sheet1.xml&quot;.&#10;- Step 2: HTTP 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV05</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify action, entityType filtering and pagination on GET /api/v1/admin/audit-logs.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Trigger 1 report export.&#10;2. Call GET /api/v1/admin/audit-logs?action=EXPORT_REPORT&amp;entityType=SystemReport&amp;pageNumber=1&amp;pageSize=10.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP 200 OK.&#10;- The items list is non-empty and every returned entry has action = &quot;EXPORT_REPORT&quot; and entityType = &quot;SystemReport&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">At least 1 EXPORT_REPORT log entry exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV06</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 9.2: Citizen &amp; Recycler Account Governance, Instant Lock &amp; Soft-Deactivation (S-06, S-07 - STT 177-180)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify listing and inspecting external accounts (GET /staff/accounts, GET /staff/accounts/{id}) and 404 handling.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register a disposable Citizen account.&#10;2. Call GET /api/v1/staff/accounts?role=User&amp;keyword={username}.&#10;3. Call GET /api/v1/staff/accounts/{userId} and also test with Guid.NewGuid().</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Steps 2 &amp; 3 (valid ID): HTTP 200 OK, containing activityStats and moderationHistory.&#10;- Non-existent ID: HTTP 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in with MANAGE_ACCOUNTS permission or Admin role.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV07</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejecting account lock operations when reason is blank or shorter than 10 characters (BR-ADM-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register a disposable Citizen account.&#10;2. Send PATCH /api/v1/staff/accounts/{userId}/lock with reason = &quot;&quot; and reason = &quot;Too short&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests are rejected with HTTP 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The new Citizen account is Active.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV08</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Account Lock (Suspended) immediately revokes an unexpired JWT via AccountStatusGuardMiddleware (MSG-AUTH-04) and Unlock restores access.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen registers to obtain citizenToken and calls GET /api/v1/auth/me (200).&#10;2. Admin calls PATCH /lock (isLocked = true, reason &gt;= 10 chars).&#10;3. Use citizenToken to call /auth/me again.&#10;4. Call PATCH /lock (isLocked = false) and re-verify /auth/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: HTTP 200 OK (MSG-ADM-03, status = &quot;Suspended&quot;, warningCount &gt;= 1).&#10;- Step 3: HTTP 403 Forbidden (MSG-AUTH-04).&#10;- Step 4: 200 OK (Active), citizenToken resumes working normally.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A disposable Active Citizen account exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV09</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify soft deactivation (DELETE /api/v1/staff/accounts/{userId}) transitions status to Deactivated, blocks active sessions, while preserving the record (BR-ADM-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register a disposable Citizen.&#10;2. Send DELETE /api/v1/staff/accounts/{userId} with reason &gt;= 10 characters.&#10;3. Check GET /api/v1/auth/me and GET /api/v1/staff/accounts/{userId}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: HTTP 200 OK (MSG-ADM-03, status = &quot;Deactivated&quot;).&#10;- Step 3: Citizen JWT is blocked with 403, while GET /staff/accounts/{userId} still retrieves the profile (200 OK).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A disposable Active Citizen account exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV10</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 9.3: Staff Provisioning, Status Guard &amp; Instant RBAC Matrix (A-03, A-04 - STT 181-187)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Admin creates a new staff member (POST /api/v1/admin/staff) initialized with 0 default permissions (BR-ADM-01) and retrieves it via GET /staff.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call POST /api/v1/admin/staff (without passing initialPermissions).&#10;2. Call GET /api/v1/admin/staff?keyword={staffCode}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: HTTP 201 Created, staffCode formatted as &quot;NV-...&quot;, permissions.Length = 0.&#10;- Step 2: HTTP 200 OK, returning the newly created staff profile.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV11</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify updating a staff profile &amp; issuing a temporary password reset (PUT /api/v1/admin/staff/{staffId}) allows the staff member to log in with the new password.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a new staff account.&#10;2. Call PUT /api/v1/admin/staff/{staffId} updating fullName, department, and resetTemporaryPassword = &quot;NewPass@2026!&quot;.&#10;3. Call POST /api/v1/auth/login with the new password.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: HTTP 200 OK, profile updated.&#10;- Step 3: HTTP 200 OK, valid JWT access token issued.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A disposable staff account has been created.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV12</Data></Cell>
   </Row>
   <Row ss:Height="176">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify the full granular RBAC permission lifecycle (GET /permissions/catalog, GET/PUT /permissions): granting/revoking permissions evicts IMemoryCache immediately (BR-ADM-02, MSG-ADM-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/admin/permissions/catalog.&#10;2. Create a new Staff (0 permissions) and log in to obtain staffToken -&gt; call GET /api/v1/staff/accounts.&#10;3. Admin calls PUT /staff/{id}/permissions granting &quot;account.manage&quot; + &quot;REVIEW_AI&quot; -&gt; staffToken re-calls /staff/accounts.&#10;4. Admin revokes permissions back to [] -&gt; staffToken re-calls /staff/accounts.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: Returns all 7 standard permission codes.&#10;- Step 2: 403 Forbidden (MSG-ADM-04).&#10;- Step 3: 200 OK (MSG-ADM-01), and staffToken immediately succeeds with 200 OK.&#10;- Step 4: The exact same staffToken is immediately blocked with 403.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin and a new Staff account is provisioned.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV13</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking Admin from self-suspending and locking/unlocking staff via PATCH /api/v1/admin/staff/{staffId}/status (BR-ADM-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Admin calls PATCH /admin/staff/{adminId}/status with status = &quot;Suspended&quot;.&#10;2. Admin suspends a disposable Staff (&quot;Suspended&quot;) then reactivates (&quot;Active&quot;), verifying via GET /auth/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Self-lock attempt: 403 Forbidden.&#10;- Staff suspension: 200 OK (MSG-ADM-03), Staff JWT blocked with 403; reactivating to &quot;Active&quot; -&gt; 200 OK.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Admin and disposable Staff accounts exist.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV14</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 9.4: Staff Daily Shift Check-in, Check-out &amp; Attendance Oversight (S-11 - STT 188-191)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify shift check-in (POST /check-in), complete isolation from the CurrentGreenPoints wallet (BR-GAM-08), and duplicate same-day check-in prevention (BR-GAM-09).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Use the newly created staffToken to call POST /api/v1/staff/attendance/check-in.&#10;2. Check GET /api/v1/auth/me and GET /api/v1/staff/attendance/me.&#10;3. Call POST /check-in a second time on the same day.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 201 Created, checkedInToday = true, pointsEarnedToday = 10, currentStreakDay = 1.&#10;- Step 2: currentGreenPoints = 0, checkedInToday = true.&#10;- Step 3: 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Newly created Staff has not checked in today.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV15</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify shift check-out (POST /check-out) and team-wide attendance oversight query (GET /admin/staff/attendance).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Newly created Staff calls POST /check-in (201).&#10;2. Call POST /api/v1/staff/attendance/check-out with shiftNote.&#10;3. Admin calls GET /api/v1/admin/staff/attendance?staffId={staffId}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: 200 OK, checkedOutToday = true, todayShiftNote is saved.&#10;- Step 3: 200 OK, returns the exact shift record with staffCode and shiftNote.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">New Staff has completed Check-in for the day.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GovernanceTests.GOV16</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 9.5: System Notifications REST APIs (STT 192-194, SU-04)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block anonymous access to the system notifications inbox (GET /api/v1/notifications).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/notifications without a JWT token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 401 Unauthorized.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system is running.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NotificationTests.NTF01_GetNotifications_Unauthenticated_Returns401</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-018</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Authenticated user retrieves the notifications list along with the unread counter (unreadCount).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Log in as Citizen.&#10;2. Send GET /api/v1/notifications.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 200 OK, messageCode = &quot;MSG-NTF-LIST-OK&quot;, data.items is an array, data.unreadCount &gt;= 0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid Citizen account.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NotificationTests.NTF02_GetNotifications_CitizenToken_ReturnsPagedEnvelopeWithUnreadCount</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-019</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Marking a non-existent notificationId as read returns 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PATCH /api/v1/notifications/{randomGuid}/read using a Citizen token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid Citizen account.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NotificationTests.NTF03_MarkNotificationRead_NonExistentId_Returns404</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-020</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mark all notifications for an account as read (PUT /api/v1/notifications/read-all).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/notifications/read-all using an Admin token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 200 OK, messageCode = &quot;MSG-NTF-READ-ALL-OK&quot;, data.unreadCount == 0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid Admin account.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NotificationTests.NTF04_MarkAllNotificationsRead_Authenticated_Returns200AndZeroUnread</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 9.6: Platform Policies &amp; Legal Terms Governance (PlatformPoliciesController - STT 196-201)</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-021</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify public access to ACTIVE policy terms (GET /api/v1/policies) and admin management listing across all statuses (GET /api/v1/admin/policies).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Unauthenticated Guest calls GET /api/v1/policies and GET /api/v1/policies?category=TERMS.&#10;2. Citizen calls GET /api/v1/admin/policies (403).&#10;3. Admin &amp; Staff call GET /api/v1/admin/policies?category=...&amp;status=...&amp;search=....</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 200 OK (MSG-POL-LIST-OK), returning only entries with Status = &quot;ACTIVE&quot;.&#10;- Step 2: Citizen is blocked with 403 Forbidden.&#10;- Step 3: Admin and Staff receive 200 OK including ACTIVE, DRAFT, and INACTIVE entries matching the filters.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system has at least 1 default ACTIVE policy entry.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PlatformPoliciesController.GetPublicPolicies &amp; GetAdminPolicies</Data></Cell>
   </Row>
   <Row ss:Height="162">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-022</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Admin creates (POST /api/v1/admin/policies) &amp; updates (PUT /api/v1/admin/policies/{id}) platform policies, blocks duplicate Code (409 MSG-POL-02), and blocks Staff/Citizen (403).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff/Citizen attempts POST /api/v1/admin/policies (403).&#10;2. Admin calls POST /api/v1/admin/policies to create a new entry (code, category, title, content, displayOrder, status).&#10;3. Resend POST with the same code (409).&#10;4. Admin calls PUT /api/v1/admin/policies/{id} to update title/content and inspects /admin/audit-logs.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 403 Forbidden.&#10;- Step 2: 201 Created (MSG-POL-CREATED), returning PlatformPolicySectionDto.&#10;- Step 3: 409 Conflict (MSG-POL-02).&#10;- Step 4: 200 OK (MSG-POL-UPDATED), persisting updatedByAdminId &amp; recording an AuditLog.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin, Staff, and Citizen.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PlatformPoliciesController.CreatePolicy &amp; UpdatePolicy</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-023</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Admin toggles policy status (PATCH /api/v1/admin/policies/{id}/status) between DRAFT/ACTIVE/INACTIVE and reflects on /policies.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a policy in DRAFT status -&gt; verify it is not visible on GET /api/v1/policies.&#10;2. Call PATCH /api/v1/admin/policies/{id}/status setting &quot;ACTIVE&quot;, then re-check GET /api/v1/policies.&#10;3. Set it back to &quot;INACTIVE&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: 200 OK (MSG-POL-STATUS-UPDATED, status = &quot;ACTIVE&quot;), and the entry appears on the public /api/v1/policies endpoint.&#10;- Step 3: 200 OK (status = &quot;INACTIVE&quot;), and the entry is hidden from the public endpoint.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A test policy exists and at least 1 other ACTIVE entry remains.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PlatformPoliciesController.SetPolicyStatus</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-GOV-024</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Admin deletes a policy entry (DELETE /api/v1/admin/policies/{id}) and enforces protection of the last remaining ACTIVE policy (BR-POL-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a temporary DRAFT entry and call DELETE /api/v1/admin/policies/{id} (200).&#10;2. When only 1 ACTIVE entry remains in the system, call PATCH .../status (INACTIVE/DRAFT) or DELETE on that last ACTIVE entry.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 200 OK (MSG-POL-DELETED), removed from the list.&#10;- Step 2: Blocked with HTTP 400 Bad Request (BR-POL-03) to ensure /terms always has at least 1 active policy.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PlatformPoliciesController.DeletePolicy &amp; PlatformPolicyService (BR-POL-03)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

