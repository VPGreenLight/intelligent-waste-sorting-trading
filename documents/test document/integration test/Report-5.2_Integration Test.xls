   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 4.1: RBAC Authorization &amp; Facility Profile Management (GET /api/v1/recycler/profile, PUT /profile)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify RBAC security gate across all 9 /api/v1/recycler/* endpoints: block unauthenticated guests (401) and Citizen accounts (403).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sequentially send unauthenticated requests to GET/PUT /profile, GET/POST/PUT /prices, GET/PATCH /availability, PUT /schedule.&#10;2. Repeat all requests with a Citizen Bearer token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Without token: all return HTTP Status 401 Unauthorized.&#10;- Citizen token: all return HTTP Status 403 Forbidden.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.RecyclerEndpoint_WithoutToken_Returns401 &amp; WithCitizenToken_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify viewing facility profile (GET /api/v1/recycler/profile) for verified collector account and newly registered Pending account.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recycler/profile with collector token.&#10;2. Send GET /api/v1/recycler/profile with newly registered Pending Recycler token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- For collector: returns 200 OK, verificationStatus = &quot;Verified&quot;, with complete latitude, longitude, facilityName.&#10;- For new Recycler: returns 200 OK, verificationStatus = &quot;Pending&quot;, activeStatus = &quot;Offline&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector and Pending accounts exist in DB.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Profile_Get_AsVerifiedCollector_ReturnsExpectedShape</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify valid facility profile update (PUT /api/v1/recycler/profile) persists to PostgreSQL and updates PostGIS Point(lng, lat) coordinates.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/profile with facilityName, representativeName, businessAddress, latitude = 21.0150, longitude = 105.5280, contactPhone, taxCode.&#10;2. Re-fetch GET /api/v1/recycler/profile to verify.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, success = true.&#10;- Data read back from GET /profile matches updated fields 100%.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Profile_Update_WithValidData_PersistsChanges</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify field length limits and extreme geographic coordinate boundaries (lat = +-90, lng = +-180) when updating facility profile.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/profile with facilityName 200 chars, businessAddress 500 chars, taxCode 13 chars.&#10;2. Send updates with latitude = 90, longitude = 180 and latitude = -90, longitude = -180.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All valid boundary requests return HTTP Status 200 OK.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Profile_Update_AtExactMaxLengths_Succeeds &amp; AtExtremeCoordinates_Succeeds</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejecting invalid profile updates (17 scenarios) and ensuring existing DB data is not overwritten.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Read current collector profile.&#10;2. Send PUT /api/v1/recycler/profile with invalid inputs: latitude = 90.001, longitude = -180.001, contactPhone containing letters, taxCode 14 chars, or missing required fields.&#10;3. Re-read profile from GET /profile.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns HTTP Status 400 Bad Request.&#10;- Step 3: DB profile data remains 100% identical to step 1 (no partial write).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Profile_Update_WithInvalidData_Returns400_AndDoesNotModifyData</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 4.2: Single Waste Category Price Configuration (GET /api/v1/recycler/prices, POST /prices, PUT /prices/{id})</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify viewing facility price list (GET /api/v1/recycler/prices) and filtering for active purchasable categories only (onlyActive=true).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Restore baseline price list (EnsureBaselineAsync).&#10;2. Pause 1 waste category (glass).&#10;3. Call GET /api/v1/recycler/prices and GET /api/v1/recycler/prices?onlyActive=true.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- GET /prices: returns both isActive = true and isActive = false rows.&#10;- GET /prices?onlyActive=true: returns only rows where isActive = true.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility has a configured price list.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Get_OnlyActiveTrue_ExcludesPausedCategories</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify adding a new purchase price for a waste category not yet in the facility&apos;s price list (POST /api/v1/recycler/prices).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Ensure cardboard is not yet in the facility&apos;s price list.&#10;2. Send POST /api/v1/recycler/prices with cardboard wasteCategoryId, pricePerKg = 4200, minQuantityKg = 3, collectionConditions = &quot;Dry, neatly bundled&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 201 Created, messageCode = &quot;MSG-PRC-01&quot;.&#10;- New record has isActive = true, isOutdated = false, and appears in GET /prices.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">cardboard does not exist in the facility&apos;s price list.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Create_ForUnusedCategory_Returns201_AndPersists</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify boundary values for unit price (pricePerKg from 0.01 to 1,000,000 VND/kg) and minimum quantity (minQuantityKg from 0.1 to 10,000 kg).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/prices/{priceId} with pricePerKg = 0.01, minQuantityKg = 0.1 (lower bound).&#10;2. Send update with pricePerKg = 1000000, minQuantityKg = 10000 (upper bound).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both boundary requests return HTTP Status 200 OK and persist exact decimal values in PostgreSQL.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Price row {priceId} exists and belongs to collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Update_AtExactMinAndMaxBoundaries_Succeeds</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking price creation when category already exists in price list or wasteCategoryId does not exist.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/recycler/prices for plastic (already present in price list).&#10;2. Send request with wasteCategoryId = Guid.NewGuid().</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 400 Bad Request (blocks duplicate category per facility).&#10;- Step 2: returns 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">plastic is already present in collector&apos;s price list.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Create_DuplicateCategory_Returns400 &amp; UnknownCategory_Returns404</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking price creation/update when pricePerKg &lt;= 0, pricePerKg &gt; 1,000,000, minQuantityKg &lt; 0.1, or collectionConditions &gt; 300 chars (BR-PRC-01, BR-PRC-02).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/prices/{priceId} with 7 out-of-bounds variants: price = 0, price = -100, price = 1000000.01, minQty = 0, minQty = 0.09, minQty = 10000.01, conditions 301 chars.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All 7 variants are blocked with HTTP Status 400 Bad Request.&#10;- Existing unit price in DB remains untouched.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Price row {priceId} exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Update_WithInvalidValues_Returns400_AndKeepsOldValue</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking Recycler A from modifying a price row owned by Recycler B (IDOR Protection).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Obtain collector&apos;s priceId.&#10;2. Use another PendingRecycler token to send PUT /api/v1/recycler/prices/{priceId}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 404 Not Found (or 403); collector&apos;s price row is unchanged.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">2 independent Recycler accounts exist.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Update_OtherRecyclersPriceRow_Returns404</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rule requiring at least 1 active purchasable category (BR-PRC-03 / MSG-PRC-02) when disabling the last active price row.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Pause other waste categories, leaving only plastic with isActive = true.&#10;2. Send PUT /api/v1/recycler/prices/{plasticPriceId} with isActive = false.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request, messageCode = &quot;MSG-PRC-02&quot;.&#10;- plastic price row remains isActive = true in DB.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Facility has only 1 remaining Active price row (plastic).</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Update_DeactivatingLastActiveCategory_Returns400WithMSGPRC02</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 4.3: Atomic Bulk Price Save (PUT /api/v1/recycler/prices)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify bulk price save (PUT /api/v1/recycler/prices) updates existing rows, inserts new rows, and pauses disabled rows in a single transaction.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/prices with items list containing: update plastic = 9500, metal = 17500, pause paper (isActive = false), and insert cardboard (isActive = true, pricePerKg = 4100).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-PRC-01&quot;.&#10;- All changes apply accurately in a single API call.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_BulkSave_UpdatesExistingAndInsertsNewAndPausesDisabled</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking bulk price save when all items set isActive = false (BR-PRC-03 / MSG-PRC-02).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Prepare items list where every element has isActive = false.&#10;2. Send PUT /api/v1/recycler/prices.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request, messageCode = &quot;MSG-PRC-02&quot;.&#10;- Previous price list retains isActive = true state.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Facility currently has a valid active price list.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_BulkSave_AllInactive_Returns400WithMSGPRC02_AndKeepsPreviousState</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify Atomicity / Rollback of PUT /api/v1/recycler/prices: if the 2nd item fails, the valid 1st item is not saved.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Record current plastic price (8000).&#10;2. Send PUT /api/v1/recycler/prices with 2 items: item 1 updates plastic = 12345 (valid), item 2 sets metal = -5 (invalid).&#10;3. Re-read price list via GET /prices.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns 400 Bad Request.&#10;- Step 3: plastic price remains 8000 (transaction completely rolled back).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_BulkSave_IsAtomic_WhenSecondItemInvalid_FirstItemIsNotSaved</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking PUT /api/v1/recycler/prices when items list is empty, contains duplicate wasteCategoryId in the same request, or references a nonexistent category.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/prices with items = [].&#10;2. Send with 2 items sharing plastic&apos;s wasteCategoryId.&#10;3. Send with wasteCategoryId = Guid.NewGuid().</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Steps 1 &amp; 2: return 400 Bad Request.&#10;- Step 3: returns 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as collector.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_BulkSave_DuplicateCategoriesInRequest_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 4.4: Real-Time Online/Offline Availability Toggle (GET &amp; PATCH /api/v1/recycler/availability)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify viewing availability status (GET /api/v1/recycler/availability) returns canAcceptNewOrders, activeCategoryCount, and weeklySchedule.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Ensure collector is Online and has 4 active waste categories.&#10;2. Send GET /api/v1/recycler/availability.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- verificationStatus = &quot;Verified&quot;, activeStatus = &quot;Online&quot;, isOnline = true, canAcceptNewOrders = true, activeCategoryCount &gt;= 4, weeklySchedule contains 7 days.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is in baseline state.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Availability_Get_ReturnsExpectedShape</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-018</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify switching to Offline with unavailableReason and toggling back to Online automatically clears unavailableReason.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PATCH /api/v1/recycler/availability with {&quot;isOnline&quot;: false, &quot;unavailableReason&quot;: &quot;Warehouse full, temporarily closed this afternoon&quot;}.&#10;2. Send PATCH /api/v1/recycler/availability with {&quot;isOnline&quot;: true}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 200 OK, isOnline = false, canAcceptNewOrders = false, unavailableReason is persisted.&#10;- Step 2: 200 OK, isOnline = true, canAcceptNewOrders = true, unavailableReason = null.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is verified and has active price list.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Availability_Update_GoOfflineWithReason_ThenBackOnline_ClearsReason</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-019</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking Online toggle when unavailableReason exceeds 200 chars or when facility is Pending verification (BR-MTH-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PATCH /api/v1/recycler/availability with 201-char unavailableReason.&#10;2. Use PendingRecycler token to send PATCH /api/v1/recycler/availability with {&quot;isOnline&quot;: true}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 400 Bad Request.&#10;- Step 2: returns 400 Bad Request (blocks unverified facility from appearing Online on map).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">PendingRecycler account exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.PendingRecycler_Availability_GoOnline_IsBlockedByVerification</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 4.5: Weekly Operating Schedule Configuration (PUT /api/v1/recycler/availability/schedule)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-020</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify updating 7-day weekly opening schedule (PUT /api/v1/recycler/availability/schedule) and auto-generating openingHoursSummary.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/availability/schedule with Mon-Sat open 07:30 - 17:30, Sunday closed (isClosed = true).&#10;2. Inspect returned weeklySchedule and openingHoursSummary.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- weeklySchedule persists all 7 days; openingHoursSummary automatically groups into Mon-Sat: 07:30-17:30; Sun: Closed summary format.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is Verified.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Schedule_Update_WithValidWeek_PersistsAndBuildsSummary</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-021</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify updating weekly schedule with varying hours across days or closed all week.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/availability/schedule with Mon-Fri (08:00-17:00), Sat (08:00-12:00), Sun closed.&#10;2. Send schedule with all 7 days set to isClosed = true.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 200 OK.&#10;- openingHoursSummary accurately reflects each day group and all-week closed status.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is Verified.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Schedule_Update_GroupsDaysWithDifferentHours &amp; AllDaysClosed_IsAccepted</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-022</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify partial week schedule update (sending only 2 days) and ignoring open/close times on days marked closed (isClosed = true).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send PUT /api/v1/recycler/availability/schedule with only Monday and Tuesday.&#10;2. Send request with Sunday isClosed = true, openTime = null, closeTime = null.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 200 OK.&#10;- Unspecified days default automatically to closed (isClosed = true).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is Verified.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Schedule_Update_PartialWeek_IsAccepted &amp; ClosedDayIgnoresTimes</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-023</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking 12 invalid schedule scenarios (closeTime &lt;= openTime, invalid HH:mm format, dayOfWeek outside [0..6], duplicate days of week).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sequentially send PUT /api/v1/recycler/availability/schedule with 12 invalid variants: &quot;8:00&quot;, &quot;24:00&quot;, open=&quot;17:00&quot; &amp; close=&quot;08:00&quot;, open == close, missing open/close when isClosed=false, dayOfWeek = 7 / -1, duplicate day, &gt; 7 days, or empty days array.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All 12 scenarios return HTTP Status 400 Bad Request.&#10;- Existing weekly schedule in DB remains unchanged.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is Verified.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Schedule_Update_WithInvalidData_Returns400_AndKeepsOldSchedule</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PRC-024</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking Pending facility from updating weekly operating schedule.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Use PendingRecycler token to send PUT /api/v1/recycler/availability/schedule with a valid schedule.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request (only Verified facilities are permitted to configure operating schedules).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">PendingRecycler account is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.PendingRecycler_Schedule_Update_IsBlockedByVerification</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

