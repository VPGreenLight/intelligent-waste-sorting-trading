    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 14.2: Staff Authoring, Slugify, Submit &amp; Recall</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M14_BlogContent</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Create draft generating deduplicated Vietnamese slug (ux_blog_posts_slug), edit draft, submit for review (MSG-ADM-06), recall Pending_Approval -&gt; Draft, author isolation &amp; status filter.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Logged in as Staff [MANAGE_BLOG].</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">14_integration_test_blog_and_content_management.md</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">65</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 14.3: Admin Moderation Queue &amp; Public Reading</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M14_BlogContent</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin moderation queue (oldest/newest), approve &amp; publish (Approved, MSG-ADM-05), reject back to Draft with mandatory feedback + AuditLog (BR-ADM-05), public portal tag filter &amp; /blog-posts alias.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Articles in various statuses and Admin permission exist.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">14_integration_test_blog_and_content_management.md</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">66</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 14.4: Staff Detail/Recall &amp; Admin Approve/Reject Flows</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">M14_BlogContent</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Individually verify GET /staff/blogs/{id}, POST /staff/blogs/{id}/recall, GET /admin/blogs/{id}, POST /admin/blogs/{id}/approve &amp; POST /admin/blogs/{id}/reject.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Staff A/B (MANAGE_BLOG) and Admin accounts exist.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">14_integration_test_blog_and_content_management.md</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="Number">67</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Function 15.1: Cross-Module Security &amp; Authorization</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">SecurityTest</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-module security integration testing: Data leak prevention, User Enumeration, Brute-Force, Replay Attack, SQLi/XSS, RBAC &amp; IDOR.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">All 14 Modules are operational.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">integration_test_security.md</Data></Cell>
   </Row>
