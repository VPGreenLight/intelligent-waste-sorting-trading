   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Rating, Review &amp; Complaint Resolution (M11_ReviewsComplaints)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">End-to-End integration testing for 3 Use Cases U-10, U-11, S-05: 1–5 star rating for Completed orders within 14 days &amp; atomic recalculation of AverageRating/TotalReviews (BR-RVW-01), blocking rating edits (BR-RVW-02) &amp; enforcing self-delete/report/Staff hide permissions (BR-RVW-03), Cloudflare R2 evidence upload (complaint-evidences), bilateral Citizen/Recycler complaints &amp; DisputeAsync integration, Filtered Partial Unique Index anti-duplication lock (BR-DSP-01, 409 MSG-DSP-04), fine-grained HANDLE_COMPLAINT permission (BR-ADM-02), 360° Arbitration Dossier (ScaleProofPhotoUrls + immutable ChatMessages BR-DSP-06), safe GreenPoints clawback (BR-GAM-01, BR-GAM-03), AccountModerationLog warning &amp; AuditLog recording (BR-ADM-05).</Data></Cell>
   </Row>
   <Row ss:Height="20">
