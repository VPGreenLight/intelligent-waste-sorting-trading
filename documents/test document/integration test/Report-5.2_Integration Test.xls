   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-019</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Prevent non-Admin users from creating new waste categories (POST /api/v1/waste-categories).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/waste-categories using a Citizen token.</Data></Cell>
