    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen A calls POST /api/v1/trade/orders/{orderId}/proposals/{messageId}/respond with {&quot;isAccepted&quot;: true}</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400 Bad Request (BR-NEG-04) — Only the counterparty (Collector A) is authorized to accept or reject the Proposal.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
