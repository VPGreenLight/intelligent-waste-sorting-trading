 <!-- ==================== SHEET 4: M01_Auth ==================== -->
 <Worksheet ss:Name="M01_Auth">
  <Table>
   <Column ss:Width="95"/>
   <Column ss:Width="210"/>
   <Column ss:Width="255"/>
   <Column ss:Width="275"/>
   <Column ss:Width="175"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="75"/>
   <Column ss:Width="195"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Authentication &amp; Account Management (M01_Auth)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">End-to-end integration testing of Citizen/Recycler registration (U-01, R-00), Dual Auth login (Bearer JWT + HttpOnly Cookie accessToken/refreshToken &amp; JS sentinel ecolink_session_active=1, supporting X-EcoLink-No-Cookie header for API/test clients and ?access_token= for SignalR) &amp; Brute-Force Protection (U-02, BR-AUTH-04), Google OAuth 2.0 (BR-AUTH-02), Refresh Token Rotation against Replay Attack (BR-AUTH-05), OTP Forgot/Reset Password (U-03, BR-AUTH-09), current user lookup /api/v1/auth/me, and direct DB Role Sync after Recycler KYB approval across AuthController &lt;-&gt; AuthService &lt;-&gt; UserAuthSnapshotLoader &lt;-&gt; PostgreSQL (ecolink_db) &lt;-&gt; EcoLink.ApiTests/AuthTests.cs.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">20</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">20</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">20</Data></Cell>
