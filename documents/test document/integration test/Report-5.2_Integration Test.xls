   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 14.1: RBAC Guard &amp; Cloudflare R2 Blog Media Upload (S-08 — STT 160)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Enforce [HasPermission(&quot;MANAGE_BLOG&quot;)] for Staff/Admin and block Citizen/Anonymous across all Blog management endpoints.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Guest without token (401) and Citizen (403) call /api/v1/staff/blogs &amp; /api/v1/admin/blogs/pending.&#10;2. Staff [MANAGE_BLOG] (200 on /staff/blogs, 403 on /admin/blogs/*); Admin (200 on both).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Strictly enforces 401/403 per RBAC rules; Staff cannot self-approve their own posts (BR-ADM-08).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen, Staff MANAGE_BLOG, and Admin accounts.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogAccessTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Upload cover image to Cloudflare R2 (POST /api/v1/staff/blogs/upload-media): reject empty/.exe files and accept valid PNG image.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send request without file (400), then send malware.exe (400).&#10;2. Send a valid 32x32 PNG image using MultipartFormDataContent.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Invalid files return 400; PNG returns 200 MSG-GEN-01 with valid fileUrl.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Staff [MANAGE_BLOG].</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogCanonicalTests</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 14.2: Staff Authoring, Slugify, Submit, Recall &amp; Ownership (S-08 — STT 161–167)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Create a new draft with a Vietnamese title, verify automatic ASCII slug generation &amp; -2 suffix deduplication.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff sends 2 POST /api/v1/staff/blogs requests with the same accented Vietnamese title.&#10;2. Create a draft without coverImageUrl (submitForApproval=false).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Generates unaccented slug with -2 suffix on the 2nd post; draft saves successfully without requiring coverImageUrl.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Staff.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Validate FluentValidation rules for title length (10..150), max 5 tags, image URL &amp; submission requirements.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send 9-character title (400), 6 tags (400), and .exe image URL (400).&#10;2. Send submitForApproval=true missing coverImageUrl (400).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">All invalid cases are rejected with 400 and detailed validation messages.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Staff.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Edit draft (PUT), submit for approval (POST /submit) &amp; transition capability flags CanEdit/CanSubmit/CanRecall.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create draft -&gt; PUT /api/v1/staff/blogs/{id} to update content.&#10;2. Call POST /api/v1/staff/blogs/{id}/submit.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Update returns 200; submit succeeds with MSG-ADM-06, status=&quot;Pending_Approval&quot;, canRecall=true, canEdit=false.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A Draft post exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lock edit/delete while post is Pending_Approval and allow Recall (POST /recall) back to Draft for editing.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Attempt PUT &amp; DELETE on a Pending_Approval post (400).&#10;2. Call POST /recall -&gt; PUT to edit -&gt; DELETE.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Pending_Approval blocks edit/delete; after recall to Draft, editing &amp; deleting succeed normally.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A Pending_Approval post exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Isolate author ownership: second Staff (Staff B) cannot view/edit/submit/delete Staff A&apos;s blog posts.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff A creates a draft post.&#10;2. Admin grants MANAGE_BLOG to new Staff B and uses B&apos;s token to access A&apos;s post.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Returns 404 Not Found to protect draft privacy across staff authors.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Admin can create/assign permissions to Staff.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Filter my blog posts list (GET /api/v1/staff/blogs) by status Draft/Pending_Approval/Published &amp; keyword search.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff creates 3 posts across 3 different statuses.&#10;2. Call GET /staff/blogs?status=...&amp;search=...</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Returns paginated results accurately matching posts owned by the logged-in Staff.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Staff has posts in multiple statuses.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 14.3: Admin Moderation Queue, Review &amp; Public Reading (A-09, G-01 — STT 158–159, 168–172)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin moderation queue (GET /api/v1/admin/blogs/pending) includes only Pending_Approval posts and sorts oldest / newest.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create 1 draft post &amp; submit 2 posts sequentially.&#10;2. Admin calls /admin/blogs/pending?sort=oldest and newest.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Draft post does not enter the queue; oldest places the earlier submission first, newest reverses the order.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Posts exist in Pending_Approval.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogAdminTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin approves publication (PATCH /api/v1/admin/blogs/{id}/review { action: &quot;Approve&quot; }), makes post public &amp; records AuditLog.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Admin approves a pending post via unified /review endpoint.&#10;2. Check /blogs/{slug} and /admin/audit-logs.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Returns 200 MSG-ADM-05, status=&quot;Approved&quot;, publishedAt != null, and BLOG_APPROVE appears in AuditLog.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A Pending_Approval post exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogCanonicalTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin rejects post (action: &quot;Reject&quot;) requiring revision feedback; returns post to Draft for Staff editing &amp; resubmission.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Attempt rejection with empty feedback (400) or &gt; 2000 characters (400).&#10;2. Submit valid feedback -&gt; Staff edits via PUT &amp; calls POST /submit.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Empty feedback is blocked with 400; valid feedback returns post to Draft with rejectionReason, and Staff can edit &amp; resubmit.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A Pending_Approval post exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogAdminTests</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Prevent race/conflict actions when Admin reviews a post already recalled by Staff or previously approved by another Admin.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff recalls Pending_Approval post back to Draft -&gt; Admin clicks approve (400).&#10;2. Post is already Approved -&gt; Admin clicks reject (400).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Both cases are blocked with 400 MSG-GEN-01 preserving state consistency.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Posts exist in Draft / Approved states.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogAdminTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Public portal (GET /api/v1/blogs, /api/v1/blogs/{slug}) hides Draft, Pending_Approval &amp; rejected posts.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a draft, a pending post, and a rejected post.&#10;2. Guest calls /blogs?search=... and /blogs/{slug}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Public list shows only Approved posts; accessing slugs of draft/pending/rejected posts returns 404.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">No token required (AllowAnonymous).</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogPublicTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Filter public list by exact tag match (no false prefix match) &amp; sort most recently published first.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Publish 2 posts tagged tgA and tgAxx.&#10;2. Call GET /api/v1/blogs?tag=tgA.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Returns only the post with exact tag tgA, excluding tgAxx; later published post appears first.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Sample posts are published.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogPublicTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Secure public response (PublicBlogPostDto): does not leak rejectionReason or internal status &amp; clamps pageSize &lt;= 50.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /blogs/{slug} on a published post.&#10;2. Call GET /blogs?pageSize=9999.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Detail response omits rejectionReason/status fields; list clamps pageSize &lt;= 50.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A published post exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogPublicTests</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify backward-compatible Alias Routes /api/v1/blog-posts* alongside /api/v1/blogs*.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Execute Create -&gt; Edit -&gt; Submit -&gt; Queue -&gt; Approve -&gt; Public Get across both /blogs* and /blog-posts*.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Both route sets dispatch to the same Controllers &amp; return identical ApiResponse structures.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Backend is running.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogCanonicalTests</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 14.4: Staff Detail/Recall Explicit Flows &amp; Admin Dedicated Approve/Reject Endpoints</Data></Cell>
   </Row>
   <Row ss:Height="176">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify Staff detail &amp; recall endpoints (GET /api/v1/staff/blogs/{id} and POST /api/v1/staff/blogs/{id}/recall) including state guards and author isolation.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff A creates a Draft post and calls GET /api/v1/staff/blogs/{id}; Staff B attempts GET /api/v1/staff/blogs/{id} (404).&#10;2. Staff A attempts POST /api/v1/staff/blogs/{id}/recall while post is Draft (400).&#10;3. Staff A submits for approval (Pending_Approval), calls POST /api/v1/staff/blogs/{id}/recall, rechecks /admin/blogs/pending queue; repeats recall on an Approved post (400).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- GET /staff/blogs/{id} returns BlogPostDto to the author and 404 Not Found to other Staff.&#10;- recall succeeds (200 OK) only from Pending_Approval -&gt; Draft and immediately removes the post from the Admin queue; recalling a Draft or Approved post is blocked with 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Staff A, Staff B (MANAGE_BLOG) &amp; Admin accounts.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BlogStaffTests.Recall_Pending_ReturnsToDraft / Recall_Draft_Returns400 / Recall_Approved_Returns400 / Recall_RemovesPostFromAdminQueue</Data></Cell>
   </Row>
   <Row ss:Height="176">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-BLG-018</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify Admin&apos;s 3 dedicated endpoints (GET /api/v1/admin/blogs/{id}, POST /api/v1/admin/blogs/{id}/approve, POST /api/v1/admin/blogs/{id}/reject) &amp; block approving recalled posts.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Staff submits post -&gt; Admin calls GET /api/v1/admin/blogs/{id} to inspect full text &amp; tags.&#10;2. Admin calls POST /api/v1/admin/blogs/{id}/reject with valid feedback (200, returns to Draft with rejectionReason).&#10;3. Staff resubmits then recalls (recall), Admin attempts POST /api/v1/admin/blogs/{id}/approve (400); Staff resubmits and Admin approves via POST .../approve (200 MSG-ADM-05).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- GET /admin/blogs/{id} returns full BlogPostDto details.&#10;- POST .../reject returns post to Draft with mandatory feedback.&#10;- POST .../approve on a recalled post is blocked with 400; valid Pending_Approval post returns 200 MSG-ADM-05 &amp; publishes publicly.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin &amp; Staff [MANAGE_BLOG].</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AdminBlogController &amp; BlogAdminTests.Approve_RecalledPost_Returns400</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 18: SecurityTest ==================== -->
 <Worksheet ss:Name="SecurityTest">
  <Table>
   <Column ss:Width="95"/>
   <Column ss:Width="210"/>
   <Column ss:Width="145"/>
   <Column ss:Width="130"/>
   <Column ss:Width="195"/>
   <Column ss:Width="200"/>
   <Column ss:Width="265"/>
   <Column ss:Width="65"/>
   <Column ss:Width="75"/>
   <Column ss:Width="185"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Sheet Name</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">SecurityTest (Cross-Module Security &amp; Authorization Integration)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">System-wide security integration testing compliant with OWASP API Security Top 10: Sensitive data exposure prevention (PasswordHash, phone numbers BR-PRIV-01), User Enumeration prevention (BR-AUTH-03), Brute-Force protection (BR-AUTH-04), Token Replay Attack (BR-AUTH-05) &amp; JWT signature tampering prevention, Broken Object Level Authorization / IDOR prevention, RBAC enforcement (Citizen, Recycler, Staff, Admin), and SQL Injection / XSS prevention.</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">16</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">16</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="8" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Scenario Name</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Role / Session</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Coverage Technique</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Given</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">When</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Then (Expected: HTTP Status / Visibility)</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Notes</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Mask both parties&apos; phone numbers while handover order is Pending (BR-PRIV-01)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen / Recycler (own order)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Use Case Testing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A new handover order was created by Citizen in Pending status (not yet accepted by Recycler)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Call GET /api/v1/handover-requests/{id} (Citizen) or GET /api/v1/recycler/handover-requests/{id} (Recycler)</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 200 OK; fields citizenPhone = null and recyclerPhone = null in JSON response — visible only after the order transitions to Accepted.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_WithValidSingleItem_Returns201_SnapshotsPrice_AndHidesPhones</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No password or passwordHash leakage in Registration &amp; Demo Users responses</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Guest (no session)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Error Guessing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System exposes POST /api/v1/auth/register and GET /api/v1/auth/demo-users APIs</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Send a new account registration request or fetch the demo user accounts list</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 200/201; entire raw JSON response MUST NOT contain the password string or passwordHash / password_hash fields.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AuthTests.Register_ResponseDoesNotLeakPassword &amp; DemoUsers_DoesNotExposePasswordHash</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Unauthenticated request to protected APIs</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Guest (no session/token)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Error Guessing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">User does not attach an Authorization: Bearer &lt;token&gt; header</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Call GET /api/v1/auth/me, /api/v1/recycler/*, /api/v1/handover-requests/*, /api/v1/transactions</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 401 Unauthorized across all protected endpoints.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AuthTests.Me_WithoutToken_Returns401, RecyclerTests, HandoverTests, ReceiptTests</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Wrong email/username and wrong password return identical error message (Anti-User Enumeration BR-AUTH-03)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Guest (no session)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Decision Table</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Account &quot;citizen&quot; exists in DB, while &quot;nouser_xyz&quot; does not exist</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Send POST /api/v1/auth/login with citizen + wrong password, and with nouser_xyz + wrong password</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Both cases return HTTP 400 Bad Request with the identical messageCode = &quot;MSG-AUTH-01&quot; and identical message string — never revealing which accounts exist.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AuthTests.Login_ErrorMessage_DoesNotRevealWhichAccountsExist</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Temporarily lock account for 15 minutes after 5 consecutive failed logins (BR-AUTH-04)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Guest (no session)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Boundary Value Analysis</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Account is Active with FailedLoginAttempts = 4</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Enter wrong password on the 5th consecutive attempt, then attempt a 6th login with the correct password</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400 Bad Request (MSG-AUTH-03); account transitions to Status = Locked, rejecting logins even with the correct password during the 15-minute lockout.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">UTC011, UTC012 &amp; ITC-AUTH-012</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject JWT token with tampered HMAC-SHA256 signature (Tampered Token)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Authenticated (tampered token)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Error Guessing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A valid JWT accessToken of citizen exists</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Modify the last 4 characters of the JWT Signature segment and call GET /api/v1/auth/me</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 401 Unauthorized — Signature validation middleware detects token tampering and rejects immediately.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AuthTests.Me_WithTamperedToken_Returns401</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Detect Token Replay Attack and revoke entire Refresh Token family (BR-AUTH-05)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen / Recycler</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Use Case Testing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A RefreshToken was already used and marked IsRevoked = true in the refresh_tokens table</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Attacker replays that old RefreshToken to POST /api/v1/auth/refresh-token</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400/401 (MSG-AUTH-10); system revokes all still-active RefreshTokens for that UserId to protect the account.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">UTC017 &amp; ITC-AUTH-016</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block SQL Injection and XSS payloads on login endpoint</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Guest (no session)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Error Guessing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Attacker passes strings &apos; OR &apos;1&apos;=&apos;1, admin&apos;--, &quot; OR &quot;&quot;=&quot;, &lt;script&gt;alert(1)&lt;/script&gt;</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Send POST /api/v1/auth/login with malicious payloads in usernameOrEmail and password</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400 Bad Request; accessToken = null, EF Core parameterized queries completely neutralize SQL Injection.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AuthTests.Login_WithInjectionPayload_IsRejected</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block Privilege Escalation: Citizen accesses Staff/Admin verification APIs</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen (authenticated)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Decision Table</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged-in account has Role = Citizen</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Call GET /api/v1/recycler-applications or PUT /api/v1/recycler-applications/{id}/verification</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 403 Forbidden — [Authorize(Roles = &quot;Staff,Admin&quot;)] filter completely blocks application verification access.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">OnboardingTests.ONB06_StaffReview_ListAndDetail_EnforcesStaffOrAdminRole</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block Citizen from accessing Recycler price list and schedule management APIs</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen (authenticated)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Decision Table</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged-in account has Role = Citizen</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Call any endpoint under /api/v1/recycler/profile, /prices, /availability, /schedule</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 403 Forbidden across all 9 Recycler-only endpoints.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.RecyclerEndpoint_WithCitizenToken_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block unverified (Pending) Recycler from toggling Online status to appear on the map (BR-MTH-01)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Pending Recycler</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Decision Table</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Newly registered Recycler account has VerificationStatus = Pending</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Send PATCH /api/v1/recycler/availability with {&quot;isOnline&quot;: true} or PUT /schedule</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400 Bad Request — Facility without document verification cannot go Online or appear on the search map.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.PendingRecycler_Availability_GoOnline_IsBlockedByVerification</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Prevent IDOR on price list: Recycler B cannot edit Recycler A&apos;s price row</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Recycler B (other recycler)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Use Case Testing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Price row {priceId} is owned by Collector A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Recycler B sends PUT /api/v1/recycler/prices/{priceId} to modify Collector A&apos;s price</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 404 Not Found (or 403); Collector A&apos;s unit price in DB remains unchanged.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerTests.Prices_Update_OtherRecyclersPriceRow_Returns404</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Prevent IDOR on handover orders: Citizen B / Recycler B cannot view, update, accept, or cancel another user&apos;s order</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen B / Recycler B</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Use Case Testing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Handover order {requestId} was created between Citizen A and Collector A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen B calls GET/PUT/POST cancel or Recycler B calls GET/POST accept/reject/cancel on {requestId}</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 403 Forbidden across all operations attempting to access an unowned order.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.OtherCitizen_CannotViewUpdateOrCancel_Returns403 &amp; OtherRecycler_CannotViewAcceptRejectOrCancel_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Prevent IDOR on receipts: non-participant users cannot view, confirm, or dispute a receipt</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen B / Recycler B</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Use Case Testing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Receipt {requestId} was issued for an order between Citizen A and Collector A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen B calls GET /receipt, POST /confirm, POST /dispute or Recycler B calls POST /receipt</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 403 Forbidden — Prevents hijacking GreenPoints or forging disputes.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.OtherCitizen_CannotAccessReceipt_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block non-participant users from accessing the handover negotiation chat room (BR-NEG-01)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen C (outsider)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Use Case Testing</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Negotiation chat room for order {orderId} includes only Citizen A and Collector A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen C calls GET /api/v1/trade/orders/{orderId}/messages or POST /messages</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400/403 (MSG-AUTH-03) — Outsiders cannot read negotiation history or inject messages into the order.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NegotiationChatTests.NEG01_GetChatThread_ParticipantsAllowed_OutsiderBlockedWithBrNeg01</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-SEC-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block price Proposal sender from accepting their own Proposal (BR-NEG-04)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen / Recycler (proposal sender)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Business Rule Testing</Data></Cell>
