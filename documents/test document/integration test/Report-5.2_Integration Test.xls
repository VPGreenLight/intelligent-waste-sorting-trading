    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Refresh Token rotation (HttpOnly cookie &amp; Replay Attack BR-AUTH-05), OTP Forgot/Reset Password (BR-AUTH-09), and profile update/logout ClearAuthCookies.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Account is Active.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">01_integration_test_authentication.md</Data></Cell>
