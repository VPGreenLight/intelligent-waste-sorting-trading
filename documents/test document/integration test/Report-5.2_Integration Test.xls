   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 10.1: Catalog, Order Lifecycle, IDOR &amp; Webhook Security (STT 133-140)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block anonymous access (401) and enforce Admin authorization (403 for Citizen/Staff) on package management &amp; reconciliation APIs.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /service-packages, /subscriptions/me, and /service-payments/orders without a token.&#10;2. Use Citizen and Staff tokens to call /admin/service-packages &amp; /admin/reconciliations/ledger.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Step 1: 401 Unauthorized. Step 2: 403 Forbidden for both Citizen and Staff.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">citizen, staff, and admin accounts are seeded.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY01</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">New Citizen account receives the full 3-tier standard catalog (BASIC, PREMIUM, PRO) &amp; defaults to tier Basic.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register a new Citizen.&#10;2. Call GET /api/v1/service-packages and GET /api/v1/service-packages/subscriptions/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">200 OK, returning all 3 packages (PRO.isEligible = false for Citizen), currentTier = &quot;Basic&quot;, isAdFree = false.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid newly registered account.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY02</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block QR generation for BASIC (0 VND), client-tampered amount, amount &lt;= 0 (MSG-PAY-03), &amp; Citizen attempting to purchase PRO.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /create sequentially with BASIC, {PREMIUM, amount=1000}, {amount=0}, and PRO.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">BASIC (400), amount=1000 (400), amount=0 (400 MSG-PAY-03), PRO (403 Forbidden).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen is logged in.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY03</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Create a PREMIUM order (59,000 VND), query order status/list, &amp; block IDOR from another Citizen (403 MSG-ADM-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen A creates a PREMIUM order and calls GET /orders/{code} and GET /orders.&#10;2. Citizen B calls GET /orders/{code} and POST /orders/{code}/cancel.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen A receives 200 OK (MSG-PAY-01, amount=59000); Citizen B is blocked with 403 (MSG-ADM-04).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Two accounts Citizen A and Citizen B exist.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY04</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cancel a Pending VietQR payment order, transitioning status to CANCELLED (MSG-PAY-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a PREMIUM order (PENDING).&#10;2. Send POST /api/v1/service-payments/orders/{orderCode}/cancel.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 200 OK, messageCode = &quot;MSG-PAY-03&quot;, status = &quot;CANCELLED&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The order is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY05</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Simulate an exact bank transfer (Exact) activating Premium for 30 days &amp; block cancelling an already Paid order (409 Conflict).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a PREMIUM order and call POST /simulate-transfer/{code} (Exact).&#10;2. Check /subscriptions/me.&#10;3. Attempt to call POST /orders/{code}/cancel.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">status = &quot;PAID&quot;, currentTier = &quot;Premium&quot;, isAdFree = true, remainingDays &gt;= 29; cancelling a Paid order returns 409 Conflict.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Dev Simulator environment is enabled.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY06</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Early renewal of the same PREMIUM package automatically stacks an additional 30 days consecutively (BR-PAY-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Purchase &amp; pay for PREMIUM package (1st time).&#10;2. Purchase &amp; pay for PREMIUM package again (2nd time).&#10;3. Call GET /subscriptions/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">2 activeSubscriptions records exist with stacked validity remainingDays &gt;= 59.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen has just activated PREMIUM.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY07</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject a Webhook carrying a forged signature (400 MSG-PAY-05) &amp; preserve the order in PENDING status.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a PREMIUM order.&#10;2. Send POST /webhook with signature = &quot;FORGED_INVALID_SIGNATURE&quot;.&#10;3. Re-check GET /orders/{code}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">HTTP 400 Bad Request (messageCode = &quot;MSG-PAY-05&quot;); order remains &quot;PENDING&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A PREMIUM order is pending.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY08</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Idempotent Webhook handling (BR-PAY-02) when the payment gateway sends duplicate notifications with the same reference.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a PREMIUM order.&#10;2. Send POST /webhook twice consecutively with the same reference.&#10;3. Call GET /subscriptions/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">1st call: status = &quot;PAID&quot;; 2nd call: status = &quot;ALREADY_PROCESSED&quot;; only 1 activeSubscription is created.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A PREMIUM order is PENDING.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY09</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Matrix of 3 anomaly scenarios via Simulator: Underpaid (stays Pending), Overpaid (activates immediately), and LateTransfer (Expired).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sequentially execute Underpaid (45,000 VND), Overpaid (69,000 VND), and LateTransfer across 3 PREMIUM orders.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Underpaid stays &quot;PENDING&quot; with tier &quot;Basic&quot;; Overpaid transitions to &quot;PAID&quot; and activates &quot;Premium&quot;; LateTransfer transitions to &quot;EXPIRED&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Dev Simulator environment is enabled.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY10</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 10.2: Recycler KYB Eligibility &amp; Map Priority Boost (R-07 &amp; M-03 / M-05)</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Unapproved KYB Recycler (Pending) is ineligible for PRO &amp; rejected with MSG-PAY-06.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Obtain JWT of a Pending Recycler.&#10;2. Call GET /service-packages and POST /service-payments/create (PRO).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">PRO.isEligible = false; order creation returns 400 Bad Request (MSG-PAY-06).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Recycler account is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY11</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-module flow (M-03 -&gt; M-12 -&gt; M-05): KYB approval, upgrading PREMIUM -&gt; PRO (365d), &amp; featured map marker boost.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Register Citizen, submit ValidApplicationPayload, and have Admin approve (PUT /verification).&#10;2. Log in again to obtain Recycler JWT and toggle Online.&#10;3. Purchase PREMIUM and then purchase PRO (1,000,000 VND).&#10;4. Call GET /api/v1/recyclers/nearby.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Upgrading to PRO immediately activates currentTier = &quot;Pro&quot;, hasVerifiedBlueBadge = true, isFeaturedMapMarker = true; the map API returns the facility pin with isFeatured = true &amp; hasVerifiedBadge = true.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Newly submitted application includes Hoa Lac coordinates (21.0135, 105.5265).</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY12</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 10.3: Admin Package Catalog &amp; Fee Configuration (A-10 - STT 141-144)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin creates a new package (201 MSG-PAY-07), blocks pricing below 2,000 VND, toggles temporary package status, &amp; protects the default BASIC package.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /admin/service-packages.&#10;2. Create QA_BOOST_* (50,000 VND) &amp; attempt to create a 1,500 VND package.&#10;3. Disable the temporary package (200) &amp; attempt to disable the BASIC package.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid creation returns 201 MSG-PAY-07; 1,500 VND -&gt; 400; disabling QA_BOOST -&gt; 200; disabling BASIC -&gt; 400 (BR-PAY-05).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY13</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Admin updates package fee via PUT /admin/service-packages/{id}, applying Grandfathering to previously purchased orders (BR-PAY-05).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create temporary package QA_GF_* priced at 50,000 VND / 30d; Citizen purchases &amp; pays.&#10;2. Admin updates fee to 80,000 VND / 45d.&#10;3. Inspect the existing order &amp; create a new order.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Existing order retains amount = 50000, durationDays = 30; new order uses amount = 80000, durationDays = 45.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin &amp; Citizen.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY14</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 10.4: Admin Financial Reconciliation &amp; Anonymized Export (A-11 - STT 145-147)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Ledger filters anomalies, ApproveAndActivate resolves an Underpaid order, ManualMatchOrder matches an orphan WH-... webhook, &amp; duplicate reconciliation is blocked (409).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create an Underpaid order, filter /ledger?onlyAnomalies=true, reconcile with ApproveAndActivate, and repeat the call a 2nd time.&#10;2. Send an orphan webhook without an order code, then run ManualMatchOrder against a Pending order.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Accurately filters the Underpaid order; 1st reconciliation -&gt; 200 MSG-PAY-08 (Resolved), 2nd -&gt; 409 Conflict; matching WH-... transitions target order to Paid / Resolved.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Logged in as Admin with an anomaly order + orphan webhook present.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY15</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Export reconciliation statements as CSV/XLSX with header X-EcoLink-Message-Code: MSG-ADM-02, mask Email/Phone PII (BR-ADM-06), &amp; record AuditLog.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen with specific email &amp; phone completes a PREMIUM payment.&#10;2. Admin calls /export?format=csv &amp; xlsx.&#10;3. Query /admin/audit-logs?action=EXPORT_RECONCILIATION.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">CSV returns 200, header contains MSG-ADM-02, masked ***@gmail.com appears with no raw email/phone exposed; XLSX starts with PK; AuditLog records the export event.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A paid order exists associated with specific email/phone values.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageTests.PAY16</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 10.5: PRO 4-Criteria Eligibility Report &amp; Live DB Role Sync (BR-PAY-03, ProEligibilityReportDto)</Data></Cell>
   </Row>
   <Row ss:Height="190">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify checking all 4 eligibility criteria for PRO registration / re-registration (ProEligibilityReportDto): Verified KYB + complete profile (RequiresProfileReverification), warnings &lt;= 5, rating &gt;= 4.0, &amp; minimum 1 positive review on re-registration (BR-PAY-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/service-packages for a facility missing KYB or pending profile reverification (RequiresProfileReverification = true).&#10;2. Repeat with a facility exceeding the warning limit (CurrentWarningCount &gt; 5 - MaxAllowedWarnings = 5) or currently holding an active PRO plan.&#10;3. Repeat with a facility that previously held PRO (IsReRegistration = true) with TotalReviews = 0 or AverageRating &lt; 4.0m, then add a review achieving &gt;= 4.0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- proEligibility accurately reflects all 4 flags: isKybAndProfileValid, isWarningLimitOk, isPositiveFeedbackMet, isNotCurrentlyActivePro, and populates blockingReasons.&#10;- Missing re-registration criteria (IsReRegistration = true without meeting MinRequiredRating = 4.0, MinRequiredReviewsForRenewal = 1) returns isEligible = false and blocks POST /service-payments/create (PRO) per BR-PAY-03; meeting all 4 criteria returns isEligible = true.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Recycler facilities exist with corresponding KYB, WarningCount, and Review states.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ProEligibilityReportDto &amp; ServicePackagePaymentTests (BR-PAY-03)</Data></Cell>
   </Row>
   <Row ss:Height="176">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-PAY-018</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that a Recycler recently upgraded by Admin from User/Citizen who still sends a stale JWT with claim role = &quot;User&quot; can still view PRO eligibility and create a VietQR PRO order via live database role lookup.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen logs in to obtain staleUserJwt (claim role = &quot;User&quot;), then submits a KYB application and is approved by Admin to Recycler (Verified).&#10;2. Using the same staleUserJwt (without re-logging in), call GET /api/v1/service-packages to check the PRO package.&#10;3. Use staleUserJwt to call POST /api/v1/service-payments/create with packageCode = &quot;PRO&quot; and complete payment activation.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: ServicePackageService.GetAvailablePackagesAsync reads Users.Role (Recycler) directly from the database rather than trusting the stale JWT claim, returning the PRO package with isEligible = true.&#10;- Step 3: PaymentService.CreatePayInOrderAsync verifies DB UserRole.Recycler, permitting VietQR PRO order creation (200/201) and activating the Pro package without forcing logout/re-login.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Account has just completed KYB approval transitioning role User -&gt; Recycler in the DB.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ServicePackageService.GetAvailablePackagesAsync &amp; PaymentService.CreatePayInOrderAsync (DB Role Sync)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

