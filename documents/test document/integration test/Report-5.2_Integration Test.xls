   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 12.1: Recycler Rating, Public Discovery &amp; Moderation (U-10 — STT 121–126)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Citizen submits a 5-star review on a Completed order, automatically updating AverageRating &amp; displaying on Public Discovery (BR-RVW-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create &amp; complete a handover request between a new Citizen &amp; a new Recycler.&#10;2. Call POST /api/v1/handover-requests/{id}/reviews (5 stars).&#10;3. Read GET /api/v1/recyclers/{id}/reviews &amp; GET /api/v1/recyclers/{id}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">201 Created (MSG-RVW-01); averageRating=5.0, totalReviews=1, starDistribution.fiveStars=1; synchronized on GeoMatching.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">WebApi &amp; PostgreSQL are running.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW01</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block reviewing an incomplete order (400 MSG-RVW-02) and block submitting a second review for the same order (409 Conflict).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Attempt to review an Accepted order (400).&#10;2. Complete the order and submit reviews twice consecutively.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Incomplete order returns 400 MSG-RVW-02; duplicate review returns 409 MSG-RVW-02.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Accepted &amp; Completed orders exist.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW02</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Enforce star rating immutability (BR-RVW-02) and block Recycler/outsider from deleting a review (403 Forbidden, BR-RVW-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Post a 2-star review.&#10;2. Send PUT /api/v1/reviews/{id} (404/405).&#10;3. Have the Recycler &amp; another Citizen call DELETE /api/v1/reviews/{id}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Star edits are disallowed (404/405); the reviewed party &amp; outsiders are blocked with 403.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A valid review exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW03</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Author permanently self-deletes a review, triggering immediate AverageRating recalculation (MSG-RVW-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Post 2 reviews (5 stars and 3 stars -&gt; avg 4.0).&#10;2. Author 2 calls DELETE /reviews/{id}.&#10;3. Query GET /api/v1/reviews/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">200 OK (MSG-RVW-03); average rating reverts to 5.0, totalReviews=1.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">2 Citizens have reviewed 1 recycler.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW04</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Report a spam review (POST /report) and Staff hides the review (PATCH /moderate) while recording AuditLog.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Recycler reports a violation (Reported).&#10;2. Staff [HANDLE_COMPLAINT] calls PATCH /moderate (Hide).&#10;3. Verify /recyclers/{id}/reviews &amp; /admin/audit-logs.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Review transitions to Hidden, average rating recalculates to 0, MODERATE_REVIEW appears in AuditLog.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Staff has HANDLE_COMPLAINT permission.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW05</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 12.2: Bilateral Complaints, Cloudflare R2 Evidence &amp; Receipt Dispute Bridge (U-11 — STT 127–129)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Upload evidence image to Cloudflare R2 (complaint-evidences) and submit a Citizen complaint ticket.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Upload a PNG via POST /api/v1/complaints/upload-evidence.&#10;2. Send POST /api/v1/complaints (ScaleDiscrepancy) attaching the URL.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Upload returns fileUrl containing complaint-evidences; complaint submission returns 201 MSG-DSP-01, code CMP-...</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen is a participant in the order.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW06</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Submit a bilateral complaint from the Recycler side for a NoShow incident.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create an Accepted order.&#10;2. Recycler calls POST /api/v1/complaints (NoShow).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">201 Created; complainantRole=&quot;Recycler&quot;, respondentId=Citizen.Id, status=&quot;Open&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">An Accepted order exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW07</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Integrate POST /receipt/dispute (M-07) flow to automatically create a complaint ticket in the Staff queue.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen disputes an awaiting-confirmation receipt via /receipt/dispute.&#10;2. Staff checks GET /api/v1/staff/complaints.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order transitions to Disputed and an Open ticket (ScaleDiscrepancy) immediately appears in the queue.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order is in AwaitingConfirmation.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW08</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block opening more than 1 Open/Investigating complaint on the same HandoverRequest (409 MSG-DSP-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen submits ticket 1 successfully.&#10;2. Recycler submits ticket 2 for the same requestId.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Ticket 2 is blocked with 409 Conflict and messageCode=&quot;MSG-DSP-04&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">An Open complaint exists on the order.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW09</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Block outsiders from filing complaints on behalf of participants (403) and isolate /api/v1/complaints/me list (BR-DSP-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Non-participant Citizen attempts POST /complaints (403).&#10;2. Outsider, Owner, and Recycler each call GET /complaints/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Outsider receives 403 and sees no tickets; both order participants see their own ticket.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order exists between A-B &amp; outsider user C.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW10</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 12.3: Staff Permissions, 360° Arbitration Dossier, Clawback &amp; Analytics (S-05 — STT 130–132)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Enforce fine-grained [HasPermission(HANDLE_COMPLAINT)] authorization on /api/v1/staff/complaints/*.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call without token (401), as Citizen (403), and as Staff with only REVIEW_AI permission (403).&#10;2. Call as Staff with HANDLE_COMPLAINT permission (200).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Only Staff with HANDLE_COMPLAINT (or Admin) can access; missing permission returns 403.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Staff permissions are configured.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW11</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Open 360° Arbitration Dossier (?claim=true): claim ticket, load scale proof photos &amp; immutable chat history (BR-DSP-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send chat messages on M-08 order, create a receipt with scale photos, and submit a complaint.&#10;2. Staff calls GET /api/v1/staff/complaints/{id}?claim=true.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Status changes to Investigating, sets assignedStaffId, and returns full receipt.scaleProofPhotoUrls &amp; negotiationMessages.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order has chat messages &amp; receipt.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW12</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Validate resolution note &gt;= 10 characters (400) and block resolving an already closed complaint a second time (409).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call PATCH /resolve with note &quot;OK done&quot; (400).&#10;2. Resolve validly as Dismissed (200), then call again (409).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Note &lt; 10 chars is blocked with 400; valid resolution returns 200 MSG-DSP-02; duplicate resolution returns 409.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Staff [HANDLE_COMPLAINT].</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW13</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Resolve with CancelDisputedOrder: cancel order, claw back GreenPoints, increment WarningCount &amp; write AccountModerationLog.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen completes a 5kg order (+50 pts) and opens a complaint.&#10;2. Staff resolves with CancelDisputedOrder + issueWarningToRespondent=true.&#10;3. Verify /auth/me &amp; /staff/accounts/{id}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order becomes Cancelled, currentGreenPoints decreases by exactly 50 pts, respondent.warningCount == 1 with WARN log.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order was previously completed and awarded points.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW14</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Resolve with ConfirmReceiptAsIs: restore Disputed order to Completed &amp; award standard bonus points.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen disputes a 5kg receipt (Disputed, points not yet awarded).&#10;2. Staff resolves with ConfirmReceiptAsIs.&#10;3. Check /auth/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order transitions to Completed and Citizen receives full +50 GreenPoints.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Order is Disputed from receipt.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW15</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RVW-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Enforce max 5 evidence photos boundary (BR-DSP-02), queue filters &amp; Admin KPI openComplaintsCount synchronization.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Submit 6 photos (400), then submit 5 photos (201).&#10;2. Filter /staff/complaints?status=Open&amp;category=Misconduct &amp; call Admin KPI.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">6 photos blocked with 400; 5 photos accepted; KPI openComplaintsCount &gt;= 1.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">At least 1 Open complaint exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RVW16</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

