   <Column ss:Width="195"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Handover Request Management (M06_Handover)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Comprehensive integration testing for the Scrap Handover Request Management module (U-06, U-07, R-03, R-04): Cross-role authorization between Citizen and Recycler, pickup appointment request creation generating HND-yyyyMMdd-NNNN codes, PriceSnapshotPerKg snapshotting from Module 4 pricing tables (BR-HND-03), maximum limit of 3 open requests (BR-HND-02), facility Online status &amp; weekly opening-hours validation, privacy phone masking while Pending and revealing after Accepted (BR-PRIV-01), Citizen request update/cancellation with &lt; 2h late-cancellation flagging (BR-HND-05), and Recycler accept/reject/cancel workflows requiring mandatory reasons (BR-HND-06) (EcoLink.ApiTests/HandoverTests.cs).</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">23</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">23</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">23</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">23</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 6.1: Role-Based Access Control (RBAC) Gate (/api/v1/handover-requests &amp; /api/v1/recycler/handover-requests)</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that all 10 handover request management endpoints reject unauthenticated requests without a JWT token (401 Unauthorized).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sequentially call POST/GET/PUT /api/v1/handover-requests/* and GET/POST /api/v1/recycler/handover-requests/* without attaching a Bearer token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All 10 endpoints return HTTP Status 401 Unauthorized.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system is running normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Endpoint_WithoutToken_Returns401</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify cross-role access denial: Citizen cannot call Recycler endpoints and Recycler cannot call Citizen request creation/update/cancellation endpoints (403 Forbidden).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Use a collector token to call Citizen endpoints /api/v1/handover-requests/*.&#10;2. Use a citizen token to call Recycler endpoints /api/v1/recycler/handover-requests/*.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All cross-role calls are blocked with HTTP Status 403 Forbidden.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">citizen and collector accounts are logged in.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.CitizenEndpoint_WithCollectorToken_Returns403 &amp; RecyclerEndpoint_WithCitizenToken_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 6.2: Citizen Handover Request Creation &amp; Price Snapshot (POST /api/v1/handover-requests - U-06)</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Citizen creates a valid handover request (201 Created), automatically generates an HND-yyyyMMdd-NNNN code, snapshots PriceSnapshotPerKg (BR-HND-03), and hides phone numbers while Pending (BR-PRIV-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Prepare the collector facility in Online status with plastic = 8000 VND/kg.&#10;2. Send POST /api/v1/handover-requests with 10kg plastic, scrap photos, pickup address, and a valid appointment time slot.&#10;3. Inspect the returned request details.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 201 Created, messageCode = &quot;MSG-HND-01&quot;.&#10;- code matches pattern ^HND-\d{8}-\d{4}$, status = &quot;Pending&quot;.&#10;- priceSnapshotPerKg = 8000, estimatedSubtotal = 80000, estimatedTotalAmount = 80000.&#10;- citizenPhone = null and recyclerPhone = null (BR-PRIV-01).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen has &lt; 3 open requests; the collector facility is Online.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_WithValidSingleItem_Returns201_SnapshotsPrice_AndHidesPhones</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that creating a request with multiple scrap categories (plastic + metal) accurately sums total weight and estimated amount, while keeping PriceSnapshotPerKg immutable even after the facility updates its price table (BR-HND-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a request containing 5kg plastic (8000 VND) + 2kg metal (15000 VND).&#10;2. After the request is created (201), have collector update the plastic price to 12000 VND/kg in Module 4.&#10;3. Re-fetch the handover request details via GET /api/v1/handover-requests/{id}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: totalEstimatedWeightKg = 7, estimatedTotalAmount = 70000.&#10;- Step 3: priceSnapshotPerKg in the request remains 8000 VND/kg and estimatedTotalAmount = 70000 (unaffected by the new price table).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The collector facility purchases both plastic and metal.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_WithMultipleItems_SumsWeightsAndSubtotals &amp; PriceSnapshot_RemainsUnchanged_AfterRecyclerChangesPrice</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify boundary values when creating a handover request: minimum weight 0.1kg, maximum weight 10,000kg, maximum 5 attached photos, and appointment time right at the minimum lead threshold (&gt; 30 minutes from now).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/handover-requests with estimatedWeightKg = 0.1 and 5 photo URLs.&#10;2. Cancel the created request, then send a new request with estimatedWeightKg = 10000 and appointment time slot UtcNow + 35m.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both valid boundary requests return HTTP Status 201 Created.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen has not reached the limit of 3 open requests.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_AtBoundaryValues_Succeeds</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of invalid input scenarios when creating a request (weight &lt; 0.1 or &gt; 10000, 0 photos or &gt; 5 photos, duplicate waste category, appointment time in the past / &lt; 2 hours ahead / exceeding the &gt; 30-day booking window).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sequentially send POST /api/v1/handover-requests with invalid input variants.&#10;2. Verify the returned HTTP status codes.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All invalid data and booking-window (&gt; 30 days) violation scenarios are rejected with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system is running normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_WithInvalidData_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-Module Integration (M4 -&gt; M6): Reject request creation when the facility does not exist (404), is pending approval (Pending), is Offline, does not buy that waste type, or when the appointment falls outside facility opening days/hours.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send a request to a random recyclerId (404) and to PendingRecycler (400).&#10;2. Switch collector to Offline and send a request (400).&#10;3. Suspend the glass category and send a request selling glass (400).&#10;4. Configure collector schedule as closed all week or open only 08:00-17:00, then book at 20:00 (400).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 404 Not Found / 400 Bad Request.&#10;- Steps 2, 3, 4: all are accurately rejected with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Corresponding statuses are configured in Module 4.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_ToOfflineRecycler_Returns400 &amp; OutsideOpeningHours_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify the maximum limit of 3 active in-progress handover requests per Citizen (BR-HND-02 / MSG-HND-05).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Clean up existing requests for citizen.&#10;2. Sequentially create 3 new handover requests (Pending) -&gt; all 3 succeed (201 Created).&#10;3. Attempt to create a 4th request while the 3 requests remain open.&#10;4. Cancel 1 of the 3 requests, then re-submit the 4th request creation.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- 4th request (before cancellation): rejected with 400 Bad Request, messageCode = &quot;MSG-HND-05&quot;.&#10;- After cancelling 1 request: creation succeeds (201 Created).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">citizen account is active and valid.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_FourthActiveRequest_Returns400WithMSGHND05_UntilOneIsCancelled</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 6.3: Citizen &amp; Recycler Listing, Filtering &amp; Privacy Protection (GET /handover-requests, GET /recycler/handover-requests)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify paginated listing and status filtering (status) on the Citizen side and appointment date range filtering (fromDate, toDate) on the Recycler side.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create 1 Pending request and 1 Cancelled request.&#10;2. Call GET /api/v1/handover-requests?status=Pending and ?status=Cancelled.&#10;3. Use the collector token to call GET /api/v1/recycler/handover-requests?fromDate=...&amp;toDate=....</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Returned results contain only requests matching the specified status and date range, ordered newest first.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Handover requests already exist in the database.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.CitizenList_FilterByStatus_ReturnsOnlyMatchingItems &amp; RecyclerList_FilterByDateRange_ReturnsMatchingItems</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify protection against unauthorized access to another user&apos;s request (IDOR): a second Citizen or second Recycler cannot view, edit, or cancel a request they do not own.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen 1 creates a request addressed to Collector 1.&#10;2. Use Citizen 2&apos;s token to call GET, PUT, and POST /cancel on Citizen 1&apos;s request.&#10;3. Use Recycler 2&apos;s token to call GET, POST /accept, /reject, and /cancel on Collector 1&apos;s request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All unauthorized accesses are blocked with HTTP Status 403 Forbidden.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Citizen 2 and Recycler 2 exist independently from the request owner and target.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.OtherCitizen_CannotViewUpdateOrCancel_Returns403 &amp; OtherRecycler_CannotViewAcceptRejectOrCancel_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 6.4: Citizen Update &amp; Cancellation Workflow (PUT /api/v1/handover-requests/{id}, POST /{id}/cancel - U-07)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Citizen updates a Pending handover request (PUT /api/v1/handover-requests/{id}), recalculating weight, estimated total, and attached photos.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a Pending request with 10kg plastic.&#10;2. Send PUT /api/v1/handover-requests/{id} changing to 8kg metal, a new address, new notes, and a new appointment time slot.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- Request is updated to 8kg metal and estimatedTotalAmount is recalculated using the metal unit price.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Update_WhilePending_UpdatesAllEditableFieldsAndRecalculatesTotals</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that editing a request (PUT /api/v1/handover-requests/{id}) is locked once the recycling facility has accepted it (Accepted - BR-HND-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a Pending request, then have collector call POST /accept to transition it to Accepted.&#10;2. Have Citizen call PUT /api/v1/handover-requests/{id} to modify the request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request (editing is disallowed after acceptance).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Update_AfterAccepted_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that when Citizen cancels a request while Pending or &gt;= 2 hours before the confirmed appointment slot, it is not flagged as a late cancellation (isLateCancellation = false).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a Pending request with an appointment slot 26 hours from now.&#10;2. Collector accepts the request (Accepted).&#10;3. Citizen calls POST /api/v1/handover-requests/{id}/cancel with {&quot;reason&quot;: &quot;Unexpected schedule conflict&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-HND-03&quot;.&#10;- status = &quot;Cancelled&quot;, cancelledBy = &quot;Citizen&quot;, isLateCancellation = false.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The request is Pending or Accepted and &gt; 2 hours before the appointment slot.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.CitizenCancel_WhenAcceptedMoreThan2HoursBeforeSlot_IsNotLate</Data></Cell>
   </Row>
   <Row ss:Height="120">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify late cancellation warning rule (BR-HND-05): When an Accepted request is cancelled by Citizen within &lt; 2 hours before the appointment slot, isLateCancellation = true.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a request with proposedTimeSlot = UtcNow + 60m (1 hour ahead, i.e., &lt; 2 hours).&#10;2. Collector calls POST /accept to confirm the request.&#10;3. Citizen calls POST /api/v1/handover-requests/{id}/cancel with a cancellation reason.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-HND-03&quot;.&#10;- status = &quot;Cancelled&quot;, isLateCancellation = true, and cancelledAt timestamp is recorded.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The request is Accepted and &lt; 2 hours remain before confirmedTimeSlot.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.CitizenCancel_WhenAcceptedWithin2HoursOfSlot_FlagsLateCancellation</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 6.5: Recycler Accept, Reject &amp; Cancel Workflow (POST /accept, /reject, /cancel - R-03, R-04)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Recycler accepts a request (POST /api/v1/recycler/handover-requests/{id}/accept), transitioning status to Accepted, locking confirmedTimeSlot, and revealing both parties&apos; phone numbers (BR-PRIV-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Citizen creates a Pending request.&#10;2. Collector calls POST /api/v1/recycler/handover-requests/{id}/accept.&#10;3. Inspect request details from both Citizen and Collector perspectives.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-HND-02&quot;.&#10;- status = &quot;Accepted&quot;, confirmedTimeSlot matches proposedTimeSlot.&#10;- Both citizenPhone and recyclerPhone are fully revealed so the two parties can coordinate pickup.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Accept_WhilePending_TransitionsToAccepted_ConfirmsSlot_AndRevealsPhones</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Recycler can accept a request with an adjusted future appointment slot (confirmedTimeSlot) and is blocked if the adjusted time slot is in the past.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a Pending request; collector sends POST /accept with confirmedTimeSlot = UtcNow + 48h.&#10;2. Create a second request; collector sends POST /accept with confirmedTimeSlot = UtcNow - 1h.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: 200 OK, confirmedTimeSlot is updated to the new time.&#10;- Step 2: rejected with 400 Bad Request, and the request remains Pending.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Accept_WithCustomFutureTimeSlot_OverridesProposedSlot &amp; WithPastTimeSlot_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Recycler rejects a request (POST /api/v1/recycler/handover-requests/{id}/reject), transitioning it to Rejected, and requires a mandatory reason of 1..500 characters (BR-HND-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a Pending request; collector sends POST /reject with {&quot;reason&quot;: &quot;&quot;} or a 501-character string.&#10;2. Resend POST /reject with {&quot;reason&quot;: &quot;Collection truck is under maintenance&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: blocked with 400 Bad Request (BR-HND-06), request stays Pending.&#10;- Step 2: returns 200 OK (MSG-HND-04), status = &quot;Rejected&quot;, rejectionReason is persisted accurately.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Pending status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Reject_WithoutReason_Returns400 &amp; Reject_WhilePending_WithReason_TransitionsToRejected</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-018</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Recycler cancelling an already Accepted request (POST /api/v1/recycler/handover-requests/{id}/cancel) requires a mandatory cancellation reason (BR-HND-06).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a request and have collector accept it (Accepted).&#10;2. Collector calls POST /api/v1/recycler/handover-requests/{id}/cancel with {&quot;reason&quot;: &quot;&quot;}.&#10;3. Resend with {&quot;reason&quot;: &quot;Flooded road prevents vehicle access&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns 400 Bad Request, request remains Accepted.&#10;- Step 3: returns 200 OK (MSG-HND-03), status = &quot;Cancelled&quot;, cancelledBy = &quot;Recycler&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.RecyclerCancel_WithoutReason_Returns400 &amp; RecyclerCancel_WhenAccepted_WithReason_TransitionsToCancelled</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-019</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Recycler is blocked from misusing /cancel while the request is still Pending (must use /reject) or using /reject after it is Accepted (must use /cancel).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. While the request is Pending, collector calls POST /cancel.&#10;2. Once the request is Accepted, collector calls POST /reject.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both invalid state-transition operations are rejected with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The request is in Pending or Accepted status respectively.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.RecyclerCancel_WhileStillPending_Returns400 &amp; Reject_AfterAccepted_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-020</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify state machine invariant: requests in terminal states (Rejected or Cancelled) cannot be accepted, rejected, updated, or cancelled again.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create 1 request and Reject it, and 1 request and Cancel it.&#10;2. Attempt to call PUT /update, POST /accept, POST /reject, and POST /cancel on both requests.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All state-transition attempts on closed requests are rejected with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The requests are in Rejected or Cancelled status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.TerminalRequest_CannotTransitionAgain</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-021</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that querying or acting on a non-existent handover request id returns 404 Not Found across all detail/action endpoints.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Generate a random non-existent Guid.&#10;2. Call GET, PUT, POST /cancel on the Citizen side and GET, POST /accept, /reject, /cancel on the Recycler side.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All 7 endpoints return HTTP Status 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The Guid does not exist in the handover_requests table.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.UnknownRequestId_Returns404</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-022</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify uniqueness of generated request codes HND-yyyyMMdd-NNNN when creating multiple requests consecutively on the same day.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create 3 handover requests consecutively on the same day.&#10;2. Inspect the code field of all 3 requests.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All 3 code values match the HND-yyyyMMdd-NNNN format and are completely distinct from one another.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system is running normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_ThreeRequestsInSameDay_GeneratesDistinctCodes</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-HND-023</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify the maximum 30-day appointment booking window limit (MaxAppointmentAheadDays = 30) when creating a handover request (POST /api/v1/handover-requests).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Use the citizen token to send POST /api/v1/handover-requests with proposedTimeSlot = DateTimeOffset.UtcNow.AddDays(31) (exceeding the 30-day maximum).&#10;2. Inspect the error response from the system.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Rejected with HTTP Status 400 Bad Request (success = false).&#10;- No handover request is created outside the 30-day booking window (HandoverTradeSyncHelper.MaxAppointmentAheadDays = 30).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Valid citizen account and the recycling facility is Online.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HandoverTests.Create_SlotMoreThan30DaysAhead_Returns400</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 10: M07_Receipt ==================== -->
 <Worksheet ss:Name="M07_Receipt">
  <Table>
   <Column ss:Width="95"/>
   <Column ss:Width="210"/>
   <Column ss:Width="255"/>
   <Column ss:Width="275"/>
   <Column ss:Width="175"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="65"/>
   <Column ss:Width="75"/>
   <Column ss:Width="195"/>

   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Handover Completion, Receipt &amp; Transaction History (M07_Receipt)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">Comprehensive integration testing for the Digital Receipt Issuance, Handover Completion, and Transaction History module (R-06, U-09, U-12): Receipt preview and &gt; 20% weight deviation warning (POST /receipt/preview, MSG-RCP-03), RCP-yyyy-NNNN receipt issuance requiring scale photo proof when &gt;= 10 kg (BR-TRN-01, MSG-RCP-04), 24h auto-confirmation deadline setup (BR-TRN-03), Citizen receipt confirmation (POST /receipt/confirm) awarding GreenPoints &amp; upgrading TreeLevel (Module 1 Gamification), discrepancy dispute submission (POST /receipt/dispute), and transaction history queries (GET /transactions, GET /recycler/transactions) (EcoLink.ApiTests/ReceiptTests.cs).</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">21</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Failed</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">N/A</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">21</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">21</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">21</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 7.1: RBAC Authorization &amp; Ownership Protection (/receipt, /confirm, /dispute, /transactions)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that all 8 receipt and transaction history endpoints reject requests without a JWT token (401) and cross-role calls between Citizen and Recycler (403).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call POST /receipt/preview, POST/GET /receipt, POST /confirm, POST /dispute, GET /transactions, and GET /recycler/transactions without a token.&#10;2. Make cross-role calls using the opposite role&apos;s token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Without token: all return 401 Unauthorized.&#10;- Cross-role calls: all return 403 Forbidden.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system is running normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Endpoint_WithoutToken_Returns401 &amp; CrossRole_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify protection against unauthorized access to another user&apos;s receipt (IDOR): Citizen 2 cannot view/confirm/dispute Citizen 1&apos;s receipt, and Recycler 2 cannot issue/view Collector 1&apos;s receipt.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create an Accepted request between Citizen 1 and Collector 1 and issue a receipt.&#10;2. Use Citizen 2&apos;s token to call GET /receipt, POST /confirm, and POST /dispute.&#10;3. Use Recycler 2&apos;s token to call POST /preview, POST /receipt, and GET /receipt.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All unauthorized third-party accesses are blocked with HTTP Status 403 Forbidden.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The request and receipt belong to Citizen 1 and Collector 1.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.OtherCitizen_CannotAccessReceipt_Returns403 &amp; OtherRecycler_CannotAccessReceipt_Returns403</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 7.2: Receipt Calculation Preview &amp; Weight Deviation Warning (POST /api/v1/recycler/handover-requests/{id}/receipt/preview)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that receipt preview (POST /receipt/preview) accurately calculates item subtotals and total amount rounded to the nearest VND without persisting to the database.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create an Accepted request with 5kg plastic (8000 VND/kg).&#10;2. Collector sends POST /receipt/preview with actualWeightKg = 5.0 and unitPricePerKg = 8000.&#10;3. Check GET /receipt after previewing.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: 200 OK, subtotal = 40000, totalAmount = 40000, hasDeviationWarning = false.&#10;- Step 3: GET /receipt still returns 404 Not Found (preview does not persist an actual record).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Preview_Within20PercentDeviation_CalculatesTotalsWithoutWarning_AndDoesNotPersist</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify the weight deviation boundary at exactly 20% (hasDeviationWarning = false) and exceeding 20% (hasDeviationWarning = true, MSG-RCP-03 - BR-TRN-02).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. For a request estimated at 10.0kg, call POST /receipt/preview with actualWeightKg = 8.0 (exact 20.0% deviation).&#10;2. Call POST /receipt/preview again with actualWeightKg = 7.9 (21.0% &gt; 20% deviation).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1 (20% boundary): hasDeviationWarning = false, deviationPercent = 20.&#10;- Step 2 (21% &gt; 20%): hasDeviationWarning = true, messageCode = &quot;MSG-RCP-03&quot;, warning of weight discrepancy.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">A request estimated at 10.0kg is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Preview_AtExact20PercentBoundary_NoWarning &amp; Over20PercentDeviation_ReturnsWarningWithMSGRCP03</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that POST /receipt/preview defaults to the request&apos;s PriceSnapshotPerKg when unitPricePerKg is omitted, and allows overriding with the actual on-site unit price.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /receipt/preview with unitPricePerKg = null -&gt; uses 8000 VND/kg from snapshot.&#10;2. Resend with unitPricePerKg = 8500 -&gt; calculates using 8500 VND/kg.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: unitPricePerKg = 8000.&#10;- Step 2: unitPricePerKg = 8500, and subtotal updates accordingly.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Preview_WithoutUnitPrice_UsesSnapshotPrice</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 7.3: Digital Receipt Issuance &amp; Scale Photo Enforcement (POST /api/v1/recycler/handover-requests/{id}/receipt - R-06)</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify successful receipt issuance (201 Created) for requests &lt; 10kg (no scale photo required), generating code RCP-yyyy-NNNN, transitioning the request to AwaitingConfirmation, and setting AutoConfirmAt = IssuedAt + 24h (BR-TRN-03).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create an Accepted request with 5kg plastic.&#10;2. Collector sends POST /api/v1/recycler/handover-requests/{id}/receipt with actualWeightKg = 5.0 and scalePhotoUrls = null.&#10;3. Inspect the receipt via GET /receipt from both Collector and Citizen sides.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 201 Created, messageCode = &quot;MSG-RCP-01&quot;.&#10;- code matches pattern ^RCP-\d{4}-\d{4}$, status = &quot;AwaitingConfirmation&quot;.&#10;- autoConfirmAt - issuedAt is approximately 24 hours (BR-TRN-03).&#10;- Both parties can view the receipt via GET /receipt.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Create_Under10Kg_WithoutScalePhoto_Returns201_AndTransitionsToAwaitingConfirmation</Data></Cell>
   </Row>
   <Row ss:Height="162">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify mandatory scale indicator photo attachment rule (scalePhotoUrls) when total actual weight &gt;= 10 kg (BR-TRN-01 / MSG-RCP-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create an Accepted request.&#10;2. Send POST /receipt with actualWeightKg = 9.99 and scalePhotoUrls = [] (below &lt; 10kg threshold).&#10;3. Create a second request and send POST /receipt with actualWeightKg = 10.0 and scalePhotoUrls = [] (at &gt;= 10 kg threshold without scale photo).&#10;4. Resend on the second request with scalePhotoUrls = [&quot;https://cdn.ecolink.vn/scale.jpg&quot;].</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2 (9.99kg): succeeds with 201 Created.&#10;- Step 3 (10.0kg without scale photo): blocked with 400 Bad Request, messageCode = &quot;MSG-RCP-04&quot;.&#10;- Step 4 (10.0kg with scale photo): succeeds with 201 Created.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Create_10KgOrMore_WithoutScalePhoto_Returns400WithMSGRCP04 &amp; WithScalePhoto_Returns201</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of issuing a duplicate second receipt on the same handover request (BR-TRN-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Issue the first receipt for the request (201 Created).&#10;2. Send a second POST /receipt for the same requestId.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Second attempt is blocked with HTTP Status 400 Bad Request (BR-TRN-04 - each request can have at most 1 receipt).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The request already has a first receipt issued.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Create_DuplicateReceiptForSameRequest_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of receipt issuance when the request is not yet accepted (Pending) or is already Cancelled/Rejected.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a Pending request (without Accept) and call POST /receipt.&#10;2. Create a request, Cancel it, and then call POST /receipt.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases are blocked with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The request is not in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Create_WhenRequestNotAccepted_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection of receipt issuance across 14 invalid input scenarios (actualWeightKg &lt;= 0 or &gt; 10000, unitPricePerKg &lt;= 0 or &gt; 1000000, missing request waste line items, or &gt; 5 scale photos).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Sequentially send POST /receipt with the 14 invalid data variants.&#10;2. Check the request status after rejection.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All 14 variants return 400 Bad Request.&#10;- The request remains in Accepted status and no receipt is created.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Create_WithInvalidData_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that request cancellation (POST /cancel) is locked for both Citizen and Recycler once the receipt has been issued (AwaitingConfirmation).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create a request, Accept it, and issue a receipt (AwaitingConfirmation).&#10;2. Citizen attempts to call POST /api/v1/handover-requests/{id}/cancel.&#10;3. Collector attempts to call POST /api/v1/recycler/handover-requests/{id}/cancel.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cancellation attempts after weighing and receipt issuance are rejected with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in AwaitingConfirmation status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.AfterReceiptIssued_CannotCancelRequest_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 7.4: Citizen Receipt Confirmation, Green Points Gamification &amp; Dispute (POST /confirm, POST /dispute - U-09)</Data></Cell>
   </Row>
   <Row ss:Height="148">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-Module Integration (M7 -&gt; M1 Gamification): Citizen confirms receipt (POST /receipt/confirm), completing the order (Completed), awarding exact GreenPoints = floor(TotalKg * 10), and increasing TotalRecycledKg in /auth/me (BR-TRN-05).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Read initial currentGreenPoints and totalRecycledKg of citizen via GET /api/v1/auth/me.&#10;2. Create a request, Accept it, and issue a receipt for 5.5kg plastic (pointsAwarded = 55).&#10;3. Citizen calls POST /api/v1/handover-requests/{id}/receipt/confirm.&#10;4. Re-fetch GET /api/v1/auth/me to compare values.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 3: returns 200 OK, messageCode = &quot;MSG-RCP-02&quot;, status = &quot;Completed&quot;, pointsAwarded = 55, and confirmedByUserAt is recorded.&#10;- Step 4: currentGreenPoints increases by +55 points and totalRecycledKg increases by +5.5kg.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in AwaitingConfirmation status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Confirm_WhenAwaitingConfirmation_CompletesOrder_AndAwardsGreenPointsToUser</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify double-point award prevention (Idempotency / Double-Confirm Prevention): calling POST /receipt/confirm a second time on a Completed request is blocked and awards no additional points.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. After confirming the request in the previous test, read citizen&apos;s currentGreenPoints.&#10;2. Send a second POST /api/v1/handover-requests/{id}/receipt/confirm.&#10;3. Re-read currentGreenPoints via GET /api/v1/auth/me.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: blocked with HTTP Status 400 Bad Request.&#10;- Step 3: currentGreenPoints remains completely unchanged with no duplicate points awarded.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is already in Completed status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Confirm_SecondTime_Returns400_AndDoesNotDoubleAwardPoints</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that Citizen submits a receipt dispute (POST /api/v1/handover-requests/{id}/receipt/dispute) requiring a reason (1..500 chars), transitions status to Disputed, and withholds green points.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Issue a new receipt (AwaitingConfirmation).&#10;2. Send POST /receipt/dispute with {&quot;reason&quot;: &quot;&quot;} -&gt; blocked with 400.&#10;3. Resend with {&quot;reason&quot;: &quot;Actual weight at home was 8kg but the receipt recorded only 5kg&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2: returns 400 Bad Request.&#10;- Step 3: returns 200 OK, status = &quot;Disputed&quot;, disputeReason and disputedAt are saved, and green points are withheld until Staff resolves the dispute.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in AwaitingConfirmation status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Dispute_WithValidReason_TransitionsToDisputed_AndDoesNotAwardPoints</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify mutual exclusion between Confirm and Dispute: a Confirmed request cannot be Disputed, and a Disputed request cannot be Confirmed or Disputed a second time.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. On a Completed request, call POST /receipt/dispute.&#10;2. On a Disputed request, call POST /receipt/confirm and POST /receipt/dispute.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All operations are rejected with HTTP Status 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Completed and Disputed requests exist.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Dispute_AfterConfirmed_Returns400 &amp; Confirm_AfterDisputed_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 7.5: Citizen &amp; Recycler Transaction History &amp; Summary Aggregation (GET /transactions, GET /recycler/transactions - U-12)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-016</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that a newly Completed transaction immediately appears in both Citizen transaction history (GET /api/v1/transactions) and Recycler transaction history (GET /api/v1/recycler/transactions).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Complete 1 receipt (Confirm).&#10;2. Call GET /api/v1/transactions using the citizen token.&#10;3. Call GET /api/v1/recycler/transactions using the collector token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both parties see the newly completed transaction record along with receiptCode, requestCode, totalWeightKg, totalAmount, and pointsAwarded.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">At least 1 Completed transaction exists.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Transactions_AfterConfirm_AppearsInBothCitizenAndRecyclerHistory</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-017</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify that requests in AwaitingConfirmation or Disputed status are excluded from completed transaction history and summary statistics.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create 1 AwaitingConfirmation request and 1 Disputed request.&#10;2. Call GET /api/v1/transactions and inspect the items list.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Neither unfinished request appears in the Completed transaction history list.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Requests exist in AwaitingConfirmation and Disputed statuses.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Transactions_ExcludesUnconfirmedAndDisputedReceipts</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-018</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify accuracy of aggregated statistics (summary.totalCompletedOrders, totalWeightKg, totalAmount, totalPointsEarned) when a new transaction is completed.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Read the current summary from GET /api/v1/transactions.&#10;2. Create, accept, issue receipt (4kg plastic * 8000 VND = 32000 VND, 40 points), and confirm completion.&#10;3. Re-read summary from GET /api/v1/transactions.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- totalCompletedOrders increases by +1.&#10;- totalWeightKg increases by +4.0.&#10;- totalAmount increases by +32000.&#10;- totalPointsEarned increases by +40.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The system is running normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Transactions_Summary_IncrementsAccuratelyAfterNewCompletion</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-019</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify date range filtering (fromDate, toDate), keyword search (search by receipt code / partner name), and pagination on transaction history.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/transactions?search=&lt;receiptCode&gt;.&#10;2. Call GET /api/v1/transactions?fromDate=2026-01-01&amp;toDate=2026-12-31.&#10;3. Call with fromDate &gt; toDate (reversed date range).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Steps 1 &amp; 2: return 200 OK with records matching the filters.&#10;- Step 3 (fromDate &gt; toDate): returns 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Completed transactions exist in the database.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Transactions_FilterByKeywordAndDateRange_WorksCorrectly</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-020</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify uniqueness of generated receipt codes RCP-yyyy-NNNN when issuing multiple receipts consecutively.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Consecutively issue 2 receipts for 2 different handover requests.&#10;2. Compare the code field of both receipts.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both codes match the ^RCP-\d{4}-\d{4}$ format and are completely distinct.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">2 handover requests are in Accepted status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ReceiptTests.Create_MultipleReceipts_GeneratesDistinctCodes</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 7.6: Scale Proof Upload &amp; TradeOrder Synchronization (POST .../receipt/upload-proof, HandoverTradeSyncHelper)</Data></Cell>
   </Row>
   <Row ss:Height="190">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-RCP-021</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify uploading scale proof images to Cloudflare R2 (POST /api/v1/recycler/handover-requests/{requestId:guid}/receipt/upload-proof) and TradeOrder synchronization upon receipt creation/confirmation.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Attempt to upload an empty file, a .txt / non-(.jpg/.jpeg/.png/.webp) file, or a file exceeding 10 MB to POST .../receipt/upload-proof -&gt; verify 400.&#10;2. Upload a valid PNG image to POST .../receipt/upload-proof to obtain fileUrl under prefix receipt-proofs/{requestId:N}.&#10;3. Issue the receipt (POST /receipt), have Citizen confirm (POST /receipt/confirm), and verify TradeOrder, TransactionReceipt, ChatMessage, and UserEcoProfile records.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: Invalid file format returns 400 MSG-CLS-01; empty file or &gt; 10 MB returns 400 MSG-GEN-01.&#10;- Step 2: 200 OK (MSG-GEN-01), returning fileUrl and objectKey under receipt-proofs/{requestId:N}.&#10;- Step 3: HandoverTradeSyncHelper.SyncHandoverToTradeOrderAsync updates TradeOrder to AwaitingConfirmation + adds a System ChatMessage; after Confirm, SyncReceiptCompletionAsync synchronizes TradeOrder.Status = Completed, creates TransactionReceipt, and credits UserEcoProfile.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">The handover request is in Accepted status; R2/Local storage service is operational.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerReceiptController.UploadProof &amp; HandoverTradeSyncHelper (SyncHandoverToTradeOrderAsync / SyncReceiptCompletionAsync)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 11: M08_Negotiation ==================== -->
 <Worksheet ss:Name="M08_Negotiation">
