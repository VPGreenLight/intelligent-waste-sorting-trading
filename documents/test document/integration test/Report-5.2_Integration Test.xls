   <Row ss:Index="2" ss:Height="22">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeftBold"><Data ss:Type="String">Recycler Profile, Pricing &amp; Availability (M04_Recycler)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Test requirement</Data></Cell>
    <Cell ss:MergeAcross="3" ss:StyleID="SummaryValueLeft"><Data ss:Type="String">End-to-end integration testing of Recycler Facility Profile, Pricing &amp; Operating Schedule Management (R-01, R-02): Recycler RBAC authorization, View/Update facility profile &amp; GPS coordinates (GET/PUT /profile), Add/Update single price row (POST /prices, PUT /prices/{id}), Atomic bulk price save (PUT /prices - Atomic Transaction), rule enforcing at least 1 active price category (BR-PRC-03 / MSG-PRC-02), Online/Offline status toggle with Verified check (BR-MTH-01), and 7-day weekly opening schedule configuration (PUT /availability/schedule) (EcoLink.ApiTests/RecyclerTests.cs).</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabel"><Data ss:Type="String">Number of TCs</Data></Cell>
    <Cell ss:StyleID="SummaryValue"><Data ss:Type="Number">24</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="SummaryValue"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SummaryLabelItalic"><Data ss:Type="String">Testing Round</Data></Cell>
