   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 2.1: AI Model Catalog &amp; Waste Sorting Rule Engine (GET /api/v1/waste-scan/models, GET /rules, GET /waste-categories)</Data></Cell>
   </Row>
   <Row ss:Height="134">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify retrieving available computer vision models via GET /api/v1/waste-scan/models integrated with 16 FastAPI endpoints (/api/v1/*).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/waste-scan/models.&#10;2. Inspect model list in JSON response.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- Returns non-empty model list containing YOLO26 Two-Stage (yolo26_detect NMS-Free default), yolo26s_cls, yolo26n_cls along with legacy benchmark models (efficientnet_b0, mobilenet_v3) and backward-compatibility alias (yolov8_detect -&gt; yolo26_detect), synced across 16 FastAPI endpoints (/api/v1/*, /health, /).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Ecolink.WebApi and FastAPI AI Service (src/Ecolink.AiService/app.py, 16 endpoints) are running.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Models_ReturnsNonEmptyList</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify querying the full Rule Engine waste sorting rules via GET /api/v1/waste-scan/rules.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/waste-scan/rules.&#10;2. Inspect rule structures for all 10 canonical waste categories (plastic, paper, cardboard, glass, metal, battery, biological, clothes, shoes, trash).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- Each category contains complete guidance from WasteRuleEngineService: categoryName, standardBinColor, isRecyclable, preparationSteps, handlingAction, hazardWarning / corresponding Rule Engine ruleset.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">WasteRuleEngineService ruleset (10 DefaultSeeds) is initialized in DI container.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Rules_ReturnsNonEmptyJson</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify retrieving system standard recyclable categories via GET /api/v1/waste-categories.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/waste-categories.&#10;2. Cross-check returned categories against the waste_categories table in PostgreSQL.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, success = true.&#10;- data list contains standard categories (plastic, paper, cardboard, glass, metal) with id, code, name, standardBinColor, isRecyclable.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">waste_categories table is seeded with standard data.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">RecyclerHelper.GetCategoriesAsync</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 2.2: AI Image Classification &amp; OOD Confidence Gate (POST /api/v1/waste-scan/classify)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify successful waste image classification with the default model (POST /api/v1/waste-scan/classify) and complete Rule Engine guidance mapping.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Generate a valid 64x64 PNG image (image/png) and package it into MultipartFormDataContent under field file.&#10;2. Send POST /api/v1/waste-scan/classify.&#10;3. Inspect JSON response structure.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- Returns classification result with predictedClass/category, confidence, recommended bin color, and pre-sale preparation instructions.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Ecolink.WebApi and FastAPI AI Service are running.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithDefaultModel_ReturnsExpectedShape</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify waste image classification when explicitly specifying AI model name (modelName) from /models list.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Call GET /api/v1/waste-scan/models to retrieve the first model name.&#10;2. Send POST /api/v1/waste-scan/classify with file (PNG image) and modelName field.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- AI Service executes inference using the explicitly specified model and returns a valid result.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">AI model catalog contains at least 1 active model.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithExplicitModel_Succeeds</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify predicted confidence probability boundary is always within the normalized interval [0.0, 1.0].</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Submit PNG image via POST /api/v1/waste-scan/classify.&#10;2. Read confidence value from prediction result.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- Floating-point confidence satisfies 0.0 &lt;= confidence &lt;= 1.0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_PredictionConfidence_IsBetween0And1</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify classification request without an attached image file is blocked (BR-AI-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create MultipartFormDataContent containing only modelName=&quot;default&quot; without the file field.&#10;2. Send POST /api/v1/waste-scan/classify.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request.&#10;- Error message requests attaching a valid image file.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithoutFile_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify classification request with an empty (0-byte) image file is blocked.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Create MultipartFormDataContent with a 0-byte file field (empty.png).&#10;2. Send POST /api/v1/waste-scan/classify.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithEmptyFile_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify uploading a non-image .txt text file is rejected (BR-AI-01).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Package byte array &quot;day khong phai la anh&quot; with Content-Type: text/plain, filename note.txt.&#10;2. Send POST /api/v1/waste-scan/classify.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 4xx Client Error (400 Bad Request or 415 Unsupported Media Type).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithNonImageFile_ReturnsClientError</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify resilience when submitting a byte-corrupted PNG file (corrupted.png) does not crash the server with 500.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Package random bytes with invalid PNG header while setting Content-Type: image/png.&#10;2. Send POST /api/v1/waste-scan/classify.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- System handles exception safely (HTTP Status &lt; 500, never throws 500 Internal Server Error).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithCorruptedImage_DoesNotCauseServerError</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify rejection when passing a nonexistent modelName or sending application/json instead of multipart/form-data.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/waste-scan/classify with modelName=&quot;nonexistent_model_xyz&quot;.&#10;2. Send POST /api/v1/waste-scan/classify with JSON body {&quot;file&quot;:&quot;abc&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 4xx Client Error.&#10;- Step 2: returns 400 Bad Request or 415 Unsupported Media Type.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Classify_WithUnknownModel_ReturnsClientError &amp; Classify_WithJsonInsteadOfMultipart_Returns400Or415</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 2.3: User Classification Feedback &amp; Public Access (POST /api/v1/waste-scan/feedback)</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify submitting AI classification correction feedback (POST /api/v1/waste-scan/feedback) succeeds with full or minimal payload.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/waste-scan/feedback with {&quot;imageName&quot;:&quot;test.png&quot;,&quot;predictedClass&quot;:&quot;plastic&quot;,&quot;actualClass&quot;:&quot;glass&quot;,&quot;confidence&quot;:0.42,&quot;comment&quot;:&quot;Clear glass bottle&quot;}.&#10;2. Send a follow-up request with minimal payload {&quot;comment&quot;:&quot;ok&quot;}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both requests return HTTP Status 200 OK.&#10;- Feedback is recorded for model retraining.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Feedback_WithValidData_ReturnsOk &amp; Feedback_WithSingleField_ReturnsOk</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-013</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify feedback submission is rejected when confidence has wrong type, malformed JSON, or missing body.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send POST /api/v1/waste-scan/feedback with {&quot;confidence&quot;:&quot;not-a-number&quot;}.&#10;2. Send malformed JSON &quot;{not valid json&quot; or empty body.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- All cases return HTTP Status 400 Bad Request (or 415).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Feedback_WithWrongTypeForConfidence_Returns400 &amp; Feedback_WithMalformedJson_Returns400</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-014</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify End-to-End integration flow: Capture/Scan waste image (POST /classify) -&gt; Extract predicted label -&gt; Submit correction feedback (POST /feedback).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Submit PNG image via POST /api/v1/waste-scan/classify and extract predictedClass and confidence.&#10;2. Use those extracted results to send POST /api/v1/waste-scan/feedback with actualClass=&quot;paper&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1 returns 200 OK with predicted label.&#10;- Step 2 returns 200 OK, completing the closed-loop AI Scan -&gt; Data Contribution workflow.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Ecolink.WebApi and FastAPI AI Service are running.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.ClassifyThenFeedback_EndToEndFlow</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-AI-015</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify Public authorization (GET /models, GET /rules), authenticated endpoints (POST /classify, POST /feedback), and invalid JWT fault tolerance across all 4 endpoints.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /models, GET /rules without token and send POST /classify, POST /feedback without token.&#10;2. Call all 4 endpoints with header Authorization: Bearer invalid.fake.token.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- GET /models, GET /rules succeed publicly (200 OK); POST /classify, POST /feedback require login (401 Unauthorized when missing token).&#10;- With forged token on all 4 endpoints: system handles safely and never throws 500 Internal Server Error.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally ([Authorize] applied on ClassifyImage &amp; SubmitFeedback).</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">WasteScanTests.Endpoint_WithInvalidToken_DoesNotCauseServerError</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 2.4: Personal Scan History, Master Categories &amp; Rule Engine Publish (STT 025-031)</Data></Cell>
