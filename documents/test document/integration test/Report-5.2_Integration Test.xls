   <Row ss:Index="10" ss:Height="28">
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Description</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Test Case Procedure</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Results</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Pre-conditions</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 1</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 2</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Round 3</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Defect IDs</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Note</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 5.1: Spatial Radius Search &amp; Coordinate Validation (GET /api/v1/recyclers/nearby)</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify searching recyclers around Hoa Lac Hi-Tech Park coordinates (21.0124, 105.5253, radius 15km) returns results sorted ascending by distance (BR-MTH-04).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Ensure sample facility is Online (EnsureBaselineAsync).&#10;2. Send GET /api/v1/recyclers/nearby?lat=21.0124&amp;lng=105.5253&amp;radiusKm=15.&#10;3. Verify distanceKm ordering of items in data.items.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-GEN-01&quot;.&#10;- data.totalFound &gt;= 1.&#10;- Facilities in data.items are sorted ascending by distanceKm and all satisfy 0 &lt;= distanceKm &lt;= 15.0.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Verified + Online facility exists around Hoa Lac area in DB.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC01_SearchNearby_ValidHoaLacCoordinates_ReturnsVerifiedOnlineRecyclersSortedByDistanceAsc</Data></Cell>
   </Row>
   <Row ss:Height="92">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking query when coordinates are (0, 0) (GPS permission not granted) returning error code MSG-MTH-02.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/nearby?lat=0&amp;lng=0&amp;radiusKm=10.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request.&#10;- success = false, messageCode = &quot;MSG-MTH-02&quot;.&#10;- Message: &quot;Location access is required to find nearby recyclers. Please enable it in settings.&quot;</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC02_SearchNearby_InvalidCoordinatesRadiusOrCategory_Returns400WithMsgMth02</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking query when latitude or longitude exceeds standard WGS84 bounds (lat &gt; 90 or lng &lt; -180).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/nearby?lat=95.5&amp;lng=105.5253&amp;radiusKm=10.&#10;2. Send with lat=21.0124&amp;lng=-185.0&amp;radiusKm=10.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 400 Bad Request with messageCode = &quot;MSG-MTH-02&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC02_SearchNearby_InvalidCoordinatesRadiusOrCategory_Returns400WithMsgMth02</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify search radius boundary values (radiusKm &lt; 0.5 or radiusKm &gt; 50.0) are blocked by NearbyRecyclerFilterValidator (BR-MTH-05).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/nearby?lat=21.0124&amp;lng=105.5253&amp;radiusKm=0.2 (below 0.5km minimum).&#10;2. Send with radiusKm=65.0 (above 50km maximum).</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Both cases return HTTP Status 400 Bad Request, messageCode = &quot;MSG-MTH-02&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC02_SearchNearby_InvalidCoordinatesRadiusOrCategory_Returns400WithMsgMth02</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-005</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify blocking filter by non-recyclable waste category (category=trash) or nonexistent category code.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/nearby?lat=21.0124&amp;lng=105.5253&amp;radiusKm=10&amp;category=trash.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 400 Bad Request, messageCode = &quot;MSG-MTH-02&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">System is operating normally.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC02_SearchNearby_InvalidCoordinatesRadiusOrCategory_Returns400WithMsgMth02</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 5.2: Category Filtering, Price Sorting &amp; Fallback Suggestion (GET /api/v1/recyclers/nearby)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-006</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify filtering facilities by waste category (category=metal) combined with descending unit price sort (sortBy=price_desc - BR-MTH-07).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/nearby?lat=21.0124&amp;lng=105.5253&amp;radiusKm=20&amp;category=metal&amp;sortBy=price_desc.&#10;2. Inspect materials list and metal prices of returned facilities.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK.&#10;- All returned facilities purchase metal (isActive = true).&#10;- List is sorted descending by metal pricePerKg.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">At least 2 metal-purchasing facilities exist within 20km radius.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC03_SearchNearby_FilterByCategoryAndSortByPriceDesc_ReturnsMatchingFacilitiesOrderedByPrice</Data></Cell>
   </Row>
   <Row ss:Height="106">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-007</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify zero-result response within radius (totalFound = 0) returns MSG-MTH-01 with fallbackSuggestion expanding radius by 2.5x and sorting guide.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/nearby?lat=15.0000&amp;lng=112.0000&amp;radiusKm=4&amp;category=paper (offshore coordinates with no facilities).&#10;2. Inspect messageCode and data.fallbackSuggestion object.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-MTH-01&quot;.&#10;- data.totalFound = 0, data.items = [].&#10;- data.fallbackSuggestion.suggestedExpandedRadiusKm = 10.0 (4 * 2.5), allowCommunityPickupPost = true, publicBinSortingGuide.categoryCode = &quot;paper&quot;.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">No facilities exist near coordinates (15.0, 112.0).</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC04_SearchNearby_ZeroResultsInRadius_ReturnsMsgMth01AndFallbackSuggestion</Data></Cell>
   </Row>
   <Row ss:Height="148">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-008</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cross-Module Integration (M4 -&gt; M5): When a facility toggles Online/Offline in Module 4, map search results in Module 5 reflect the change immediately (BR-MTH-02).</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Retrieve collector coordinates from GET /api/v1/recycler/profile.&#10;2. Call PATCH /api/v1/recycler/availability ({&quot;isOnline&quot;: false}) to go Offline, then call GET /api/v1/recyclers/nearby at those coordinates.&#10;3. Call PATCH /api/v1/recycler/availability ({&quot;isOnline&quot;: true}) to go back Online, then call GET /api/v1/recyclers/nearby again.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 2 (when Offline): collector ID disappears immediately from data.items.&#10;- Step 3 (when back Online): collector ID reappears immediately in data.items.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector account is Verified and has an active price list.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC05_CrossModule_WhenRecyclerTogglesAvailability_DiscoveryReflectsOnlineStatusImmediately</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:MergeAcross="9" ss:StyleID="MethodRow"><Data ss:Type="String">Function 5.3: Public Recycler Detail, Trade Partners &amp; Geocoding Proxy (GET /recyclers/{id}, /trade/partners/nearby, /geocoding/search)</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-009</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify viewing public profile page of a specific recycler on the map (GET /api/v1/recyclers/{recyclerId}) with distance calculation from user location.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Retrieve collector facility&apos;s userId.&#10;2. Send GET /api/v1/recyclers/{userId}?lat=21.0124&amp;lng=105.5253.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, messageCode = &quot;MSG-GEN-01&quot;.&#10;- Returns complete id, facilityName, address, distanceKm &gt;= 0, openingHours, and listed materials price table.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">collector facility is in Verified status.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC06_GetRecyclerPublicDetail_ValidVerifiedRecycler_ReturnsProfilePricesAndDistanceKm</Data></Cell>
   </Row>
   <Row ss:Height="50">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-010</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify querying public detail with a nonexistent recyclerId returns 404 Not Found.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/recyclers/{Guid.NewGuid()}.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 404 Not Found, success = false.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Random Guid does not exist in recycler_profiles table.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC07_GetRecyclerPublicDetail_NonExistentId_Returns404NotFound</Data></Cell>
   </Row>
   <Row ss:Height="64">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-011</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify searching direct purchase trade partners via GET /api/v1/trade/partners/nearby.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/trade/partners/nearby?lat=21.0124&amp;lng=105.5253&amp;category=plastic&amp;radiusKm=15.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- HTTP Status: 200 OK, success = true.&#10;- data array returns plastic-purchasing trade partners within 15km radius.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">Online plastic-purchasing facility exists in Hoa Lac.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC08_TradePartnersNearby_AndGeocodingProxy_ValidateAndReturnExpectedEnvelopes</Data></Cell>
   </Row>
   <Row ss:Height="78">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ITC-DSC-012</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Verify Geocoding Proxy (GET /api/v1/geocoding/search) blocks too-short queries (&lt; 2 chars) and returns coordinates for valid place names.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Send GET /api/v1/geocoding/search?q=a (1 char).&#10;2. Send GET /api/v1/geocoding/search?q=Hoa+Lac&amp;limit=3.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">- Step 1: returns 400 Bad Request, messageCode = &quot;MSG-GEN-01&quot;.&#10;- Step 2: returns 200 OK, success = true, data.items is an array of place results.</Data></Cell>
    <Cell ss:StyleID="DataCellItalic"><Data ss:Type="String">IGeocodingProxyService is configured in Ecolink.WebApi.</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Passed</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="DataCellCenter"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DiscoveryTests.DSC08_TradePartnersNearby_AndGeocodingProxy_ValidateAndReturnExpectedEnvelopes</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ==================== SHEET 9: M06_Handover ==================== -->
 <Worksheet ss:Name="M06_Handover">
  <Table>
   <Column ss:Width="95"/>
