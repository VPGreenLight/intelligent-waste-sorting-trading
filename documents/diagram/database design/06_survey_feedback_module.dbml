// ============================================================================
// ECOLINK DBML - MODULE 6: SURVEY & CUSTOMER FEEDBACK (KHẢO SÁT CHẤT LƯỢNG ĐỊNH KỲ)
// Standalone DBML file for dbdiagram.io
// Features: Periodic Service Surveys, Multi-type Questions, Anonymous Aggregation
// ============================================================================

Enum target_role {
  User [note: "Áp dụng cho Citizen"]
  Recycler [note: "Áp dụng cho Vựa phế liệu"]
  All [note: "Áp dụng toàn bộ"]
}

Enum survey_status {
  Draft [note: "Bản nháp"]
  Active [note: "Đang mở nhận ý kiến"]
  Closed [note: "Đã đóng đợt khảo sát"]
}

Enum question_type {
  Rating_1_5 [note: "Chấm điểm 1 đến 5 sao"]
  Multiple_Choice [note: "Trắc nghiệm nhiều lựa chọn"]
  Text [note: "Ý kiến đóng góp tự do"]
}

// ----------------------------------------------------------------------------
// CÁC BẢNG NỘI BỘ MODULE 6
// ----------------------------------------------------------------------------

Table Survey {
  survey_id bigint [pk, increment]
  title varchar(200) [not null, note: "Tiêu đề đợt khảo sát"]
  description text [note: "Mục đích khảo sát dịch vụ"]
  target_role target_role [not null, default: 'All', note: "User, Recycler, All"]
  status survey_status [not null, default: 'Draft']
  start_date timestamptz [not null]
  end_date timestamptz [not null]
  created_by_staff_id bigint [not null, ref: > StaffProfile_Stub.staff_id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Đợt khảo sát định kỳ chất lượng dịch vụ nền tảng (BR-RVW-04)"
}

Table SurveyQuestion {
  question_id bigint [pk, increment]
  survey_id bigint [not null, ref: > Survey.survey_id]
  question_text text [not null, note: "Nội dung câu hỏi"]
  question_type question_type [not null, note: "Rating_1_5, Multiple_Choice, Text"]
  options text [note: "JSON danh sách các lựa chọn trắc nghiệm"]
  order_index int [not null, default: 0, note: "Thứ tự câu hỏi"]
  is_required boolean [not null, default: true]

  Note: "Danh sách câu hỏi trong bảng khảo sát"
}

Table SurveyResponse {
  response_id bigint [pk, increment]
  survey_id bigint [not null, ref: > Survey.survey_id]
  user_id bigint [not null, ref: > User_Stub.user_id]
  answers text [not null, note: "JSON chứa câu trả lời phục vụ tổng hợp ẩn danh (BR-RVW-05)"]
  submitted_at timestamptz [not null, default: `now()`]

  indexes {
    (survey_id, user_id) [unique]
  }

  Note: "Kết quả trả lời khảo sát ẩn danh của người dùng (BR-RVW-05)"
}

// ----------------------------------------------------------------------------
// BẢNG THAM CHIẾU NGOÀI (EXTERNAL STUBS)
// ----------------------------------------------------------------------------

Table User_Stub as "User (Auth Module)" {
  user_id bigint [pk, note: "Tham chiếu từ Phân hệ Auth"]
  full_name varchar
}

Table StaffProfile_Stub as "StaffProfile (Auth Module)" {
  staff_id bigint [pk, note: "Tham chiếu từ Phân hệ Auth"]
  staff_code varchar
}

TableGroup Survey_Feedback_Module {
  Survey
  SurveyQuestion
  SurveyResponse
}
