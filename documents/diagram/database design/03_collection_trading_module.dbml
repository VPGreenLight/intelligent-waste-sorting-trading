// ============================================================================
// ECOLINK DBML - MODULE 3: COLLECTION & TRADING (THU GOM, THƯƠNG LƯỢNG & BÀN GIAO)
// Standalone DBML file for dbdiagram.io
// Features: Handover Flow, Proposed Time Slots, Chat Negotiation, Receipts, 2-Way Reviews
// ============================================================================

Enum request_status {
  Pending [note: "Chờ cơ sở thu mua phản hồi"]
  Negotiating [note: "Đang thương lượng giá / khung giờ qua chat"]
  Accepted [note: "Đã chấp nhận và chốt lịch thu gom"]
  Scheduled [note: "Đang trên đường đến thu gom"]
  Completed [note: "Đã hoàn tất giao dịch và cấp điểm"]
  Rejected [note: "Cơ sở từ chối yêu cầu"]
  Cancelled [note: "Một trong hai bên hủy hẹn"]
  Disputed [note: "Đang có khiếu nại tranh chấp"]
  Expired [note: "Hết hạn phản hồi"]
}

Enum message_type {
  TEXT [note: "Tin nhắn văn bản"]
  IMAGE [note: "Ảnh chụp bằng chứng"]
  PROPOSAL [note: "Đề nghị giá mới hoặc đổi khung giờ thu gom"]
  SYSTEM [note: "Thông báo hệ thống trong cuộc hội thoại"]
}

Enum review_status {
  Visible [note: "Hiển thị công khai"]
  Hidden [note: "Bị ẩn do vi phạm tiêu chuẩn (BR-RVW-03)"]
  Reported [note: "Bị cộng đồng báo cáo"]
  Deleted [note: "Tác giả tự xóa"]
}

Enum complaint_status {
  Pending [note: "Chờ nhân viên tiếp nhận"]
  Investigating [note: "Đang xác minh hai chiều"]
  Resolved [note: "Đã ra phán quyết giải quyết"]
  Dismissed [note: "Bác bỏ khiếu nại"]
}

Enum complaint_outcome {
  User_Compensated [note: "Khuyến nghị Recycler bồi hoàn cho User"]
  Dismissed [note: "Bác bỏ khiếu nại, giữ nguyên kết quả"]
  Warning_Issued [note: "Cảnh cáo tài khoản vi phạm"]
}

// ----------------------------------------------------------------------------
// CÁC BẢNG NỘI BỘ MODULE 3
// ----------------------------------------------------------------------------

Table RecyclerPriceList {
  price_id bigint [pk, increment]
  recycler_id bigint [not null, ref: > RecyclerProfile_Stub.recycler_id, note: "Cơ sở áp dụng mức giá này"]
  category_id bigint [not null, ref: > MasterWasteCategory_Stub.category_id, note: "Loại phế liệu thu mua"]
  price_per_kg numeric(12,2) [not null, note: "Giá thu mua tham chiếu (VNĐ/kg)"]
  min_quantity_kg numeric(12,3) [not null, default: 1.000, note: "Khối lượng tối thiểu nhận gom"]
  effective_from timestamptz [not null, default: `now()`, note: "Thời điểm giá bắt đầu hiệu lực"]
  effective_to timestamptz [note: "Thời điểm hết hạn (null = vô thời hạn)"]
  status varchar(20) [not null, default: 'ACTIVE']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (recycler_id, category_id) [unique]
  }

  Note: "Bảng giá thu mua phế liệu công khai của từng vựa ve chai"
}

Table HandoverRequest {
  request_id bigint [pk, increment]
  request_code varchar(50) [not null, unique, note: "Mã đơn hàng: HND-2026-XXXX"]
  user_id bigint [not null, ref: > User_Stub.user_id, note: "Công dân tạo đơn thu gom"]
  recycler_id bigint [not null, ref: > RecyclerProfile_Stub.recycler_id, note: "Vựa ve chai nhận gom"]
  pickup_address text [not null, note: "Địa chỉ đến lấy phế liệu"]
  latitude numeric(10,7) [note: "Vĩ độ địa chỉ gom"]
  longitude numeric(11,7) [note: "Kinh độ địa chỉ gom"]
  geom text [note: "PostGIS Geometry(Point, 4326) phục vụ dẫn đường thu gom"]
  waste_photo_url text [note: "Ảnh chụp đống phế liệu người dân tải lên"]
  proposed_time_slot timestamptz [not null, note: "Khung giờ User đề xuất khi tạo đơn (BR-NEG-04)"]
  confirmed_time_slot timestamptz [note: "Khung giờ chốt chính thức khi Recycler ấn Accept (BR-NEG-05)"]
  actual_handover_at timestamptz [note: "Thời điểm hai bên gặp mặt thực tế"]
  status request_status [not null, default: 'Pending', note: "Luồng trạng thái 1 chiều (BR-HND-02)"]
  user_note text [note: "Chỉ dẫn đường vào hẻm/nhà"]
  recycler_note text [note: "Ghi chú của người thu mua"]
  cancel_reason text [note: "Lý do hủy đơn hoặc từ chối (UC U-07, R-04)"]
  cancelled_by bigint [ref: > User_Stub.user_id, note: "Bên thực hiện thao tác hủy"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status, created_at)
    (recycler_id, status, created_at)
  }

  Note: "Yêu cầu bàn giao phế liệu tích hợp thỏa thuận khung giờ thu gom"
}

Table HandoverRequestItem {
  item_id bigint [pk, increment]
  request_id bigint [not null, ref: > HandoverRequest.request_id, note: "Thuộc đơn bàn giao nào"]
  category_id bigint [not null, ref: > MasterWasteCategory_Stub.category_id, note: "Loại phế liệu gom"]
  estimated_weight_kg numeric(12,3) [not null, default: 0.000, note: "Khối lượng User ước tính (kg)"]
  actual_weight_kg numeric(12,3) [note: "Khối lượng Recycler đo thực tế tại chỗ (kg)"]
  agreed_price_per_kg numeric(12,2) [note: "Đơn giá đã chốt thương lượng (VNĐ/kg)"]
  item_note text [note: "Ghi chú phân loại phế liệu"]
  created_at timestamptz [not null, default: `now()`]

  Note: "Chi tiết các loại phế liệu trong một đơn thu gom"
}

Table ChatMessage {
  message_id bigint [pk, increment]
  request_id bigint [not null, ref: > HandoverRequest.request_id, note: "Thuộc đơn giao dịch nào"]
  sender_user_id bigint [not null, ref: > User_Stub.user_id, note: "Bên gửi tin nhắn"]
  message_type message_type [not null, default: 'TEXT', note: "TEXT, IMAGE, PROPOSAL, SYSTEM"]
  message_content text [note: "Nội dung văn bản"]
  attachment_url text [note: "Ảnh đính kèm trên R2"]
  proposal_data text [note: "JSON cấu trúc giá mới hoặc giờ mới để hiển thị tương tác"]
  is_read boolean [not null, default: false]
  sent_at timestamptz [not null, default: `now()`, note: "Lưu vĩnh viễn làm bằng chứng (BR-NEG-01)"]
  read_at timestamptz

  indexes {
    (request_id, sent_at)
  }

  Note: "Tin nhắn thương lượng giá & lịch hẹn trực tiếp giữa 2 bên qua SignalR"
}

Table HandoverReceipt {
  receipt_id bigint [pk, increment]
  request_id bigint [not null, unique, ref: - HandoverRequest.request_id, note: "1 đơn gom có đúng 1 biên lai hoàn tất"]
  receipt_code varchar(50) [not null, unique, note: "Mã biên lai: RCP-2026-XXXX"]
  user_id bigint [not null, ref: > User_Stub.user_id, note: "Công dân nhận tiền"]
  recycler_id bigint [not null, ref: > RecyclerProfile_Stub.recycler_id, note: "Vựa chi trả tiền mặt"]
  total_weight_kg numeric(12,3) [not null, note: "Tổng khối lượng thực tế đã cân (kg)"]
  total_amount_cash numeric(14,2) [not null, note: "Tổng tiền mặt thanh toán trực tiếp (VNĐ)"]
  points_awarded bigint [not null, default: 0, note: "Điểm xanh thưởng cấp cho cả hai bên (BR-GAM-01)"]
  scale_proof_photo_url text [not null, note: "Ảnh chụp màn hình cân đo thực tế (BR-HND-04)"]
  receipt_image_url text [note: "Ảnh hóa đơn/phiếu ký tay"]
  created_at timestamptz [not null, default: `now()`, note: "Thời điểm Recycler lập biên nhận"]
  confirmed_by_user_at timestamptz [not null, note: "Thời điểm User bấm xác nhận chốt giao dịch"]

  Note: "Biên lai hoàn tất bàn giao phế liệu và ghi nhận khối lượng thực tế"
}

Table TransactionReview {
  review_id bigint [pk, increment]
  request_id bigint [not null, ref: > HandoverRequest.request_id, note: "Đơn giao dịch được đánh giá"]
  reviewer_id bigint [not null, ref: > User_Stub.user_id, note: "Bên thực hiện đánh giá (User hoặc Recycler)"]
  reviewee_id bigint [not null, ref: > User_Stub.user_id, note: "Bên nhận đánh giá"]
  rating_stars smallint [not null, note: "Số sao từ 1 đến 5 (BR-RVW-02)"]
  comment text [note: "Nhận xét thái độ và độ chuẩn xác"]
  status review_status [not null, default: 'Visible', note: "Visible, Hidden, Reported, Deleted (BR-RVW-03)"]
  moderated_by bigint [ref: > User_Stub.user_id, note: "Staff/Admin ẩn bài nếu vi phạm tiêu chuẩn"]
  moderation_reason text [note: "Lý do kiểm duyệt ẩn đánh giá"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (request_id, reviewer_id) [unique]
  }

  Note: "Đánh giá 2 chiều có cơ chế kiểm duyệt nội dung độc hại (BR-RVW-01/03)"
}

Table TransactionComplaint {
  complaint_id bigint [pk, increment]
  request_id bigint [not null, ref: > HandoverRequest.request_id, note: "Đơn xảy ra tranh chấp"]
  submitted_by bigint [not null, ref: > User_Stub.user_id, note: "Bên đứng đơn khiếu nại (BR-DSP-01)"]
  complaint_type varchar(50) [not null, note: "Lý do: Sai khối lượng, Ép giá, Thái độ xấu"]
  description text [not null, note: "Nội dung tường trình chi tiết sự việc"]
  evidence_url text [note: "Ảnh chụp chứng cứ sai lệch"]
  status complaint_status [not null, default: 'Pending', note: "Pending, Investigating, Resolved, Dismissed"]
  assigned_staff_id bigint [ref: > StaffProfile_Stub.staff_id, note: "Staff được giao thụ lý hồ sơ"]
  resolution_outcome complaint_outcome [note: "Kết quả phán quyết ràng buộc (BR-DSP-04)"]
  resolution_note text [note: "Giải trình quyết định của Staff"]
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz [note: "Thời điểm giải quyết xong"]

  Note: "Xử lý khiếu nại giao dịch do Staff làm trọng tài phân xử"
}

// ----------------------------------------------------------------------------
// BẢNG THAM CHIẾU NGOÀI (EXTERNAL STUBS)
// ----------------------------------------------------------------------------

Table User_Stub as "User (Auth Module)" {
  user_id bigint [pk, note: "Tham chiếu từ Phân hệ Auth"]
  full_name varchar
}

Table RecyclerProfile_Stub as "RecyclerProfile (Auth Module)" {
  recycler_id bigint [pk, note: "Tham chiếu từ Phân hệ Auth"]
  facility_name varchar
}

Table StaffProfile_Stub as "StaffProfile (Auth Module)" {
  staff_id bigint [pk, note: "Tham chiếu từ Phân hệ Auth"]
  staff_code varchar
}

Table MasterWasteCategory_Stub as "MasterWasteCategory (AI Module)" {
  category_id bigint [pk, note: "Tham chiếu từ Phân hệ AI"]
  category_name varchar
}

TableGroup Collection_Trading_Module {
  RecyclerPriceList
  HandoverRequest
  HandoverRequestItem
  ChatMessage
  HandoverReceipt
  TransactionReview
  TransactionComplaint
}
