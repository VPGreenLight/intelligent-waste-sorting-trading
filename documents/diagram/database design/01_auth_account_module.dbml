// ============================================================================
// ECOLINK DBML - MODULE 1: ACCOUNTS & AUTHENTICATION (TÀI KHOẢN & PHÂN QUYỀN)
// Standalone DBML file for dbdiagram.io
// Features: Core User, Recycler Profile (PostGIS), Staff Profile & Permissions
// ============================================================================

Enum user_role {
  User [note: "Công dân phân loại và bán phế liệu"]
  Recycler [note: "Cơ sở thu mua / Vựa ve chai"]
  Staff [note: "Nhân viên vận hành hệ thống"]
  Admin [note: "Quản trị viên cấp cao"]
}

Enum user_status {
  Active [note: "Đang hoạt động"]
  Locked [note: "Khóa tạm thời do sai mật khẩu (BR-AUTH-04)"]
  Suspended [note: "Đình chỉ do vi phạm quy chuẩn"]
  Pending_Verification [note: "Chờ xác minh email"]
}

Enum verification_status {
  Pending [note: "Chờ duyệt hồ sơ thẩm định"]
  Verified [note: "Đã thẩm định thành công"]
  Rejected [note: "Bị từ chối (kèm lý do)"]
}

Enum active_status {
  Online [note: "Đang mở cửa nhận thu gom trên bản đồ GPS (UC R-02)"]
  Offline [note: "Tạm dừng hoạt động / Nghỉ"]
}

Table User {
  user_id bigint [pk, increment, note: "ID duy nhất của tài khoản"]
  username varchar(50) [not null, unique, note: "Tên đăng nhập hệ thống"]
  password_hash varchar(255) [note: "Mật khẩu mã hóa BCrypt; null nếu dùng Google OAuth"]
  full_name varchar(100) [not null, note: "Họ và tên hiển thị"]
  email varchar(255) [not null, unique, note: "Email định danh duy nhất (BR-AUTH-01)"]
  phone_number varchar(20) [note: "Số điện thoại liên lạc"]
  avatar_url text [note: "Ảnh đại diện trên Cloudflare R2"]
  role user_role [not null, default: 'User', note: "Vai trò người dùng"]
  is_google_auth boolean [not null, default: false, note: "Xác thực qua Google OAuth (BR-AUTH-02)"]
  status user_status [not null, default: 'Active', note: "Trạng thái hoạt động tài khoản"]
  failed_login_attempts int [not null, default: 0, note: "Đếm số lần đăng nhập sai (BR-AUTH-04)"]
  lockout_until timestamptz [note: "Thời điểm hết hạn khóa tài khoản tạm thời"]
  created_at timestamptz [not null, default: `now()`, note: "Thời điểm đăng ký tài khoản"]
  updated_at timestamptz [not null, default: `now()`, note: "Thời điểm cập nhật gần nhất"]

  Note: "Bảng người dùng cốt lõi đại diện cho mọi tác nhân trong hệ thống"
}

Table RecyclerProfile {
  recycler_id bigint [pk, ref: - User.user_id, note: "Khóa chính 1-1 với User"]
  facility_name varchar(150) [not null, note: "Tên cơ sở thu mua / vựa ve chai"]
  representative_name varchar(100) [note: "Tên người đại diện pháp luật"]
  business_address text [not null, note: "Địa chỉ cơ sở kinh doanh thực tế"]
  latitude numeric(10,7) [not null, note: "Vĩ độ GPS"]
  longitude numeric(11,7) [not null, note: "Kinh độ GPS"]
  geom text [not null, note: "PostGIS Geometry(Point, 4326) phục vụ tìm kiếm bán kính ST_DWithin"]
  operating_hours varchar(100) [note: "Giờ mở cửa thu gom (Ví dụ: 08:00 - 18:00)"]
  contact_phone varchar(20) [not null, note: "Hotline thu gom"]
  description text [note: "Giới thiệu năng lực phương tiện và trang thiết bị"]
  legal_permit_url text [note: "Giấy phép kinh doanh/môi trường nộp cho Staff thẩm định (UC G-03, S-04)"]
  business_photo_url text [note: "Ảnh chụp mặt tiền cơ sở thu mua"]
  verification_status verification_status [not null, default: 'Pending', note: "Trạng thái duyệt hồ sơ của Staff"]
  active_status active_status [not null, default: 'Offline', note: "Bật/Tắt hiển thị trên bản đồ GPS (UC R-02)"]
  rejection_reason text [note: "Lý do Staff từ chối duyệt cơ sở (BR-MTH-02, MSG-MTH-05)"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Hồ sơ đối tác thu gom ve chai, tích hợp dữ liệu không gian PostGIS"
}

Table StaffProfile {
  staff_id bigint [pk, ref: - User.user_id, note: "Khóa chính 1-1 với User"]
  staff_code varchar(30) [not null, unique, note: "Mã nhân viên (VD: STF-2026-001)"]
  department varchar(100) [note: "Phòng ban công tác"]
  position varchar(100) [note: "Chức vụ đảm nhiệm"]
  status varchar(20) [not null, default: 'ACTIVE', note: "Trạng thái công tác"]
  created_at timestamptz [not null, default: `now()`]

  Note: "Hồ sơ nhân viên vận hành hệ thống Back-office"
}

Table StaffPermissionAssignment {
  assignment_id bigint [pk, increment]
  staff_id bigint [not null, ref: > StaffProfile.staff_id, note: "Nhân viên được cấp quyền"]
  permission_code varchar(50) [not null, note: "Mã quyền: REVIEW_AI, HANDLE_COMPLAINT, VERIFY_RECYCLER, MANAGE_BLOG, MANAGE_INVENTORY"]
  granted_by bigint [not null, ref: > User.user_id, note: "Admin đã phân quyền"]
  granted_at timestamptz [not null, default: `now()`]

  indexes {
    (staff_id, permission_code) [unique]
  }

  Note: "Phân quyền chi tiết cho Staff theo UC A-04 và BR-ADM-02"
}

Table PasswordResetToken {
  token_id bigint [pk, increment]
  user_id bigint [not null, ref: > User.user_id]
  token_hash varchar(255) [not null, unique, note: "Token băm bảo mật gửi qua Email"]
  expires_at timestamptz [not null, note: "Thời điểm hết hạn (BR-AUTH-06)"]
  used_at timestamptz [note: "Thời điểm đã sử dụng (dùng 1 lần duy nhất)"]
  created_at timestamptz [not null, default: `now()`]

  Note: "Quản lý mã OTP/Link đặt lại mật khẩu an toàn"
}

TableGroup Auth_Module {
  User
  RecyclerProfile
  StaffProfile
  StaffPermissionAssignment
  PasswordResetToken
}
