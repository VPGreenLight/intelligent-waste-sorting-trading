// ============================================================================
// ECOLINK DBML - MODULE 4: SERVICE PACKAGES & PAYMENT (DỊCH VỤ & THANH TOÁN VIETQR)
// Standalone DBML file for dbdiagram.io
// Features: Internal Service Packages, Dynamic VietQR Generation, PayOS Reconciliation
// ============================================================================

Enum target_role {
  User [note: "Áp dụng cho Citizen"]
  Recycler [note: "Áp dụng cho Vựa phế liệu"]
  All [note: "Áp dụng toàn bộ"]
}

Enum order_status {
  Pending [note: "Chờ thanh toán qua mã VietQR"]
  Paid [note: "Thanh toán thành công và kích hoạt gói"]
  Expired [note: "Mã QR hết hạn"]
  Cancelled [note: "Đơn bị hủy"]
}

Enum payment_status {
  Pending [note: "Đang chờ webhook ngân hàng"]
  Success [note: "Giao dịch khớp số tiền và mã đơn"]
  Failed [note: "Giao dịch thất bại"]
  Refunded [note: "Đã hoàn tiền"]
}

// ----------------------------------------------------------------------------
// CÁC BẢNG NỘI BỘ MODULE 4
// ----------------------------------------------------------------------------

Table ServicePackage {
  package_id bigint [pk, increment]
  package_code varchar(50) [not null, unique, note: "Mã gói: RECYCLER_VERIFIED_BADGE, NO_ADS_MONTHLY"]
  package_name varchar(100) [not null, note: "Tên gói dịch vụ"]
  target_role target_role [not null, default: 'All', note: "Đối tượng: User, Recycler, All"]
  description text [note: "Mô tả đặc quyền của gói"]
  price_vnd numeric(14,2) [not null, note: "Giá gói niêm yết (VNĐ)"]
  duration_days int [not null, note: "Thời hạn gói (30, 90, 365 ngày)"]
  features text [note: "JSON cấu hình đặc quyền mở khóa"]
  status varchar(20) [not null, default: 'ACTIVE', note: "ACTIVE, INACTIVE"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Gói tính năng trả phí của nền tảng (Tắt quảng cáo, Huy hiệu xác minh Tích xanh)"
}

Table ServiceOrder {
  order_id bigint [pk, increment]
  order_code varchar(50) [not null, unique, note: "Mã đơn hàng: SRV-2026-XXXX"]
  user_id bigint [not null, ref: > User_Stub.user_id, note: "Người thanh toán"]
  package_id bigint [not null, ref: > ServicePackage.package_id, note: "Gói dịch vụ đã mua"]
  amount_vnd numeric(14,2) [not null, note: "Số tiền cần thanh toán chính xác (VNĐ)"]
  payment_method varchar(30) [not null, default: 'VIETQR', note: "Phương thức VietQR động"]
  qr_payload text [note: "Chuỗi chuẩn EMVCo để render mã VietQR trên Frontend (BR-PAY-01)"]
  qr_code_url text [note: "Link ảnh mã QR từ PayOS/VietQR"]
  payment_reference varchar(255) [unique, note: "Mã tham chiếu ngân hàng/PayOS"]
  gateway_transaction_no varchar(100) [note: "Mã giao dịch thực tế trên cổng"]
  payment_status payment_status [not null, default: 'Pending']
  order_status order_status [not null, default: 'Pending']
  webhook_payload text [note: "Toàn bộ dữ liệu callback phục vụ đối soát Admin (UC A-11)"]
  paid_at timestamptz [note: "Thời điểm ghi nhận tiền vào tài khoản"]
  starts_at timestamptz [note: "Thời điểm kích hoạt gói"]
  expires_at timestamptz [note: "Thời điểm hết hạn gói"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    order_code
  }

  Note: "Đơn mua gói dịch vụ thanh toán qua VietQR động tự động kích hoạt"
}

// ----------------------------------------------------------------------------
// BẢNG THAM CHIẾU NGOÀI (EXTERNAL STUBS)
// ----------------------------------------------------------------------------

Table User_Stub as "User (Auth Module)" {
  user_id bigint [pk, note: "Tham chiếu từ Phân hệ Auth"]
  full_name varchar
  email varchar
}

TableGroup Payment_Service_Module {
  ServicePackage
  ServiceOrder
}
