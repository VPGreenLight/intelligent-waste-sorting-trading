        <mxCell id="line_db" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=none;strokeColor=#9e9e9e;" edge="1" parent="1" source="ll_db">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1485" y="1000" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="f_queue" value="[Giai đoạn 1: Tiếp nhận hàng đợi kiểm duyệt AI (SCR-STF-02)]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=360;height=25;fillColor=none;strokeColor=#0288d1;dashed=1;fontSize=11;fontColor=#0288d1;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="1560" height="370" as="geometry" />
        </mxCell>
        <mxCell value="1. Mở màn hình &#x27;Hàng đợi kiểm duyệt AI&#x27;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="140" as="sourcePoint" /><mxPoint x="305" y="140" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="2. GET /api/v1/staff/ai-curation/reports?status=Pending&amp;page=1&amp;size=20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="180" as="sourcePoint" /><mxPoint x="525" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="3. GetPendingReportsAsync(page, size, ct)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="525" y="220" as="sourcePoint" /><mxPoint x="745" y="220" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="4. GetPendingListAsync(page, size)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="260" as="sourcePoint" /><mxPoint x="985" y="260" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="5. SELECT r.*, s.image_url, c.category_name FROM misclassified_reports r ... WHERE r.status = &#x27;Pending&#x27;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="295" as="sourcePoint" /><mxPoint x="1485" y="295" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="6. Return List&lt;MisclassifiedReport&gt; kèm ImageUrl &amp; Label" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1485" y="330" as="sourcePoint" /><mxPoint x="985" y="330" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="7. Return reports" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="365" as="sourcePoint" /><mxPoint x="745" y="365" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="8. Return PagedResult&lt;CurationReportItemDto&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="400" as="sourcePoint" /><mxPoint x="525" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="9. 200 OK: ApiResponse&lt;PagedResult&lt;CurationReportItemDto&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="525" y="435" as="sourcePoint" /><mxPoint x="305" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="10. Hiển thị danh sách ảnh, nhãn AI dự đoán và nhãn User đề xuất" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0288d1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="465" as="sourcePoint" /><mxPoint x="115" y="465" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="f_curate" value="[Giai đoạn 2: Nhân viên thẩm định nhãn và duyệt đưa vào kho dữ liệu Retrain]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=430;height=25;fillColor=none;strokeColor=#2e7d32;dashed=1;fontSize=11;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="30" y="500" width="1560" height="470" as="geometry" />
        </mxCell>
        <mxCell value="11. Xem ảnh thực tế, chọn nhãn chuẩn xác, chọn DatasetSplit=&#x27;Train&#x27; và bấm &#x27;Phê duyệt&#x27;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="530" as="sourcePoint" /><mxPoint x="305" y="530" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="12. POST /api/v1/staff/ai-curation/reports/{reportId}/verify (Body: CurateReportRequestDto)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="570" as="sourcePoint" /><mxPoint x="525" y="570" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="13. VerifyAndCurateReportAsync(reportId, staffId, dto, ct)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="525" y="610" as="sourcePoint" /><mxPoint x="745" y="610" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="14. GetByIdAsync(reportId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="645" as="sourcePoint" /><mxPoint x="985" y="645" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="15. SELECT * FROM misclassified_reports WHERE report_id = @id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="675" as="sourcePoint" /><mxPoint x="1485" y="675" as="targetPoint" /></mxGeometry>
