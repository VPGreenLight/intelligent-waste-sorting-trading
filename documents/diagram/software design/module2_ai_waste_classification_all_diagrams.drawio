        <mxCell id="l2_db" value="PostgreSQL
(ApplicationDbContext)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#3f51b5;;fillColor=#e8eaf6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
