        <mxCell id="line2_db" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=none;strokeColor=#9e9e9e;" edge="1" parent="1" source="l2_db">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1465" y="1050" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="frame_confirm" value="[Trường hợp 1: Người dùng đồng ý với kết quả AI]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=280;height=25;fillColor=none;strokeColor=#2e7d32;dashed=1;fontSize=11;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1500" height="390" as="geometry" />
        </mxCell>
        <mxCell value="1. Bấm &#x27;Xác nhận đúng loại rác&#x27;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="150" as="sourcePoint" /><mxPoint x="305" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="2. POST /api/v1/waste-scans/{scanId}/confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="190" as="sourcePoint" /><mxPoint x="515" y="190" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="3. ConfirmScanAsync(scanId, userId, ct)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="230" as="sourcePoint" /><mxPoint x="745" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="4. GetByIdAsync(scanId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="270" as="sourcePoint" /><mxPoint x="985" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="5. SELECT * FROM ai_scan_histories WHERE scan_id = @id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="300" as="sourcePoint" /><mxPoint x="1465" y="300" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="6. Return AIScanHistory entity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1465" y="330" as="sourcePoint" /><mxPoint x="985" y="330" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="7. Return scanHistory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="360" as="sourcePoint" /><mxPoint x="745" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="8. UpdateAsync(scanHistory.Confirm())" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="390" as="sourcePoint" /><mxPoint x="985" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="9. UPDATE ai_scan_histories SET confirmed_category_id = predicted_category_id, confirmed_at = NOW()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="415" as="sourcePoint" /><mxPoint x="1465" y="415" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="10. 1 row affected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1465" y="435" as="sourcePoint" /><mxPoint x="985" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="11. Return true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="455" as="sourcePoint" /><mxPoint x="515" y="455" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="12. 200 OK: ApiResponse&lt;object&gt; (MSG-CLS-05: Xác nhận thành công)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="475" as="sourcePoint" /><mxPoint x="305" y="475" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="13. Hiển thị Toast thành công, điều hướng sang &#x27;Đặt lịch thu gom&#x27;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="495" as="sourcePoint" /><mxPoint x="125" y="495" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="frame_adjust" value="[Trường hợp 2: Người dùng thấy sai và tự chọn lại danh mục bằng tay]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=360;height=25;fillColor=none;strokeColor=#e65100;dashed=1;fontSize=11;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1500" height="480" as="geometry" />
        </mxCell>
        <mxCell value="14. Bấm &#x27;Chọn loại rác khác&#x27; -&gt; Chọn danh mục mới từ Dropdown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#e65100;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="570" as="sourcePoint" /><mxPoint x="305" y="570" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="15. PUT /api/v1/waste-scans/{scanId}/adjust (Body: AdjustScanRequestDto { NewCategoryId })" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#e65100;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="610" as="sourcePoint" /><mxPoint x="515" y="610" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="16. AdjustScanAsync(scanId, userId, dto, ct)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#e65100;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="650" as="sourcePoint" /><mxPoint x="745" y="650" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="17. GetByIdAsync(scanId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#e65100;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="745" y="690" as="sourcePoint" /><mxPoint x="985" y="690" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="18. Return scanHistory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#e65100;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="985" y="720" as="sourcePoint" /><mxPoint x="745" y="720" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell value="19. UpdateAsync(scanHistory.Adjust(newCategoryId))" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#e65100;fontSize=10;" edge="1" parent="1">
