        <mxCell value="5. HTTP POST /predict (multipart: file, model)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
