        </mxCell>
        <mxCell value="6. 200 OK { top_prediction: &#x27;plastic&#x27;, confidence: 0.89, is_ood: false }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#1565c0;fontSize=10;" edge="1" parent="1">
