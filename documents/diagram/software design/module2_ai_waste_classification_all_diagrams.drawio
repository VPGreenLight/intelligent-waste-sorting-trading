        <mxCell value="9. Return imageUrl (https://pub-r2.ecolink.vn/...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#1565c0;fontSize=10;" edge="1" parent="1">
