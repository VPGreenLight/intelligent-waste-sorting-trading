        <mxCell value="10. GetSortingGuideAsync(categoryCode=&#x27;plastic&#x27;, ct)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
