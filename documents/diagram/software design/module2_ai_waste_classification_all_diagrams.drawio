        <mxCell value="8. UploadImageAsync(stream, fileName, &#x27;image/jpeg&#x27;, ct)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
