classDiagram
    direction TB

    namespace Presentation_Layer {
        class WasteScanController {
            - IWasteScanService _scanService
            - ILogger~WasteScanController~ _logger
            + ClassifyWaste(ClassifyWasteRequestDto) Task
            + ConfirmResult(long, ConfirmScanRequestDto) Task
            + AdjustResult(long, AdjustScanRequestDto) Task
            + ReportMisclassification(long, CreateReportRequestDto) Task
        }
        class AiCurationController {
            - IAiCurationService _curationService
            - ILogger~AiCurationController~ _logger
            + GetPendingReports(int, int) Task
            + VerifyAndCurate(long, CurateReportRequestDto) Task
        }
        class ClassifyWasteRequestDto {
            + IFormFile ImageFile
            + string Model
        }
        class WasteScanResponseDto {
            + long ScanId
            + string CategoryCode
            + double ConfidenceScore
            + WasteSortingGuideDto SortingGuide
            + string ImageUrl
        }
        class ConfirmScanRequestDto {
            + DateTime ConfirmedAt
        }
        class AdjustScanRequestDto {
            + long NewCategoryId
            + string Note
        }
        class CreateReportRequestDto {
            + long SuggestedCategoryId
            + string Description
        }
        class CurateReportRequestDto {
            + long VerifiedCategoryId
            + string DatasetSplit
            + string Note
        }
        class ApiResponse~T~ {
            + bool Success
            + string MessageCode
            + T Data
            + List Errors
        }
    }

    namespace Application_Layer {
        class IWasteScanService {
            <<interface>>
            + ClassifyWasteAsync(Guid, Stream, string, string) Task
            + ConfirmScanAsync(long, Guid) Task
            + AdjustScanAsync(long, Guid, AdjustScanRequestDto) Task
            + ReportMisclassificationAsync(long, Guid, CreateReportRequestDto) Task
        }
        class WasteScanService {
            - IAiVisionClient _aiClient
            - IStorageService _storageService
            - IWasteRuleEngineService _ruleEngine
            - IAIScanHistoryRepository _scanRepo
            - IMasterWasteCategoryRepository _catRepo
            + ClassifyWasteAsync(Guid, Stream, string, string) Task
            + ConfirmScanAsync(long, Guid) Task
            + AdjustScanAsync(long, Guid, AdjustScanRequestDto) Task
            + ReportMisclassificationAsync(long, Guid, CreateReportRequestDto) Task
        }
        class IAiCurationService {
            <<interface>>
            + GetPendingReportsAsync(int, int) Task
            + VerifyAndCurateReportAsync(long, Guid, CurateReportRequestDto) Task
        }
        class AiCurationService {
            - IMisclassifiedReportRepository _reportRepo
            - IVerifiedDatasetRepository _datasetRepo
            - IUnitOfWork _uow
            + GetPendingReportsAsync(int, int) Task
            + VerifyAndCurateReportAsync(long, Guid, CurateReportRequestDto) Task
        }
        class IAiVisionClient {
            <<interface>>
            + ClassifyWasteImageAsync(Stream, string, string) Task
            + GetAvailableModelsAsync() Task
        }
        class IStorageService {
            <<interface>>
            + UploadImageAsync(Stream, string, string) Task
        }
        class IWasteRuleEngineService {
            <<interface>>
            + GetSortingGuideAsync(string) Task
        }
        class IAIScanHistoryRepository {
            <<interface>>
            + AddAsync(AIScanHistory) Task
            + GetByIdAsync(long) Task
            + UpdateAsync(AIScanHistory) Task
        }
        class IMasterWasteCategoryRepository {
            <<interface>>
            + GetByCodeAsync(string) Task
            + GetByIdAsync(long) Task
        }
        class IMisclassifiedReportRepository {
            <<interface>>
            + AddAsync(MisclassifiedReport) Task
            + GetPendingListAsync(int, int) Task
            + UpdateAsync(MisclassifiedReport) Task
        }
        class IVerifiedDatasetRepository {
            <<interface>>
            + AddAsync(VerifiedDataset) Task
        }
    }

    namespace Infrastructure_Layer {
        class AiVisionHttpClient {
            - HttpClient _httpClient
            + ClassifyWasteImageAsync(Stream, string, string) Task
            + GetAvailableModelsAsync() Task
        }
        class CloudflareR2StorageService {
            - AmazonS3Client _s3Client
            + UploadImageAsync(Stream, string, string) Task
        }
        class WasteRuleEngineService {
            - ApplicationDbContext _dbContext
            + GetSortingGuideAsync(string) Task
        }
        class AIScanHistoryRepository {
            - ApplicationDbContext _dbContext
            + AddAsync(AIScanHistory) Task
            + GetByIdAsync(long) Task
            + UpdateAsync(AIScanHistory) Task
        }
        class MasterWasteCategoryRepository {
            - ApplicationDbContext _dbContext
            + GetByCodeAsync(string) Task
            + GetByIdAsync(long) Task
        }
        class MisclassifiedReportRepository {
            - ApplicationDbContext _dbContext
            + AddAsync(MisclassifiedReport) Task
            + GetPendingListAsync(int, int) Task
            + UpdateAsync(MisclassifiedReport) Task
        }
        class VerifiedDatasetRepository {
            - ApplicationDbContext _dbContext
            + AddAsync(VerifiedDataset) Task
        }
        class ApplicationDbContext {
            + DbSet AIScanHistories
            + DbSet MasterWasteCategories
            + DbSet SortingGuidanceRules
            + DbSet MisclassifiedReports
            + DbSet VerifiedDatasets
        }
    }

    namespace Domain_Layer {
        class AIScanHistory {
            + long ScanId
            + Guid UserId
            + string ImageUrl
            + long PredictedCategoryId
            + long ConfirmedCategoryId
            + decimal ConfidenceScore
            + string ModelVersion
            + string ScanStatus
            + decimal Latitude
            + decimal Longitude
            + DateTime ConfirmedAt
            + Confirm(long catId) void
        }
        class MasterWasteCategory {
            + long CategoryId
            + string CategoryCode
            + string CategoryName
            + string Description
            + string StandardBinColor
            + bool IsRecyclable
            + string Status
        }
        class SortingGuidanceRule {
            + long RuleId
            + long CategoryId
            + string Title
            + string PreparationInstruction
            + string SortingInstruction
            + string DisposalInstruction
            + string Warning
            + string Status
        }
        class MisclassifiedReport {
            + long ReportId
            + long ScanId
            + Guid UserId
            + long PredictedCategoryId
            + long UserSuggestedCategoryId
            + long StaffVerifiedCategoryId
            + string Description
            + string Status
            + Guid ReviewedByStaffId
            + DateTime ReviewedAt
            + Approve(Guid staffId, long catId) void
        }
        class VerifiedDataset {
            + long DatasetId
            + long CategoryId
            + string ImageUrl
            + string AnnotationUrl
            + string Source
            + string DatasetSplit
            + Guid VerifiedByStaffId
            + DateTime VerifiedAt
        }
    }

    %% Relationships - Presentation to Application
    WasteScanController --> IWasteScanService
    AiCurationController --> IAiCurationService
    WasteScanController ..> ClassifyWasteRequestDto
    WasteScanController ..> WasteScanResponseDto
    WasteScanController ..> ApiResponse~T~
    AiCurationController ..> CurateReportRequestDto
    AiCurationController ..> ApiResponse~T~

    %% Relationships - Application Implementations & Ports
    WasteScanService ..|> IWasteScanService
    AiCurationService ..|> IAiCurationService
    WasteScanService --> IAiVisionClient
    WasteScanService --> IStorageService
    WasteScanService --> IWasteRuleEngineService
    WasteScanService --> IAIScanHistoryRepository
    WasteScanService --> IMasterWasteCategoryRepository
    AiCurationService --> IMisclassifiedReportRepository
    AiCurationService --> IVerifiedDatasetRepository

    %% Relationships - Infrastructure Realizations
    AiVisionHttpClient ..|> IAiVisionClient
    CloudflareR2StorageService ..|> IStorageService
    WasteRuleEngineService ..|> IWasteRuleEngineService
    AIScanHistoryRepository ..|> IAIScanHistoryRepository
    MasterWasteCategoryRepository ..|> IMasterWasteCategoryRepository
    MisclassifiedReportRepository ..|> IMisclassifiedReportRepository
    VerifiedDatasetRepository ..|> IVerifiedDatasetRepository
    AIScanHistoryRepository --> ApplicationDbContext
    MasterWasteCategoryRepository --> ApplicationDbContext
    MisclassifiedReportRepository --> ApplicationDbContext
    VerifiedDatasetRepository --> ApplicationDbContext

    %% Relationships - Domain Associations
    MasterWasteCategory "1" -- "1" SortingGuidanceRule
    AIScanHistory "N" --> "1" MasterWasteCategory
    MisclassifiedReport "1" --> "1" AIScanHistory
    VerifiedDataset "N" --> "1" MasterWasteCategory
